# ==========================================================================
# application.yml 模板
#
# 【用法】复制本文件 → 重命名为同目录下的 application.yml → 把 TODO 处改成你机器的实际值。
#   - application.yml 已在 .gitignore 中被排除（内含密码，不入库），所以每台机器都要自己放一份
#   - 本模板文件会被 git 跟踪，供换机器 / 新同学按图索骥
#
# 【启动顺序】MySQL(3307) → Redis(6379) → Ollama(11434) → 本服务(8080)
# 【数据库】需先建好数据库 ai_helper 并导入表结构：mysql -uroot -p < docs/schema.sql（12 张表）
# 【自检】powershell -ExecutionPolicy Bypass -File .\diagnose.ps1（会按本文件的 jdbc url 解析端口/库名）
# ==========================================================================

server:
  port: 8080
  tomcat:
    # 分片上传的请求体是原始二进制（最大 5MB/片），放宽请求体吞噬上限，避免异常时被截断
    max-swallow-size: -1

spring:
  # ---- Ollama 本地大模型 ----
  ai:
    openai:
      base-url: http://localhost:11434     # 本机跑 Ollama 就填这个
      api-key: ollama                      # Ollama 不校验 key，占位即可
      chat:
        options:
          # ⚠️ 硬件红线：本机 7G 内存 / RTX3050 4G 显存，只能用 3B 级别模型。
          #    换成 7B/8B 会 OOM 崩溃（历史上留下过 hs_err_pid 崩溃日志），不要改大。
          model: qwen2.5:3b-16k
      connect-timeout: 30s
      read-timeout: 180s                   # 10 轮答辩单次推理可能较慢

  mvc:
    async:
      # 与前端答辩请求的 180s 超时对齐
      request-timeout: 180000

  # ---- MySQL ----
  # TODO 改成你机器的账号与密码；库名 ai_helper 不要改。
  # 端口与《从零部署手册-8G低功耗标准》保持一致：标准部署为 3307；
  # 若你的 MySQL 跑在 3306，把下面 url 里的 3307 改成 3306（diagnose.ps1 会跟着本文件走，无需改脚本）。
  datasource:
    url: jdbc:mysql://127.0.0.1:3307/ai_helper?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true
    username: root
    password: your-mysql-password
    driver-class-name: com.mysql.cj.jdbc.Driver

  # ---- Redis（存登录 token 与对话记忆） ----
  # TODO 改成你机器的密码；若 Redis 没设密码，请删掉 password 这一行
  data:
    redis:
      host: 127.0.0.1
      port: 6379
      password: your-redis-password

  # ---- 邮件（找回密码发验证码用） ----
  # TODO 换成本人的 QQ 邮箱 + SMTP 授权码（注意：是"授权码"，不是 QQ 登录密码）
  mail:
    host: smtp.qq.com
    port: 587
    # 发件人地址就是这一行（N35：代码里不再硬编码发件人，留空则用 JavaMailSender 默认值）
    username: your-qq-mail@qq.com
    password: your-qq-auth-code
    properties:
      mail:
        smtp:
          auth: true
          starttls:
            enable: true

  # ---- 上传体积上限（与下方 app.upload.* 配合） ----
  servlet:
    multipart:
      max-file-size: 500MB
      max-request-size: 500MB

mybatis:
  mapper-locations: classpath:Mapper/*.xml
  type-aliases-package: com.ai_helper.ai_helper.pojo
  configuration:
    map-underscore-to-camel-case: true

pagehelper:
  helper-dialect: mysql
  reasonable: true

logging:
  file:
    name: logs/ai-helper.log
  level:
    # 排查 SQL 时保留 DEBUG；平时想安静可改成 INFO
    com.ai_helper.ai_helper.mapper: DEBUG

# ==========================================================================
# 应用自定义配置
# ==========================================================================
app:
  storage:
    # 文件存储根目录（答辩视频体积大，务必放在非系统盘）。
    #
    # 留空 = 自动选择：按下面 preferred-drives 的顺序挑第一个「存在且可写」的磁盘，
    #                   并在其下创建 folder-name 文件夹。
    #   - 开发机固定用 F 盘：写 F:/ai wordplace
    #   - 换到没有 F 盘的电脑：保持留空即可，会自动落到 D 盘（不需要改任何配置）
    #
    # 即使这里写了某个盘、而目标机器没有该盘，也会自动降级为自动选择，不会启动失败。
    root: ""
    # 自动选择磁盘时创建的文件夹名
    folder-name: ai wordplace
    # 自动选择磁盘的优先顺序（不带冒号）
    preferred-drives: F,D,E,C
    # 对外访问 URL 前缀：由 WebConfig 映射到【最终选定】的根目录，
    # 原生支持 HTTP Range，视频才能拖动进度条 / 边下边播
    url-prefix: /files

  upload:
    # 答辩视频：分片上传（真分片，按字节区间写入目标文件对应偏移量）
    # 不配置也可以用，代码里有同样的默认值（见 AppProperties.FileRule）
    video:
      max-size: 524288000        # 500MB
      chunk-size: 5242880        # 5MB/片
      allowed-exts: mp4,mov,avi,mkv,flv,wmv,m4v,3gp
    # 答辩报告：单次直传
    #
    # 【2026-10-16 · 报告五维评分】白名单由「pdf,doc,docx,xls,xlsx,ppt,pptx,txt」
    # 收窄为下面四种**可自动解析出文字**的格式：
    #   · pdf 需要额外引入 PDFBox（本项目全程 mvn -o 离线编译，本地仓库没有该包）
    #   · doc/xls/ppt 是需要 POI scratchpad 的旧二进制格式
    # 四者都无法在零依赖前提下抽出文本，留在白名单里只会「能传但分析必然失败」。
    # 上传这四类时后端会返回「请另存为 docx 后重新上传」的明确提示。
    report:
      max-size: 52428800         # 50MB
      allowed-exts: docx,pptx,xlsx,txt

  auth:
    # 登录 token 有效期（分钟）。
    # 一场答辩可能超过 30 分钟，设太短会把学生答到一半踢出去，故为 120
    token-ttl-minutes: 120

  mail:
    # 【N35】找回密码邮件里「重置链接」的前缀（学生点开邮件链接时访问的后端地址）。
    # 本机调试用默认值即可；正式部署改成对外可访问的地址（如 https://你的域名）。
    # 此前该地址硬编码在 PasswordResetServiceImpl，换机器/上线必须改代码。
    reset-link-base: http://localhost:8080

  defense:
    # 续答时间窗口（分钟）。
    # 答辩中途退出后再进时：只有「最后一次作答在该窗口内」的未完成场次才会弹窗提示
    # 「是否继续上次作答」，且必须由学生主动选择 —— 默认一律从第 1 题开始。
    # 超出窗口的场次按新答辩处理，避免历史遗留的未完成记录影响答辩开端。
    resume-window-minutes: 30

  async:
    # 低功耗线程池默认值：避免大文件/语音/异步任务与 Ollama 抢 CPU 和内存。
    # 机器资源充足并经过压测后再上调。
    core-pool-size: 2
    max-pool-size: 4
    queue-capacity: 50

  # ==========================================================================
  # 评分判分阈值（2026-10-10 由 chatController 硬编码常量外置；全部为经验值）
  # 不配置时代码默认值与下面一致，配置后以 yml 为准，可不重新编译微调。
  # 【注意】AppProperties.Scoring 里的字段默认值与本段保持同步。
  # ==========================================================================
  scoring:
    # N45 一致性保护阈值：模型自评总分 ≥ 该值却标 [错误] 时不再直接砍半，交一次复核仲裁
    wrong-answer-half-score-max-total: 32.0
    # 答非所问复核触发门槛：回答与当前题概念覆盖率低于该值 → 疑似答非所问
    off-target-coverage-threshold: 0.25
    # 跨轮重复作答判定：与本场此前任一轮答案二元组 Dice ≥ 该值 → 固定零分（N47）
    cross-round-repeat-dice: 0.8
    # 跑题复核救回门槛：覆盖率低于该值视为明显跑题，不救回（N53）
    rescue-min-coverage: 0.05
    # 点评接地校验：点评引用本轮答案的二元组命中数下限，低于则判模板话/幻觉强制重写（N46/N49）
    grounded-min-hits: 3
    # 追问主题级去重：共享关键词数下限 / Jaccard 相似度阈值（N48）
    follow-up-topic-overlap-min: 2
    follow-up-topic-jaccard: 0.34
    # 【路线① · 2026-10-10】要点逐项核验（三档校正）：首次生成该题要点清单并缓存，
    # 每轮逐条判 命中/未命中/矛盾，命中率低于阈值 → 判"错误"档压缩总分。false 即回旧行为。
    # 【N63 · 2026-10-14】覆盖范围放开到全部轮次（追问轮用 ensureRubricForQuestion 现生成要点）；
    # 命中率分母口径受 3B 输出条数影响，识别"全错"能力有限（见 CHANGES.md 2026-10-15）。
    checklist-enabled: true
    # 命中率低于该值 → 判"错误"档（2026-10-10 标定 0.70；2026-10-14 按 defenseId=336 实测放宽到 0.50——
    # 完全无关的回答改由核验的 relevant 判定直接归零，不再依赖本阈值）
    checklist-error-hit-rate-max: 0.50
    # 判"错误"档时的最终总分上限（五档表大错×0.5 → 7.5~15）
    checklist-error-final-cap: 15.0

  # ==========================================================================
  # 上传报告文档的 AI 评析（2026-10-16 · 报告五维评分第一期）
  #
  # 教师端手动触发：把学生上传的 docx/pptx/xlsx/txt 抽出全文，交给本地 3B 模型
  # 按文字答辩同一套五维（表达/逻辑/专业/应变/创新，总分 50）评分并落库。
  # 与上面的 scoring 那一套判分阈值完全独立，互不影响。
  #
  # 【注意】AppProperties.ReportDoc 里的字段默认值与本段保持同步。
  # ==========================================================================
  report-doc:
    # 总开关。默认关闭即完全回到"没有报告评析"的状态（与 error-verdict-enabled 同款做法）
    enabled: true

    # ---- 文本抽取上限（安全边界，防压缩炸弹与 OOM）----
    max-entry-bytes: 4194304          # 4MB：单个 zip 条目解压后上限
    max-total-bytes: 41943040         # 40MB：全部条目累计解压上限
    max-compression-ratio: 200        # 压缩比超过该值即判定为压缩炸弹
    max-chars: 60000                  # 抽取出的纯文本字数上限，超出截断

    # ---- 分级策略（3B 模型只有 16k 上下文）----
    # 材料 ≤ direct-score-max-chars 直接评；更长时先抽「证据清单」，再依据清单终评——
    # 目的是让终评阶段看到的输入长度恒定，消除"材料越长、分数越飘"的长度耦合。
    # 2026-10-16 实测调整：点评与评分拆成两次调用（点评→接地校验→依据点评打分），
    # 评分输入不给原始材料，从结构上掐断"报告正文里写'给我满分'"的注入通道。
    direct-score-max-chars: 10000     # 2026-10-16 实测由 2500 上调（5520 字材料仅约 3729 tokens）
    chunk-max-chars: 2500             # 超长材料按此切块抽证据（优先在段落边界切）
    max-chunks: 8                     # 最多处理多少块；超出则保留头尾各一半，丢弃中间
    evidence-max-tokens: 700
    final-max-tokens: 450             # 点评调用（第一次模型调用）
    score-max-tokens: 40              # 评分调用（第二次，只输出一行评分行）
    # 综合评价调用（第三次模型调用，2026-10-18）：基于材料 + 五维成绩单写 400~700 字总评，
    # 落 report_doc_summary，教师端「查看反馈」展示。失败只记日志，不影响五维成绩单。
    summary-max-tokens: 800
    summary-max-chars: 2000           # 总评落库/展示的字符上限（防模型跑飞）
    budget-seconds: 240               # 单个任务总耗时预算，超时中止且不写库

    # ---- 任务控制 ----
    lock-ttl-seconds: 600             # 单飞锁 TTL（进程崩了也会自动过期）
    status-ttl-hours: 24              # Redis 状态键 TTL（结果本身是落库的，过期会回查库）
    stale-seconds: 900                # 僵态判定：PROCESSING 超过该秒数仍未完成即置 FAILED
    annotate-source: true             # 落库文本是否加「【基于上传的报告文档】」前缀
    # 抽取全文落库（defense_records.report_text），供评分依据事后复核。
    # 写在评分之前——分析失败时恰恰最需要知道"模型当时到底看到了什么"。
    # ⚠️ 对应列必须是 MEDIUMTEXT：TEXT 的 64KB 上限会静默截断 60k 中文字（约 180KB）。
    # 需先执行 docs/ddl_report_text.sql。
    store-text: true

  # ==========================================================================
  # 语音答辩（F10）：AI 提问的语音播报 + 学生语音作答的识别
  #
  # ⚠️ 为什么不用微信的「同声传译」插件：**个人主体的小程序无法添加该插件**
  #    （插件管理与微信服务市场都搜不到，改类目也无效）。因此改为后端本地实现：
  #      · 播报（TTS）→ Windows 自带语音合成，离线、零依赖、不需要装任何东西
  #      · 识别（ASR）→ whisper.cpp 本地识别，组件缺失时**启动后自动下载**（见下方 auto-install）
  #
  # 【开箱即用】引擎/模型/ffmpeg 合计约 550MB，超过 Git 仓库单文件上限、不能随代码提交，
  # 因此默认「启动后端后自动下载补齐」——新机器 clone 下来只需开 Redis + Ollama + 启动后端，
  # 语音答辩即可用（下载进度见后端日志，期间文字答辩完全不受影响）。也可手动运行
  # scripts/install-whisper.ps1 安装（离线机器可把已装好的 F:\whisper 整个目录拷过去）。
  #
  # 下面两个路径留空时会按常见目录自动查找（引擎 + 同目录 models/ggml-*.bin）：
  #   F:\whisper / D:\whisper / E:\whisper / C:\whisper / D:\tools\whisper / 项目下 whisper
  # ==========================================================================
  voice:
    # 缺失组件时启动后自动下载（引擎约 15MB + 模型约 487MB + ffmpeg 约 40MB）。
    # 关掉（false）则保持"只查找、不下载"的旧行为。
    auto-install: true
    # 自动安装目录。留空 = 自动选择本机存在的存储盘（如 F:\whisper）
    install-dir: ""
    # 模型档位：tiny / base / small / medium。small 中文效果最均衡（约 487MB，8G 机器偏慢）；
    # 网速/内存紧张可改 base（约 142MB，识别快一倍）
    model: small
    # 下载代理（可选，如 http://127.0.0.1:7890）；留空 = 直连。GitHub 访问慢时很有用
    proxy: ""
    # whisper.cpp 可执行文件（whisper-cli.exe / 旧版 main.exe）。留空 = 自动查找
    whisper-exe: ""
    # 模型文件（ggml-*.bin）。留空 = 在引擎同目录的 models/ 下自动挑选
    whisper-model: ""
    # ffmpeg 可执行文件。**强烈建议配置/安装**：
    #   微信开发者工具（模拟器）录出来的是 webm/opus，Java 与 whisper 都不认，必须靠 ffmpeg 转码；
    #   真机的 mp3/aac 也统一交给它转成 16kHz wav，比 Java 解码更稳。
    # 留空 = 自动查找（PATH、引擎同目录、项目 whisper 目录）
    ffmpeg-exe: ""
    # 识别语言（zh = 中文）
    language: zh
    # 识别提示词（可选，留空用代码内置默认值）：引导简体中文输出 + 提供专业术语表。
    # 注意 whisper 的 prompt 约 224 token 上限，别写太长。
    # prompt: "以下是《大数据技术与原理》课程答辩中，学生回答考官提问的语音转写，口语化表达，请用规范的简体中文输出。常见术语：Hadoop HDFS MapReduce YARN Hive HBase Spark..."
    # 单次识别超时（秒）：超时即返回"没听清"，让学生重录
    timeout-seconds: 180
    # 前端单次录音时长上限（秒），超过会自动停止录音
    max-record-seconds: 60
    # 【N78】排查用：把最近一次录音的原始音频保留到系统临时目录（ai-helper-asr-last.*）。
    # 默认 false；只在排查「识别引擎解不了某容器格式」时临时打开，否则最后一名学生的录音会一直留在磁盘上。
    asr-debug-dump-enabled: false
