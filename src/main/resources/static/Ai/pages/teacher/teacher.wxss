/* ===== 弹层（添加题目 / 题目详情 / 答辩详情 / 回答详情 共用） =====
   注意：以下为一套唯一定义，勿再追加同名重复规则（历史上有两套互相覆盖，
   导致卡片宽度 90% + max-width 750rpx + margin 30rpx 打架，右侧被裁、阴影被切）。
   左右留白统一由 .modal-mask 的 padding 承担，卡片 width:100% —— 结构上不可能横向溢出。 */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.6);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 40rpx; /* 两侧留白（同时给阴影留出余量） */
  box-sizing: border-box;
  z-index: 1000;
}

.modal-card {
  width: 100%;
  max-width: 670rpx; /* 750rpx - 两侧各 40rpx */
  margin: 0;
  padding: 0;
  background: #ffffff;
  border-radius: 24rpx;
  box-shadow: 0 16rpx 36rpx rgba(0, 0, 0, 0.15);
  max-height: 86vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  box-sizing: border-box;
}

.modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-shrink: 0;
  padding: 32rpx 28rpx 20rpx;
  background: #ffffff;
  border-bottom: 1rpx solid #f0f0f0;
}

.modal-title {
  flex: 1;
  font-size: 36rpx;
  font-weight: 600;
  color: #333333;
}

.modal-close {
  flex-shrink: 0;
  margin-left: 20rpx;
  padding: 8rpx 12rpx;
  font-size: 48rpx;
  line-height: 1;
  color: #999999;
  text-align: center;
}

.modal-body {
  flex: 1;
  min-height: 0; /* 允许在 max-height 内收缩，否则内容会把卡片撑破 */
  overflow-y: auto;
  overflow-x: hidden;
  padding: 20rpx 28rpx 28rpx;
  box-sizing: border-box;
}

/* 滚动条样式 */
.modal-body::-webkit-scrollbar {
  width: 6rpx;
}

.modal-body::-webkit-scrollbar-track {
  background: #f1f1f1;
  border-radius: 3rpx;
}

.modal-body::-webkit-scrollbar-thumb {
  background: #ccc;
  border-radius: 3rpx;
}

.modal-body::-webkit-scrollbar-thumb:hover {
  background: #aaa;
}

.modal-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 20rpx;
}

