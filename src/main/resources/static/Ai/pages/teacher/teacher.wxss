.page {
  min-height: 100vh;
  background: #ededf0;
  display: flex;
  flex-direction: column;
}

.header-fixed {
  height: 120rpx;
  background-color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 999;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
}

.header-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333333;
  position: absolute;
  bottom: 10rpx;
  left: 50%;
  transform: translateX(-50%);
  white-space: nowrap;
}

.content {
  flex: 1;
  padding: 140rpx 24rpx 140rpx; /* 增加上边距以避免内容被固定标题遮挡 */
  box-sizing: border-box;
  overflow-y: auto;
}

.section-title {
  font-size: 40rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 32rpx;
}

.welcome-card {
  display: flex;
  align-items: center;
  padding: 28rpx;
  border-radius: 28rpx;
  margin-bottom: 28rpx;
  color: #ffffff;
}

.gradient-green {
  background: linear-gradient(90deg, #4caf50 0%, #43a047 100%);
  box-shadow: 0 12rpx 24rpx rgba(67, 160, 71, 0.25);
}

.avatar-circle {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
}

.avatar-circle.large {
  width: 140rpx;
  height: 140rpx;
}

.avatar-text {
  font-size: 36rpx;
  font-weight: 600;
  color: #43a047;
}

.welcome-info {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.welcome-title {
  font-size: 32rpx;
  font-weight: 600;
}

.welcome-subtitle {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.9);
}

.stats-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
  margin-bottom: 24rpx;
}

.stat-card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 20rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
  box-shadow: 0 8rpx 20rpx rgba(0, 0, 0, 0.06);
}

.stat-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 600;
}

.stat-icon.blue {
  background: #eaf2ff;
  color: #008cba;
}

.stat-icon.green {
  background: #e8f5e9;
  color: #43a047;
}

.stat-value {
  font-size: 40rpx;
  font-weight: 600;
  color: #333333;
}

.stat-label {
  font-size: 24rpx;
  color: #666666;
}

.card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 20rpx rgba(0, 0, 0, 0.06);
}

.card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.card-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333333;
}

.label {
  font-size: 24rpx;
  color: #666666;
}

.input {
  margin-top: 10rpx;
  padding: 16rpx 20rpx;
  background: #f7f9fb;
  border-radius: 12rpx;
  font-size: 26rpx;
  width: 100%; /* 确保占满整个容器 */
  box-sizing: border-box; /* 包含padding在内的总宽度为100% */
  min-height: 80rpx; /* 进一步增加最小高度以更好地显示多行内容 */
  line-height: 1.5; /* 改善文本可读性 */
  height: auto; /* 让高度可以根据内容自动调整 */
}

.picker {
  margin-top: 10rpx;
  padding: 16rpx 20rpx;
  background: #f7f9fb;
  border-radius: 12rpx;
  font-size: 26rpx;
  width: 100%;
  box-sizing: border-box;
  color: #333333;
  display: flex;
  align-items: center;
  min-height: 60rpx; /* 增加最小高度以更好地显示内容 */
}

.textarea {
  margin-top: 10rpx;
  padding: 16rpx 20rpx;
  background: #f7f9fb;
  border-radius: 12rpx;
  font-size: 26rpx;
  min-height: 320rpx; /* 增加最小高度以更好地显示多行内容 */
  width: 100%; /* 确保占满整个容器 */
  box-sizing: border-box; /* 包含padding在内的总宽度为100% */
  line-height: 1.5; /* 改善文本可读性 */
  max-height: 600rpx; /* 增加最大高度，允许输入更多内容 */
}

.value {
  font-size: 28rpx;
  color: #333333;
  margin-top: 10rpx;
  display: block;
  background: #f7f9fb; /* 与输入框相同的背景色 */
  padding: 16rpx 20rpx; /* 与输入框相同的内边距 */
  border-radius: 12rpx; /* 与输入框相同的圆角 */
  width: 100%; /* 与输入框相同的宽度 */
  box-sizing: border-box; /* 包含padding在内的总宽度为100% */
  max-width: 650rpx; /* 限制最大宽度，防止超出弹窗容器 */
}

/* 回答详情样式 */
.answer-item {
  margin-bottom: 24rpx;
  padding-bottom: 24rpx;
}

.answer-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.answer-type {
  font-size: 24rpx;
  font-weight: bold;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}

.ai-question {
  background-color: #e3f2fd;
  color: #1976d2;
}

.teacher-question {
  background-color: #f3e5f5;
  color: #7b1fa2;
}

.answer-score {
  font-size: 24rpx;
  color: #4caf50;
  font-weight: 600;
}

.answer-separator {
  height: 1rpx;
  background-color: #e0e0e0;
  margin-top: 16rpx;
}

.long-text-scroll {
  background: #f7f9fb;
  padding: 12rpx 16rpx;
  border-radius: 12rpx;
  max-height: 200rpx; /* 限制最大高度，防止内容过多时占用整个弹窗 */
  overflow-y: auto; /* 启用垂直滚动 */
  overflow-x: hidden; /* 防止长内容把容器横向撑破 */
  width: 100%;
  box-sizing: border-box;
}

/* 优化值显示样式，确保内容不会被截断 */
.value {
  font-size: 28rpx;
  color: #333333;
  margin-top: 10rpx;
  display: block;
  background: #f7f9fb; /* 与输入框相同的背景色 */
  padding: 16rpx 20rpx; /* 与输入框相同的内边距 */
  border-radius: 12rpx; /* 与输入框相同的圆角 */
  width: 100%; /* 与输入框相同的宽度 */
  box-sizing: border-box; /* 包含padding在内的总宽度为100% */
  word-break: break-word; /* 确保长单词能正确换行 */
  white-space: pre-wrap; /* 保留换行符并允许自动换行 */
}

.questions-container {
  max-height: 400rpx;
  overflow-y: auto;
  overflow-x: hidden;
  padding: 10rpx 0;
}

/* 问题项样式 */
.question-item {
  margin-bottom: 20rpx;
}

.form-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 10rpx;
}

.add-question-btn {
  font-size: 20rpx;
  color: #008cba;
  padding: 6rpx 20rpx;
  border-radius: 12rpx;
  background: #eaf2ff;
  border: 1rpx solid #008cba;
}

.question-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 10rpx;
}

.question-index {
  font-size: 28rpx;
  font-weight: 600;
  color: #333333;
}

.remove-question-btn {
  font-size: 24rpx;
  color: #f44336;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  background: #ffebee;
}

.feedback {
  color: #666666;
  line-height: 1.5;
}

.value.feedback {
  background: #f7f9fb;
  padding: 16rpx;
  border-radius: 12rpx;
  font-size: 24rpx;
  color: #666666;
  line-height: 1.5;
}

/* 搜索区域样式 */
.search-container {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 20rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 20rpx rgba(0, 0, 0, 0.06);
}

.search-inputs {
  display: flex;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.search-input {
  flex: 1;
  padding: 16rpx 20rpx;
  background: #f7f9fb;
  border-radius: 12rpx;
  font-size: 26rpx;
  height: 60rpx;
  box-sizing: border-box;
}

.search-actions {
  display: flex;
  gap: 16rpx;
}

.search-btn {
  flex: 1;
  height: 72rpx; /* 统一高度为72rpx */
  font-size: 26rpx;
  border-radius: 16rpx; /* 统一圆角为16rpx */
  display: flex;
  align-items: center;
  justify-content: center;
}

.primary-btn {
  margin-top: 0;
  width: 100%;
  height: 80rpx;
  background: #008cba;
  color: #ffffff;
  border-radius: 16rpx;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.primary-btn::after {
  border: none;
}

.outline-btn {
  margin-top: 0;
  flex: 1;
  height: 72rpx; /* 统一高度为72rpx */
  border: 2rpx solid #008cba;
  color: #008cba;
  border-radius: 16rpx; /* 统一圆角为16rpx */
  font-size: 26rpx;
  background: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
}

.outline-btn.red {
  border-color: #f44336;
  color: #f44336;
}

.outline-btn::after {
  border: none;
}

.add-btn {
  height: 60rpx; /* 增加按钮高度 */
  padding: 0 16rpx; /* 调整内边距使按钮更紧凑 */
  font-size: 24rpx; /* 字体大小保持不变 */
  border-radius: 12rpx;
  background-color: #eaf2ff; /* 背景色 */
  color: #008cba; /* 文字颜色 */
  border: none; /* 移除默认边框 */
  width: auto; /* 让按钮宽度自适应内容 */
  min-width: 100rpx; /* 设置最小宽度以确保按钮不会过窄 */
  max-width: 160rpx; /* 设置最大宽度以限制按钮宽度 */
}

.card-header {
