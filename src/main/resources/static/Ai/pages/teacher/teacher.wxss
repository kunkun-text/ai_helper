.page {
  /* 【F4 · 2026-10-05】与学生页统一：整页固定视口高 + 内部 flex 滚动，
     header/tab-bar 回归文档流，不再用 fixed + padding 补偿 */
  height: 100vh;
  overflow: hidden;
  background: #ededf0;
  display: flex;
  flex-direction: column;
}

.header-fixed {
  /* 类名保留避免动 WXML，但布局已回归文档流（原 fixed 悬浮层会遮挡弹窗、切页残留） */
  height: 120rpx;
  background-color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  flex-shrink: 0;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
}

.header-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333333;
  position: absolute;
  bottom: 10rpx;
  left: 50%;
  transform: translateX(-50%);
  white-space: nowrap;
}

.content {
  flex: 1;
  min-height: 0; /* 关键：约束 scroll-view 不超出 flex 分配高度，避免把 tab-bar 顶出屏幕 */
  padding: 24rpx 24rpx 30rpx; /* header/tab-bar 已回归文档流，无需再补偿 */
  box-sizing: border-box;
}

.section-title {
  font-size: 40rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 32rpx;
}

.welcome-card {
  display: flex;
  align-items: center;
  padding: 28rpx;
  border-radius: 28rpx;
  margin-bottom: 28rpx;
  color: #ffffff;
}

.gradient-green {
  background: linear-gradient(90deg, #4caf50 0%, #43a047 100%);
  box-shadow: 0 12rpx 24rpx rgba(67, 160, 71, 0.25);
}

.avatar-circle {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
}

.avatar-circle.large {
  width: 140rpx;
  height: 140rpx;
}

.avatar-text {
  font-size: 36rpx;
  font-weight: 600;
  color: #43a047;
}

.welcome-info {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.welcome-title {
  font-size: 32rpx;
  font-weight: 600;
}

.welcome-subtitle {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.9);
}

.stats-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
  margin-bottom: 24rpx;
}

.stat-card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 20rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
  box-shadow: 0 8rpx 20rpx rgba(0, 0, 0, 0.06);
}

.stat-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 600;
}

.stat-icon.blue {
  background: #eaf2ff;
  color: #008cba;
}

.stat-icon.green {
  background: #e8f5e9;
  color: #43a047;
}

.stat-value {
  font-size: 40rpx;
  font-weight: 600;
  color: #333333;
}

.stat-label {
  font-size: 24rpx;
  color: #666666;
}

.card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 20rpx rgba(0, 0, 0, 0.06);
}

.card-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333333;
}

/* 回答详情样式 */
.answer-item {
  margin-bottom: 24rpx;
  padding-bottom: 24rpx;
}

.answer-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.answer-type {
  font-size: 24rpx;
  font-weight: bold;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}

.ai-question {
  background-color: #e3f2fd;
  color: #1976d2;
}

.teacher-question {
  background-color: #f3e5f5;
  color: #7b1fa2;
}

.answer-score {
  font-size: 24rpx;
  color: #4caf50;
  font-weight: 600;
}

.answer-separator {
  height: 1rpx;
  background-color: #e0e0e0;
  margin-top: 16rpx;
}

.long-text-scroll {
  background: #f7f9fb;
  padding: 12rpx 16rpx;
  border-radius: 12rpx;
  max-height: 200rpx; /* 限制最大高度，防止内容过多时占用整个弹窗 */
  overflow-y: auto; /* 启用垂直滚动 */
  overflow-x: hidden; /* 防止长内容把容器横向撑破 */
  width: 100%;
  box-sizing: border-box;
}

.feedback {
  color: #666666;
  line-height: 1.5;
}

/* 搜索区域样式 */
.search-container {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 20rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 20rpx rgba(0, 0, 0, 0.06);
}

.search-inputs {
  display: flex;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.search-input {
  flex: 1;
  padding: 16rpx 20rpx;
  background: #f7f9fb;
  border-radius: 12rpx;
  font-size: 26rpx;
  height: 60rpx;
  box-sizing: border-box;
}

.search-actions {
  display: flex;
  gap: 16rpx;
}

.search-btn {
  flex: 1;
  height: 72rpx; /* 统一高度为72rpx */
  font-size: 26rpx;
  border-radius: 16rpx; /* 统一圆角为16rpx */
  display: flex;
  align-items: center;
  justify-content: center;
}

.primary-btn {
  margin-top: 0;
  width: 100%;
  height: 80rpx;
  background: #008cba;
  color: #ffffff;
  border-radius: 16rpx;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.primary-btn::after {
  border: none;
}

.outline-btn {
  margin-top: 0;
  flex: 1;
  height: 72rpx; /* 统一高度为72rpx */
  border: 2rpx solid #008cba;
  color: #008cba;
  border-radius: 16rpx; /* 统一圆角为16rpx */
  font-size: 26rpx;
  background: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
}

.outline-btn.red {
  border-color: #f44336;
  color: #f44336;
}

.outline-btn::after {
  border: none;
}

.add-btn {
  height: 60rpx; /* 增加按钮高度 */
  padding: 0 16rpx; /* 调整内边距使按钮更紧凑 */
  font-size: 24rpx; /* 字体大小保持不变 */
  border-radius: 12rpx;
  background-color: #eaf2ff; /* 背景色 */
  color: #008cba; /* 文字颜色 */
  border: none; /* 移除默认边框 */
  width: auto; /* 让按钮宽度自适应内容 */
  min-width: 100rpx; /* 设置最小宽度以确保按钮不会过窄 */
  max-width: 160rpx; /* 设置最大宽度以限制按钮宽度 */
}

.card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
  /* 使用space-between让按钮靠右对齐 */
  margin-bottom: 20rpx;
}

.topic-list {
  /* 原有的 flex 布局改为块级，因为现在是 scroll-view */
  display: block;
  /* 固定高度由 WXML 内联样式控制，这里可以不写死 */
  overflow-y: auto;
  /* 隐藏滚动条（可选） */
  scrollbar-width: none;
  -ms-overflow-style: none;
}

.topic-list::-webkit-scrollbar {
  display: none;
}

.topic-item {
  
  min-height: 180rpx;
  margin-bottom: 16rpx;
  background: #f7f9fb;
  border-radius: 20rpx;
  padding: 20rpx;
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.topic-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 6rpx;
}

.topic-desc {
  font-size: 24rpx;
  color: #666666;
  margin-bottom: 8rpx;
  display: block;
}

.topic-date {
  font-size: 22rpx;
  color: #888888;
}

.topic-arrow {
  color: #b0b0b0;
  font-size: 28rpx;
  margin-left: 12rpx;
}


.record-list-full {
  height: calc(100vh - 200rpx);
  overflow-y: auto;
}

.record-item {
  background: #f7f9fb;
  border-radius: 20rpx;
  padding: 20rpx;
  display: flex;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

/* 【2026-10-16 · 报告五维评分】该场次已有「基于上传报告」的 AI 评析。
   只加修饰类，不动上面的 .record-item 基础规则——避免影响其余记录的既有外观。
   色值走全局变量（app.wxss 的 page{}），带回退值以防变量未定义。 */
.record-item.doc-analyzed {
  background: var(--g-accent-bg, #e0f2f1);
  border-left: 6rpx solid var(--g-accent, #00897b);
}

/* 【VID-4 · 2026-10-20】该场次已上传答辩视频：浅红底色 + 左侧红条。
   只在没有报告评析时生效（wxml 里已保证 doc-analyzed 优先），
   两条链路同时存在时绿色为主、红色只体现在右上角标签上。 */
.record-item.has-video {
  background: #fdecea;
  border-left: 6rpx solid #c0392b;
}

/* 【2026-10-18】回答详情里的报告评析区（从「查看反馈」迁入） */
.doc-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 12rpx;
}

/* .primary-btn 默认 width:100%，并排时会把第二个按钮挤到下一行 */
.doc-actions .primary-btn,
.doc-actions .outline-btn {
  flex: 1;
  width: auto;
  margin: 0;
}

/* 成绩单抬头：总分 / 等级 / 服务端警告 */
.doc-score-summary {
  margin-top: 16rpx;
  padding: 16rpx 20rpx;
  background: var(--g-accent-bg, #e0f2f1);
  border-radius: 12rpx;
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 12rpx;
}

.doc-total {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--g-accent, #00897b);
}

.doc-warn {
  width: 100%;
  font-size: 24rpx;
  color: #b26a00;
}

/* 【2026-10-18】查看反馈里的报告综合评价：整段长文，保留换行 */
.doc-summary-box {
  margin-top: 12rpx;
  padding: 20rpx;
  background: #f7f9fb;
  border-radius: 12rpx;
  border-left: 6rpx solid var(--g-accent, #00897b);
}

.doc-summary-text {
  display: block;
  font-size: 27rpx;
  line-height: 1.8;
  color: #444444;
  white-space: pre-wrap;
  word-break: break-all;
}

/* 自动生成中的进度区（与结果区同尺寸，避免内容跳动） */
.doc-summary-loading {
  margin-top: 12rpx;
  padding: 20rpx;
  background: #f7f9fb;
  border-radius: 12rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

/* 五维小卡片：一维一条，形态对齐文字答辩「每题一条评语」 */
.doc-dim-item {
  margin-top: 12rpx;
  padding: 16rpx 20rpx;
  background: #f7f9fb;
  border-radius: 12rpx;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.doc-dim-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.doc-dim-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #333333;
}

.doc-dim-score {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--g-accent, #00897b);
}

.doc-dim-comment {
  font-size: 26rpx;
  line-height: 1.6;
  color: #555555;
}

.record-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: #eaf2ff;
  color: #008cba;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 600;
  font-size: 24rpx;
}

.record-body {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.record-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.record-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #333333;
}

.record-id {
  font-size: 22rpx;
  color: #888888;
}

.record-topic {
  font-size: 24rpx;
  color: #666666;
}

.record-date {
  font-size: 22rpx;
  color: #888888;
}

.record-score {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 8rpx;
}

.score {
  font-size: 34rpx;
  font-weight: 600;
  color: #4caf50;
}

/* 【2026-10-18】报告评析场次没有逐轮总分时，主分数改用报告分并标明来源 */
.score-kind {
  font-size: 20rpx;
  font-weight: 600;
  color: var(--g-accent, #00897b);
}

.score-meta {
  font-size: 20rpx;
  color: #888888;
  display: flex;
  flex-direction: column;
  gap: 2rpx;
}

.link {
  font-size: 24rpx;
  color: #007bff;
}

.link-sm {
  font-size: 22rpx;
  color: #007bff;
}

.profile-avatar {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.form-item {
  margin-bottom: 24rpx; /* 增加表单项之间的间距 */
}

.label {
  font-size: 24rpx;
  color: #666666;
}

.input {
  margin-top: 10rpx;
  padding: 16rpx 20rpx;
  background: #f7f9fb;
  border-radius: 12rpx;
  font-size: 26rpx;
  width: 100%;
  /* 确保占满整个容器 */
  box-sizing: border-box;
  /* 包含padding在内的总宽度为100% */
  min-height: 80rpx;
  /* 进一步增加最小高度以更好地显示多行内容 */
  line-height: 1.5;
  /* 改善文本可读性 */
  height: auto;
}

.picker {
  margin-top: 10rpx;
  padding: 16rpx 20rpx;
  background: #f7f9fb;
  border-radius: 12rpx;
  font-size: 26rpx;
  width: 100%;
  box-sizing: border-box;
  color: #333333;
  display: flex;
  align-items: center;
  min-height: 60rpx;
}

.textarea {
  margin-top: 10rpx;
  padding: 16rpx 20rpx;
  background: #f7f9fb;
  border-radius: 12rpx;
  font-size: 26rpx;
  min-height: 140rpx;
  /* 增加最小高度以更好地显示多行内容 */
  width: 100%;
  /* 确保占满整个容器 */
  box-sizing: border-box;
  /* 包含padding在内的总宽度为100% */
  line-height: 1.5;
  /* 改善文本可读性 */
  max-height: 600rpx;
  width: 100%;
}

.value {
  font-size: 28rpx;
  color: #333333;
  margin-top: 10rpx;
  display: block;
  background: #f7f9fb;
  /* 与输入框相同的背景色 */
  padding: 16rpx 20rpx;
  /* 与输入框相同的内边距 */
  border-radius: 12rpx;
  /* 与输入框相同的圆角 */
  width: 100%;
  /* 与输入框相同的宽度 */
  box-sizing: border-box;
  /* 包含padding在内的总宽度为100% */
  max-width: 650rpx;
  /* 包含padding在内的总宽度为100% */
  word-break: break-word;
  /* 确保长单词能正确换行 */
  white-space: pre-wrap;
}

.value.feedback {
  background: #f7f9fb;
  padding: 16rpx;
  border-radius: 12rpx;
  font-size: 24rpx;
  color: #666666;
  line-height: 1.5;
}

.cell {
  padding: 22rpx 8rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 2rpx solid #f0f0f0;
}

.cell:last-child {
  border-bottom: none;
}

.cell-text {
  font-size: 26rpx;
  color: #333333;
}

.cell-arrow {
  color: #bbbbbb;
}

.cell.danger .cell-text {
  color: #f44336;
}

.tab-bar {
  /* 【F4】回归文档流：作为 .page 的最后一个 flex 子项贴底，带底部安全区 */
  background: #ffffff;
  border-top: 2rpx solid #e8e8e8;
  display: flex;
  padding: 16rpx 0;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  flex-shrink: 0;
}

.tab-item {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
}

.tab-text {
  font-size: 24rpx;
  color: #888888;
}

.tab-item.active .tab-text {
  color: #4caf50;
  font-weight: 600;
}

/* ===== 弹层（添加题目 / 题目详情 / 答辩详情 / 回答详情 共用） =====
   注意：以下为一套唯一定义，勿再追加同名重复规则（历史上有两套互相覆盖，
   导致卡片宽度 90% + max-width 750rpx + margin 30rpx 打架，右侧被裁、阴影被切）。
   左右留白统一由 .modal-mask 的 padding 承担，卡片 width:100% —— 结构上不可能横向溢出。 */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.6);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 40rpx; /* 两侧留白（同时给阴影留出余量） */
  box-sizing: border-box;
  z-index: 1000;
}

.modal-card {
  width: 100%;
  max-width: 670rpx; /* 750rpx - 两侧各 40rpx */
  margin: 0;
  padding: 0;
  background: #ffffff;
  border-radius: 24rpx;
  box-shadow: 0 16rpx 36rpx rgba(0, 0, 0, 0.15);
  max-height: 86vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  box-sizing: border-box;
}

.modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-shrink: 0;
  padding: 32rpx 28rpx 20rpx;
  background: #ffffff;
  border-bottom: 1rpx solid #f0f0f0;
}

.modal-title {
  flex: 1;
  font-size: 36rpx;
  font-weight: 600;
  color: #333333;
}

/* 【F11】语音录音回放 */
.muted {
  font-size: 24rpx;
  color: #777777;
}

/* 【N8】五维雷达图 + 标准答案对照 */
.radar-canvas {
  width: 100%;
  height: 420rpx;
}

.standard-answer {
  color: #1f6b3b;
}

/* 【N10】题库批量导入 */
.import-mode-row {
  display: flex;
  align-items: center;
  margin: 16rpx 0;
}

.import-mode {
  padding: 8rpx 26rpx;
  margin-right: 16rpx;
  border-radius: 999rpx;
  border: 1rpx solid #d8dee9;
  color: #666666;
  font-size: 26rpx;
}

.import-mode.active {
  border-color: #2b6cff;
  background: #eef4ff;
  color: #2b6cff;
}

.import-btn-row {
  display: flex;
  align-items: center;
}

.import-btn-row .outline-btn,
.import-btn-row .primary-btn {
  flex: 1;
  margin: 0 8rpx;
}

/* 【N15】场次审计日志（开始/续答/结束时间线） */
.audit-log-row {
  padding: 8rpx 0;
  border-bottom: 1rpx solid #f0f2f5;
}

.audit-log-row:last-child {
  border-bottom: none;
}

.audit-log-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.audit-log-event {
  font-size: 26rpx;
  color: #333333;
  font-weight: 500;
}

.audit-log-time {
  font-size: 22rpx;
  color: #999999;
}

.voice-record-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 8rpx 0;
}

.voice-play-btn {
  flex-shrink: 0;
  margin-left: 16rpx;
  padding: 6rpx 22rpx;
  border-radius: 999rpx;
  background: #eef4ff;
  color: #2b6cff;
  font-size: 24rpx;
}

.modal-close {
  flex-shrink: 0;
  margin-left: 20rpx;
  padding: 8rpx 12rpx;
  font-size: 48rpx;
  line-height: 1;
  color: #999999;
  text-align: center;
}

.modal-body {
  flex: 1;
  min-height: 0; /* 允许在 max-height 内收缩，否则内容会把卡片撑破 */
  overflow-y: auto;
  overflow-x: hidden;
  padding: 20rpx 28rpx 28rpx;
  box-sizing: border-box;
}

/* 滚动条样式 */
.modal-body::-webkit-scrollbar {
  width: 6rpx;
}

.modal-body::-webkit-scrollbar-track {
  background: #f1f1f1;
  border-radius: 3rpx;
}

.modal-body::-webkit-scrollbar-thumb {
  background: #ccc;
  border-radius: 3rpx;
}

.modal-body::-webkit-scrollbar-thumb:hover {
  background: #aaa;
}

.modal-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 20rpx;
}

/* 问题和标准答案样式 */
.form-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 10rpx;
}

.add-question-btn {
  font-size: 24rpx;
  color: #008cba;
  padding: 6rpx 20rpx;
  border-radius: 12rpx;
  background: #eaf2ff;
  border: 1rpx solid #008cba;
  font-weight: 500;
}

.questions-container {
  max-height: 400rpx;
  overflow-y: auto;
  overflow-x: hidden;
  padding: 10rpx 0;
  margin-top: 10rpx;
}

.question-item {
  margin-bottom: 20rpx;
  padding: 16rpx;
  background: #f7f9fb;
  border-radius: 12rpx;
}

.question-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 10rpx;
}

.question-index {
  font-size: 28rpx;
  font-weight: 600;
  color: #333333;
}

.remove-question-btn {
  font-size: 24rpx;
  color: #f44336;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  background: #ffebee;
  font-weight: 500;
}

.question-detail-item {
  margin-bottom: 20rpx;
  padding: 16rpx;
  background: #f7f9fb;
  border-radius: 12rpx;
}

.question-text {
  display: block;
  font-weight: 600;
  color: #333333;
  margin-bottom: 10rpx;
}

.answer-text {
  display: block;
  color: #666666;
  font-size: 24rpx;
  line-height: 1.5;
}


