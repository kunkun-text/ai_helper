<view class="page">
  <view class="header-fixed">
    <text class="header-title">课程考核AI答辩辅助</text>
  </view>

  <scroll-view class="content" scroll-y>
    <view wx:if="{{activeTab === 'home'}}">
      <view class="welcome-card gradient-green">
        <view class="avatar-circle">
          <text class="avatar-text">T</text>
        </view>
        <view class="welcome-info">
          <text class="welcome-title">欢迎，{{user.name}}</text>
          <text class="welcome-subtitle">管理答辩题目并查看学生表现</text>
        </view>
      </view>

      <view class="stats-grid">
        <view class="stat-card">
          <view class="stat-icon blue">题</view>
          <view class="stat-info">
            <text class="stat-value">{{total}}</text>
            <text class="stat-label">答辩题目</text>
          </view>
        </view>
        <view class="stat-card">
          <view class="stat-icon green">记</view>
          <view class="stat-info">
            <text class="stat-value">{{defenseRecordsTotal}}</text>
            <text class="stat-label">答辩记录</text>
          </view>
        </view>
      </view>

      <view class="card">
        <view class="card-header">
          <text class="card-title">答辩题目设置</text>
          <button class="outline-btn add-btn" bindtap="openAddTopic">添加题目</button>
        </view>
        <scroll-view class="topic-list" scroll-y style="height: 540rpx;" bindscrolltolower="loadMoreTopics">
          <block wx:for="{{topics}}" wx:key="id">
            <view class="topic-item" bindtap="openTopicDetail" data-id="{{item.id}}">
              <view class="topic-main">
                <text class="topic-title">{{item.title}}</text>
                <text class="topic-desc">{{item.description}}</text>
                <text class="topic-date">答辩时间：{{item.date}}</text>
              </view>
              <text class="topic-arrow">></text>
            </view>
          </block>
        </scroll-view>
      </view>

      <view class="card">
        <view class="card-header">
          <text class="card-title">学生答辩记录</text>
          <view class="link" bindtap="switchTab" data-tab="records">查看全部</view>
        </view>
        <scroll-view 
          class="record-list" 
          scroll-y="true" 
          enable-back-to-top="true"
          lower-threshold="50"
          bindscrolltolower="onDefenseRecordsScrollToLower"
          refresher-enabled="true"
          refresher-triggered="{{defenseRecordsRefreshing}}"
          bindrefresherrefresh="onDefenseRecordsRefresh"
          style="max-height: 450rpx;">
          <block wx:for="{{defenseRecords}}" wx:key="id">
            <!-- 【VID-4 · 2026-10-20】底色优先级：报告评析（teal）为主，视频红只在该行没有报告评析时铺底；
                 红标签两者都显示，作为补充信息。 -->
            <view class="record-item {{item.analysisSource === 'report' ? 'doc-analyzed' : (item.hasVideo ? 'has-video' : '')}}" data-id="{{item.id}}">
              <view class="record-avatar">AI</view>
              <view class="record-body">
                <view class="record-row">
                  <text class="record-name">{{item.studentName}}</text>
                  <text class="record-id">({{item.studentId}})</text>
                </view>
                <text class="record-topic">{{item.topic}}</text>
                <text class="record-date">{{item.defenseTime}}</text>
              </view>
              <view class="record-score">
                <!-- 【2026-10-18】报告评析场次没有逐轮总分（0/NULL）时，主分数显示报告评析分，
                     并用小标签说明来源；有逐轮总分时仍显示答辩总分，报告分放 teal 标签。 -->
                <text wx:if="{{item.scoreKind === 'report'}}" class="score-kind">报告评析</text>
                <text class="score">{{item.displayScore}}分</text>
                <text wx:if="{{item.docTagText}}" class="g-tag g-tag-doc">{{item.docTagText}}</text>
                <!-- 【VID-4 · 2026-10-20】该场次已上传视频 → 详情里有「AI 评分（基于视频）」。 -->
                <text wx:if="{{item.hasVideo}}" class="g-tag g-tag-video">视频已上传</text>
                <text class="link-sm" bindtap="openAnswerDetail" data-id="{{item.id}}">查看回答详情</text>
                <text class="link-sm" bindtap="openFeedbackDetail" data-id="{{item.id}}">查看反馈</text>
              </view>
            </view>
          </block>
        </scroll-view>
      </view>
    </view>

    <view wx:elif="{{activeTab === 'records'}}">
      <view class="section-title">学生答辩记录</view>
      <!-- 搜索区域 -->
      <view class="search-container">
        <view class="search-inputs">
          <input 
            class="search-input" 
            placeholder="学生姓名" 
            value="{{searchUserName}}" 
            bindinput="onSearchUserNameInput" 
            maxlength="50"
          />
          <input 
            class="search-input" 
            placeholder="学号" 
            value="{{searchUserNumber}}" 
            bindinput="onSearchUserNumberInput" 
            maxlength="20"
          />
          <input 
            class="search-input" 
            placeholder="题目名称" 
            value="{{searchTopicName}}" 
            bindinput="onSearchTopicNameInput" 
            maxlength="100"
          />
        </view>
        <view class="search-actions">
          <button class = "outline-btn search-btn" bindtap="clearSearch">清空</button>
          <button class="primary-btn search-btn" bindtap="performSearch">搜索</button>
        </view>
      </view>
      
      <scroll-view 
        class="record-list-full" 
        scroll-y="true" 
        enable-back-to-top="true"
        lower-threshold="50"
        bindscrolltolower="onDefenseRecordsScrollToLower"
        refresher-enabled="true"
        refresher-triggered="{{defenseRecordsRefreshing}}"
        bindrefresherrefresh="onDefenseRecordsRefresh"
        style="height: 900rpx;">
        <view class="record-list full">
          <block wx:for="{{defenseRecords}}" wx:key="id">
            <!-- 【VID-4 · 2026-10-20】底色优先级：报告评析（teal）为主，视频红只在该行没有报告评析时铺底；
                 红标签两者都显示，作为补充信息。 -->
            <view class="record-item {{item.analysisSource === 'report' ? 'doc-analyzed' : (item.hasVideo ? 'has-video' : '')}}" data-id="{{item.id}}">
              <view class="record-avatar">AI</view>
              <view class="record-body">
                <view class="record-row">
                  <text class="record-name">{{item.studentName}}</text>
                  <text class="record-id">({{item.studentId}})</text>
                </view>
                <text class="record-topic">{{item.topic}}</text>
                <text class="record-date">{{item.defenseTime}}</text>
              </view>
              <view class="record-score">
                <!-- 【2026-10-18】报告评析场次没有逐轮总分（0/NULL）时，主分数显示报告评析分，
                     并用小标签说明来源；有逐轮总分时仍显示答辩总分，报告分放 teal 标签。 -->
                <text wx:if="{{item.scoreKind === 'report'}}" class="score-kind">报告评析</text>
                <text class="score">{{item.displayScore}}分</text>
                <text wx:if="{{item.docTagText}}" class="g-tag g-tag-doc">{{item.docTagText}}</text>
                <!-- 【VID-4 · 2026-10-20】该场次已上传视频 → 详情里有「AI 评分（基于视频）」。 -->
                <text wx:if="{{item.hasVideo}}" class="g-tag g-tag-video">视频已上传</text>
                <text class="link-sm" bindtap="openAnswerDetail" data-id="{{item.id}}">查看回答详情</text>
                <text class="link-sm" bindtap="openFeedbackDetail" data-id="{{item.id}}">查看反馈</text>
              </view>
            </view>
          </block>
          <!-- 将没有更多记录提醒放回scroll-view内部 -->
          <view wx:if="{{!defenseRecordsHasMore}}" style="text-align: center; padding: 20rpx;">
            <text>没有更多记录了</text>
          </view>
                <!-- 保持加载中提醒在外面 -->
          <view wx:if="{{defenseRecordsHasMore && defenseRecordsLoading}}" style="text-align: center; padding: 20rpx;">
            <text>加载中...</text>
          </view>
        </view>
      </scroll-view>
      


    </view>

    <view wx:elif="{{activeTab === 'profile'}}">
      <view class="section-title">个人信息</view>
      <view class="profile-avatar">
        <view class="avatar-circle large">
          <text class="avatar-text">T</text>
        </view>
        <view class="link" wx:if="{{!isEditing}}" bindtap="startEdit">修改头像</view>
      </view>

      <view class="card">

        <view class="form-item">
          <text class="label">姓名</text>
          <input class="input" wx:if="{{isEditing}}" value="{{editedUser.name}}" bindinput="onEditName" />
          <text class="value" wx:else>{{user.name}}</text>
        </view>
        <view class="form-item">
          <text class="label">教师编号</text>
          <input class="input" wx:if="{{isEditing}}" value="{{editedUser.userNumber}}" bindinput="onEditUserNumber" />
          <text class="value" wx:else>{{user.userNumber}}</text>
        </view>
        <view class="form-item">
          <text class="label">手机号码</text>
          <input class="input" wx:if="{{isEditing}}" value="{{editedUser.phone}}" bindinput="onEditPhone" />
          <text class="value" wx:else>{{user.phone}}</text>
        </view>
        <view class="form-item">
          <text class="label">邮箱</text>
          <input class="input" wx:if="{{isEditing}}" value="{{editedUser.email}}" bindinput="onEditEmail" />
          <text class="value" wx:else>{{user.email}}</text>
        </view>
        <button class="primary-btn" wx:if="{{isEditing}}" bindtap="saveProfile" disabled="{{savingProfile}}">保存信息</button>
        <button class="primary-btn" wx:else bindtap="startEdit">修改个人信息</button>
      </view>

      <view class="card">
        <view class="cell" bindtap="goStats">
          <text class="cell-text">数据总览</text>
          <text class="cell-arrow">></text>
        </view>
        <view class="cell" bindtap="exportRecords">
          <text class="cell-text">导出答辩成绩</text>
          <text class="cell-arrow">></text>
        </view>
        <view class="cell" bindtap="exportTopicStats">
          <text class="cell-text">导出课题统计</text>
          <text class="cell-arrow">></text>
        </view>
        <view class="cell" bindtap="goFeedbackAdmin">
          <text class="cell-text">反馈管理</text>
          <text class="cell-arrow">></text>
        </view>
        <view class="cell" bindtap="goFeedback">
          <text class="cell-text">意见反馈</text>
          <text class="cell-arrow">></text>
        </view>
        <view class="cell" bindtap="switchTab" data-tab="settings">
          <text class="cell-text">设置</text>
          <text class="cell-arrow">></text>
        </view>
        <view class="cell danger" bindtap="logout">
          <text class="cell-text">退出登录</text>
          <text class="cell-arrow">></text>
        </view>
      </view>
    </view>

    <view wx:elif="{{activeTab === 'settings'}}">
      <view class="section-title">设置</view>
      <view class="card">
        <view class="cell">
          <text class="cell-text">通知设置</text>
          <text class="cell-arrow">></text>
        </view>
        <view class="cell">
          <text class="cell-text">隐私设置</text>
          <text class="cell-arrow">></text>
        </view>
        <view class="cell">
          <text class="cell-text">关于我们</text>
          <text class="cell-arrow">></text>
        </view>
        <view class="cell danger" bindtap="logout">
          <text class="cell-text">退出登录</text>
          <text class="cell-arrow">></text>
        </view>
      </view>
    </view>
  </scroll-view>

  <view class="tab-bar">
    <view class="tab-item {{activeTab === 'home' ? 'active' : ''}}" bindtap="switchTab" data-tab="home">
      <text class="tab-text">答辩题目</text>
    </view>
    <view class="tab-item {{activeTab === 'records' ? 'active' : ''}}" bindtap="switchTab" data-tab="records">
      <text class="tab-text">答辩记录</text>
    </view>
    <view class="tab-item {{activeTab === 'profile' ? 'active' : ''}}" bindtap="switchTab" data-tab="profile">
      <text class="tab-text">我的</text>
    </view>
  </view>

  <view class="modal-mask" wx:if="{{showAddTopic}}">
    <view class="modal-card">
      <view class="modal-header">
        <text class="modal-title">{{isEditingTopic ? '编辑答辩题目' : '添加新的答辩题目'}}</text>
        <text class="modal-close" bindtap="closeAddTopic">×</text>
      </view>
      <scroll-view class="modal-body" scroll-y="true">
        <view class="form-item">
          <text class="label">题目标题</text>
          <textarea class="input" value="{{newTopic.title}}" placeholder="请输入答辩题目" bindinput="onTopicTitleInput" auto-height="true" maxlength="200"/>
        </view>
        <view class="form-item">
          <text class="label">题目描述</text>
          <textarea class="textarea" value="{{newTopic.description}}" placeholder="请输入题目描述和要求" bindinput="onTopicDescInput" auto-height="true" maxlength="2000"/>
        </view>
        <view class="form-item">
          <text class="label">答辩时间</text>
          <picker mode="date" value="{{newTopic.date}}" bindchange="onTopicDateChange">
            <view class="picker">{{newTopic.date ? newTopic.date : '选择日期'}}</view>
          </picker>
        </view>
        
        <!-- 问题和标准答案区域 -->
        <view class="form-item">
          <view class="form-header">
            <text class="label">问题和标准答案</text>
            <text class="add-question-btn" bindtap="addQuestion">+ 添加问题</text>
          </view>
          <view class="questions-container">
            <block wx:for="{{newTopic.questions}}" wx:key="index">
              <view class="question-item">
                <view class="question-header">
                  <text class="question-index">问题 {{index + 1}}</text>
                  <text class="remove-question-btn" bindtap="removeQuestion" data-index="{{index}}">删除</text>
                </view>
                <input class="input" value="{{item.question}}" placeholder="请输入问题" bindinput="onQuestionInput" data-index="{{index}}" maxlength="500" />
                <textarea class="textarea" value="{{item.answer}}" placeholder="请输入标准答案" bindinput="onAnswerInput" data-index="{{index}}" maxlength="2000" />
              </view>
            </block>
          </view>
        </view>
        
        <view class="modal-actions">
          <button class="outline-btn" bindtap="closeAddTopic">取消</button>
          <button class="primary-btn" bindtap="addTopic" disabled="{{savingTopic}}">{{isEditingTopic ? '更新题目' : '添加题目'}}</button>
        </view>
      </scroll-view>
    </view>
  </view>

  <!-- 答辩题目详情弹窗 -->
  <view class="modal-mask" wx:if="{{selectedTopic}}">
    <view class="modal-card">
      <view class="modal-header">
        <text class="modal-title">答辩题目详情</text>
        <text class="modal-close" bindtap="closeTopicDetail">×</text>
      </view>
      <scroll-view class="modal-body" scroll-y="true">
        <view class="form-item">
          <text class="label">题目标题</text>
          <text class="value">{{selectedTopic.title}}</text>
        </view>
        <view class="form-item">
          <text class="label">题目描述</text>
          <text class="value">{{selectedTopic.description}}</text>
        </view>
        <view class="form-item">
          <text class="label">答辩时间</text>
          <text class="value">{{selectedTopic.date || '未设定'}}</text>
        </view>
        <view class="form-item">
          <text class="label">创建时间</text>
          <text class="value">{{selectedTopic.createTime || 'N/A'}}</text>
        </view>
        
        <!-- 显示问题和标准答案 -->
        <view class="form-item" wx:if="{{selectedTopic.questions && selectedTopic.questions.length > 0}}">
          <text class="label">问题与标准答案</text>
          <scroll-view class="questions-container" scroll-y="true">
            <block wx:for="{{selectedTopic.questions}}" wx:key="questionId">
              <view class="question-detail-item">
                <view class="question-block">
                  <text class="question-label">问题 {{index + 1}}:</text>
                  <scroll-view class="long-text-scroll" scroll-y="true" style="max-height: 150rpx;">
                    <text class="question-text">{{item.question}}</text>
                  </scroll-view>
                </view>
                <view class="answer-block">
                  <text class="answer-label">标准答案:</text>
                  <scroll-view class="long-text-scroll" scroll-y="true" style="max-height: 150rpx;">
                    <text class="answer-text">{{item.standardAnswer}}</text>
                  </scroll-view>
                </view>
              </view>
            </block>
          </scroll-view>
        </view>
        
        <!-- 【N9】按课题导出成绩（只含本课题的答辩记录） -->
        <view class="form-item">
          <text class="label">成绩导出</text>
          <button class="outline-btn" data-topic-id="{{selectedTopic.id}}" bindtap="exportRecords">导出本课题成绩 CSV</button>
        </view>

        <!-- 【N10】题库批量导入（CSV） -->
        <view class="form-item">
          <text class="label">题库批量导入</text>
          <text class="muted">CSV 模板：第一列＝题目，第二列＝标准答案；以 # 开头的行会被忽略；单次最多 500 条</text>
          <view class="import-mode-row">
            <text class="import-mode {{importMode === 'append' ? 'active' : ''}}"
              data-mode="append" bindtap="onImportModeChange">追加导入</text>
            <text class="import-mode {{importMode === 'replace' ? 'active' : ''}}"
              data-mode="replace" bindtap="onImportModeChange">覆盖导入</text>
          </view>
          <view class="import-btn-row">
            <button class="outline-btn" bindtap="downloadImportTemplate">下载模板</button>
            <button class="primary-btn" bindtap="importQuestionsFromCsv" disabled="{{importing}}">
              {{importing ? '导入中…' : '从聊天选择 CSV 导入'}}
            </button>
          </view>
          <text class="muted">在电脑上按模板填好后，用微信「文件传输助手」发到手机，再点上面的按钮从聊天记录选择该文件。</text>
        </view>

        <view class="modal-actions" style="margin-top: 20px;">
          <button class="outline-btn red" bindtap="deleteTopic">删除题目</button>
          <button class="primary-btn" bindtap="editTopic">编辑题目</button>
        </view>
      </scroll-view>
    </view>
  </view>

  <view class="modal-mask" wx:if="{{selectedRecord}}">
    <view class="modal-card">
      <view class="modal-header">
        <text class="modal-title">答辩详情</text>
        <text class="modal-close" bindtap="closeRecord">×</text>
      </view>
      <scroll-view class="modal-body" scroll-y="true">
        <view class="form-item">
          <text class="label">学生信息</text>
          <text class="value">{{selectedRecord.studentName}}（{{selectedRecord.studentNumber}}）</text>
        </view>
        <view class="form-item">
          <text class="label">答辩时间</text>
          <text class="value">{{selectedRecord.defenseTime}}</text>
        </view>
        
        <!-- 答辩视频 -->
        <view class="form-item" wx:if="{{selectedRecord.defenseVideoUrl && selectedRecord.defenseVideoUrl !== 'abc'}}">
          <text class="label">答辩视频</text>
          <view class="video-container">
            <video 
              src="{{selectedRecord.defenseVideoUrl}}" 
              controls="true" 
              autoplay="false" 
              poster="" 
              style="width: 100%; height: 300rpx; background-color: #000;"
              show-center-play-btn="true"
              enable-progress-gesture="true"
              object-fit="contain">
            </video>
          </view>
        </view>
        <view class="form-item" wx:elif="{{selectedRecord.defenseVideoUrl === 'abc'}}">
          <text class="label">答辩视频</text>
          <text class="value">视频地址无效或未上传</text>
        </view>

        <!-- 【2026-10-20 · 视频 AI 评分】听声识别后按五维评分，产出与「报告 AI 评析」同形态的成绩单。
             一次要跑十几分钟（whisper 在 CPU 上约 1~3 倍实时），所以走「提交 + 轮询」。 -->
        <view class="form-item" wx:if="{{selectedRecord.defenseVideoUrl && selectedRecord.defenseVideoUrl !== 'abc'}}">
          <text class="label">视频 AI 评分（基于视频里的说话内容）</text>
          <view class="doc-actions">
            <button class="primary-btn" bindtap="analyzeVideo" disabled="{{videoAnalyzing}}">
              {{videoAnalyzing ? videoStage : (selectedRecord.aiVideoAnalysis ? '重新生成视频评分' : 'AI 评分（基于视频）')}}
            </button>
          </view>
          <view wx:if="{{videoAnalyzing}}" class="g-bar" style="margin-top: 16rpx;">
            <view class="g-bar-inner" style="width: {{videoPercent}}%;"></view>
          </view>
          <text wx:if="{{videoAnalyzing}}" class="muted">{{videoStage}}</text>

          <!-- 成绩单抬头：总分 / 等级 / 服务端警告（跑题） -->
          <view wx:if="{{videoSummary}}" class="doc-score-summary">
            <text class="doc-total">总分 {{videoSummary.total}}/50</text>
            <text wx:if="{{videoSummary.grade}}" class="g-tag g-tag-doc">等级 {{videoSummary.grade}}</text>
            <view wx:for="{{videoSummary.warnings}}" wx:key="*this" class="doc-warn">⚠️ {{item}}</view>
          </view>

          <!-- 五维小卡片：与报告评析完全相同的样式与解析器 -->
          <block wx:if="{{videoDims.length > 0}}">
            <view wx:for="{{videoDims}}" wx:key="name" class="doc-dim-item">
              <view class="doc-dim-head">
                <text class="doc-dim-name">{{item.missing ? '⚠️ ' : ''}}{{item.name}}</text>
                <text class="doc-dim-score">{{item.score}} 分</text>
              </view>
              <text class="doc-dim-comment">{{item.comment}}</text>
            </view>
          </block>
          <!-- 格式漂移兜底：解析不出五维时展示原文，绝不静默丢内容 -->
          <scroll-view wx:if="{{videoDims.length === 0 && videoRaw}}" class="long-text-scroll" scroll-y="true" style="max-height: 400rpx;">
            <text class="value feedback">{{videoRaw}}</text>
          </scroll-view>
        </view>
        
        <!-- 答辩报告 -->
        <view class="form-item" wx:if="{{selectedRecord.defenseReportUrl && selectedRecord.defenseReportUrl !== 'abc'}}">
          <text class="label">答辩报告</text>
          <button class="primary-btn" bindtap="viewDefenseReport" data-url="{{selectedRecord.defenseReportUrl}}">查看文档</button>
        </view>
        <view class="form-item" wx:elif="{{selectedRecord.defenseReportUrl === 'abc'}}">
          <text class="label">答辩报告</text>
          <text class="value">文档地址无效或未上传</text>
        </view>

        <!-- 【2026-10-18】AI 对整份报告的综合评价（基于上传的文件，约 400~700 字）。
             打开本弹层时若「有报告但缺总评」会自动提交生成任务并轮询；
             这里按 长文 / 生成中 / 失败 三态展示，不留空白。 -->
        <view class="form-item" wx:if="{{selectedRecord.defenseReportUrl && selectedRecord.defenseReportUrl !== 'abc'}}">
          <text class="label">报告 AI 综合评价（基于上传的文件）</text>
          <view wx:if="{{selectedRecord.reportDocSummary}}" class="doc-summary-box">
            <text class="doc-summary-text">{{selectedRecord.reportDocSummary}}</text>
          </view>
          <!-- 【2026-10-18】打开弹层时若缺总评会自动提交生成任务；这里展示进度 -->
          <view wx:elif="{{feedbackSummaryGenerating}}" class="doc-summary-loading">
            <view class="g-bar">
              <view class="g-bar-inner" style="width: 60%;"></view>
            </view>
            <text class="muted">{{feedbackSummaryStage || '正在生成综合评价…'}}</text>
          </view>
          <text wx:elif="{{feedbackSummaryError}}" class="muted">{{feedbackSummaryError}}</text>
          <text wx:else class="muted">该报告还没有生成综合评价。请到「查看回答详情」里生成报告评析后再查看。</text>
        </view>

        <!-- 【2026-10-18】基于上传报告文档的 AI 评析已迁到「回答详情」弹层：
             报告评析场次通常没有逐轮作答，「查看回答详情」此前是空白，
             而「查看反馈」里却放着报告评析——现在统一到回答详情，
             并紧贴评析提供「查看文档」入口，教师可同屏对照。 -->

        <!-- AI分析结果 -->
        <view class="form-item" wx:if="{{selectedRecord.aiVideoAnalysis}}">
          <text class="label">AI视频分析</text>
          <scroll-view class="long-text-scroll" scroll-y="true" style="max-height: 150rpx;">
            <text class="value feedback">{{selectedRecord.aiVideoAnalysis}}</text>
          </scroll-view>
        </view>
        
        <view class="form-item" wx:if="{{selectedRecord.aiReportAnalysis}}">
          <text class="label">AI报告分析</text>
          <scroll-view class="long-text-scroll" scroll-y="true" style="max-height: 150rpx;">
            <text class="value feedback">{{selectedRecord.aiReportAnalysis}}</text>
          </scroll-view>
        </view>
        
        <view class="form-item" wx:if="{{selectedRecord.aiAllAnalysis}}">
          <text class="label">AI综合分析</text>
          <scroll-view class="long-text-scroll" scroll-y="true" style="max-height: 150rpx;">
            <text class="value feedback">{{selectedRecord.aiAllAnalysis}}</text>
          </scroll-view>
        </view>
      </scroll-view>
    </view>
  </view>
  
  <!-- 回答详情模态框 -->
  <view class="modal-mask" wx:if="{{selectedAnswers}}">
    <view class="modal-card">
      <view class="modal-header">
        <text class="modal-title">回答详情</text>
        <text class="modal-close" bindtap="closeAnswers">×</text>
      </view>
      <scroll-view class="modal-body" scroll-y="true">
        <!-- 【2026-10-18 · 报告五维评分】基于上传报告文档的 AI 评析（从「查看反馈」迁入）。
             本弹层是教师核对「AI 看到了什么」的地方；报告评析场次没有逐轮作答，
             若无本区块就是一片空白。五维拆成独立小卡片，形态对齐文字答辩「每题一条评语」。 -->
        <view wx:if="{{answerDocInfo && (answerDocInfo.defenseReportUrl || answerDocInfo.reportDocAnalysis)}}" class="form-item">
          <text class="label">报告 AI 评析（基于上传的文件）</text>
          <view class="doc-actions">
            <button
              wx:if="{{answerDocInfo.defenseReportUrl && answerDocInfo.defenseReportUrl !== 'abc'}}"
              class="outline-btn"
              bindtap="viewDefenseReport"
              data-url="{{answerDocInfo.defenseReportUrl}}">查看文档</button>
            <button
              class="primary-btn"
              bindtap="analyzeReportDoc"
              disabled="{{docAnalyzing}}">
              {{docAnalyzing ? docStage : (answerDocInfo.reportDocAnalysis ? '重新生成评析' : 'AI 评分（基于报告）')}}
            </button>
          </view>
          <view wx:if="{{docAnalyzing}}" class="g-bar" style="margin-top: 16rpx;">
            <view class="g-bar-inner" style="width: {{docPercent}}%;"></view>
          </view>
          <text wx:if="{{docAnalyzing}}" class="muted">{{docStage}}</text>

          <!-- 成绩单抬头：总分 / 等级 / 服务端警告（跑题、接地失败） -->
          <view wx:if="{{answerDocSummary}}" class="doc-score-summary">
            <text class="doc-total">总分 {{answerDocSummary.total}}/50</text>
            <text wx:if="{{answerDocSummary.grade}}" class="g-tag g-tag-doc">等级 {{answerDocSummary.grade}}</text>
            <view wx:for="{{answerDocSummary.warnings}}" wx:key="*this" class="doc-warn">⚠️ {{item}}</view>
          </view>

          <!-- 五维小卡片：每维一条短评；⚠️ = 该维点评自认缺失、分数已被服务端压低 -->
          <block wx:if="{{answerDocDims.length > 0}}">
            <view wx:for="{{answerDocDims}}" wx:key="name" class="doc-dim-item">
              <view class="doc-dim-head">
                <text class="doc-dim-name">{{item.missing ? '⚠️ ' : ''}}{{item.name}}</text>
                <text class="doc-dim-score">{{item.score}} 分</text>
              </view>
              <text class="doc-dim-comment">{{item.comment}}</text>
            </view>
          </block>
          <!-- 格式漂移兜底：解析不出五维时展示原文，绝不静默丢内容 -->
          <scroll-view wx:if="{{answerDocDims.length === 0 && answerDocRaw}}" class="long-text-scroll" scroll-y="true" style="max-height: 400rpx;">
            <text class="value feedback">{{answerDocRaw}}</text>
          </scroll-view>
        </view>

        <!-- 【2026-10-20 · 评分表成绩单化】与学生端同一套口径（utils/scoreCard.js）：
             总分 + 等级 + 逐维平均 + 逐轮大模型评语。此前只有纯文本分数行，评语不展示。 -->
        <view wx:if="{{scoreSummary}}" class="form-item">
          <text class="label">评分表（本地大模型判定）</text>
          <view class="sc-summary">
            <text class="sc-total">{{scoreSummary.totalText}}</text>
            <text class="sc-total-max">/50</text>
            <text class="g-tag g-tag-doc">{{scoreSummary.grade}}</text>
            <text class="sc-total-note">逐轮平均 · 共 {{scoreSummary.roundCount}} 轮</text>
          </view>
          <view class="sc-dims">
            <view wx:for="{{scoreSummary.dims}}" wx:key="name" class="sc-dim">
              <text class="sc-dim-name">{{item.name}}</text>
              <text class="sc-dim-score">{{item.avg}}</text>
            </view>
          </view>
          <text class="sc-tip">五维各 10 分、合计 50 分；等级与报告评析同一把尺子（≥35 优秀 / 26~34 良好 / 15~25 合格 / 5~14 不合格 / 5 分以下无效）。</text>
        </view>
        <view wx:if="{{scoreCards.length > 0}}" class="form-item">
          <text class="label">逐轮判定与依据</text>
          <view wx:for="{{scoreCards}}" wx:key="roundNum" class="sc-round">
            <view class="sc-round-head">
              <text class="sc-round-title">第 {{item.roundNum}} 轮</text>
              <text class="sc-round-total">{{item.totalText}} / 50</text>
              <text class="g-tag g-tag-doc">{{item.grade}}</text>
            </view>
            <view class="sc-round-dims">
              <text wx:for="{{item.dims}}" wx:for-item="dim" wx:key="name" class="sc-round-dim">{{dim.name}} {{dim.score}}</text>
            </view>
            <text wx:if="{{item.comment}}" class="sc-round-comment">{{item.comment}}</text>
            <text wx:else class="sc-round-comment sc-muted">本轮模型未返回评语</text>
          </view>
        </view>
        <view wx:if="{{radarDims.length === 5}}" class="form-item">
          <text class="label">五维能力雷达图（逐轮平均）</text>
          <canvas type="2d" id="radarCanvas" class="radar-canvas"></canvas>
          <text class="muted">{{radarText}}</text>
        </view>

        <!-- 【N15】场次审计日志：开始 / 中途续答 / 结束 的时间线 -->
        <view wx:if="{{auditLogs.length > 0}}" class="form-item">
          <text class="label">场次审计日志</text>
          <view wx:for="{{auditLogs}}" wx:key="key" class="audit-log-row">
            <view class="audit-log-head">
              <text class="audit-log-event">{{item.event}}</text>
              <text class="audit-log-time">{{item.time}}</text>
            </view>
            <text class="muted" wx:if="{{item.roundText || item.detail}}">{{item.roundText}}{{item.roundText && item.detail ? ' · ' : ''}}{{item.detail}}</text>
          </view>
        </view>

        <!-- 【F11】语音答辩逐轮录音回放（仅语音答辩场次有归档） -->
        <view wx:if="{{voiceRecords.length > 0}}" class="form-item">
          <text class="label">语音录音回放</text>
          <view wx:for="{{voiceRecords}}" wx:key="key" class="voice-record-row">
            <text class="muted">{{item.label}}</text>
            <text class="voice-play-btn" data-url="{{item.url}}" catchtap="playVoiceRecord">▶ 播放</text>
          </view>
        </view>
        <block wx:for="{{selectedAnswers}}" wx:key="answerId">
          <view class="answer-item">
            <view class="answer-header">
              <text class="answer-type {{item.questionTypeClass}}">{{item.questionTypeLabel}}</text>
              <text class="answer-score">评分: {{item.score}}分</text>
            </view>
            <view class="form-item">
              <text class="label">问题</text>
              <scroll-view class="long-text-scroll" scroll-y="true" style="max-height: 150rpx;">
                <text class="value" wx:if="{{item.question !== null}}">{{item.question}}</text>
                <text class="value" wx:else>{{item.customQuestion}}</text>
              </scroll-view>
            </view>
            <view class="form-item">
              <text class="label">学生回答</text>
              <scroll-view class="long-text-scroll" scroll-y="true" style="max-height: 150rpx;">
                <text class="value">{{item.studentAnswer}}</text>
              </scroll-view>
            </view>
            <!-- 【N8】标准答案对照：预设题有标准答案；追问没有，无值时不显示 -->
            <view class="form-item" wx:if="{{item.standardAnswer}}">
              <text class="label">标准答案</text>
              <scroll-view class="long-text-scroll" scroll-y="true" style="max-height: 200rpx;">
                <text class="value standard-answer">{{item.standardAnswer}}</text>
              </scroll-view>
            </view>
            <view class="form-item">
              <text class="label">反馈</text>
              <scroll-view class="long-text-scroll" scroll-y="true" style="max-height: 150rpx;">
                <text class="value feedback">{{item.feedback}}</text>
              </scroll-view>
            </view>
            <view class="form-item">
              <text class="label">回答时间</text>
              <text class="value">{{item.createdAt}}</text>
            </view>
            <view class="answer-separator"></view>
          </view>
        </block>
      </scroll-view>
    </view>
  </view>
</view>