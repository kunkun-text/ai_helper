.page {
  min-height: 100vh;
  background: #f4f6f9;
  display: flex;
  flex-direction: column;
}

/* ======== Header ======== */
.header {
  height: 120rpx;
  background: #ffffff;
  display: flex;
  align-items: center;
  padding: 0 24rpx;
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
}

.header-left {
  width: 80rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.back-icon {
  font-size: 48rpx;
  color: #333;
  font-weight: 300;
  line-height: 1;
}

.header-center {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  margin-right: 80rpx;
}

.header-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  max-width: 400rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.header-status {
  display: flex;
  align-items: center;
  margin-top: 4rpx;
}

.status-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  margin-right: 8rpx;
}

.status-dot.ongoing {
  background: #52c41a;
}

.status-dot.finished {
  background: #999;
}

.status-dot.error {
  background: #ff4d4f;
}

.status-text {
  font-size: 22rpx;
  color: #999;
}

/* ======== Message List ======== */
.msg-list {
  flex: 1;
  padding: 140rpx 24rpx 120rpx;
  box-sizing: border-box;
}

/* System Message */
.msg-system {
  text-align: center;
  margin: 24rpx 0;
}

.msg-system-text {
  font-size: 24rpx;
  color: #999;
  background: #e8e8e8;
  padding: 8rpx 24rpx;
  border-radius: 20rpx;
  display: inline-block;
}

/* Message Row */
.msg-row {
  display: flex;
  margin-bottom: 28rpx;
  align-items: flex-start;
}

.msg-ai {
  justify-content: flex-start;
}

.msg-user {
  justify-content: flex-end;
}

/* Avatar */
.msg-avatar {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  font-weight: 600;
  flex-shrink: 0;
}

.ai-avatar {
  background: #eaf2ff;
  color: #1890ff;
  margin-right: 16rpx;
}

/* Message Content */
.msg-content {
  max-width: 560rpx;
}

.user-content {
  display: flex;
  justify-content: flex-end;
}

/* Message Bubble */
.msg-bubble {
  padding: 20rpx 24rpx;
  border-radius: 16rpx;
  font-size: 28rpx;
  line-height: 1.6;
  word-break: break-word;
}

.ai-bubble {
  background: #ffffff;
  color: #333;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
  border-top-left-radius: 4rpx;
}

.user-bubble {
  background: linear-gradient(135deg, #4CAF50, #43a047);
  color: #ffffff;
  border-top-right-radius: 4rpx;
}

.msg-text {
  white-space: pre-wrap;
}

.user-text {
  color: #ffffff;
}

/* ======== Message Sections ======== */
.msg-section {
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 2rpx solid #f0f0f0;
}

.section-label {
  font-size: 24rpx;
  font-weight: 600;
  color: #666;
  display: block;
  margin-bottom: 8rpx;
}

.section-text {
  font-size: 26rpx;
  color: #444;
  line-height: 1.6;
  white-space: pre-wrap;
}

/* Score Display */
.section-score {
  text-align: center;
  padding: 12rpx 0;
  border-top: 2rpx solid #f0f0f0;
}

.score-value {
  font-size: 56rpx;
  font-weight: 700;
  color: #f5a623;
}

.score-unit {
  font-size: 28rpx;
  font-weight: 400;
  color: #999;
}

/* Total Score */
.section-total-score {
  text-align: center;
  padding: 20rpx 0;
  background: linear-gradient(135deg, #fff8e1, #fff3cd);
  border-radius: 12rpx;
  margin-top: 16rpx;
  border-top: none;
}

.total-score-value {
  font-size: 72rpx;
  font-weight: 700;
  color: #e8a317;
}

/* Summary Section */
.section-summary {
  background: #f0f9f0;
  padding: 16rpx;
  border-radius: 12rpx;
  border-top: none;
  margin-top: 12rpx;
}

.section-analysis {
  background: #f0f4ff;
  padding: 16rpx;
  border-radius: 12rpx;
  border-top: none;
  margin-top: 12rpx;
}

/* Section Eval */
.section-eval {
  background: #fff8e1;
  padding: 16rpx;
  border-radius: 12rpx;
  border-top: none;
  margin-top: 12rpx;
}

/* Section Question */
.section-question {
  background: #e8f5e9;
  padding: 16rpx;
  border-radius: 12rpx;
  border-top: none;
  margin-top: 12rpx;
}

.section-label-question {
  font-size: 24rpx;
  font-weight: 600;
  color: #2e7d32;
  display: block;
  margin-bottom: 8rpx;
}

/* ======== Typing Indicator ======== */
.typing-indicator {
  display: flex;
  align-items: center;
  padding: 8rpx 0;
}

.typing-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #bbb;
  margin-right: 12rpx;
  animation: typingBounce 1.4s ease-in-out infinite;
}

.typing-dot:nth-child(2) {
  animation-delay: 0.2s;
}

.typing-dot:nth-child(3) {
  animation-delay: 0.4s;
  margin-right: 0;
}

@keyframes typingBounce {
  0%, 60%, 100% {
    transform: translateY(0);
    opacity: 0.4;
  }
  30% {
    transform: translateY(-12rpx);
    opacity: 1;
  }
}

/* ======== Input Bar ======== */
.input-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #ffffff;
  padding: 16rpx 24rpx;
  display: flex;
  align-items: center;
  box-shadow: 0 -2rpx 8rpx rgba(0, 0, 0, 0.04);
  z-index: 100;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
}

.input-bar-hidden {
  display: none;
}

.msg-input {
  flex: 1;
  height: 72rpx;
  background: #f5f5f5;
  border-radius: 36rpx;
  padding: 0 28rpx;
  font-size: 28rpx;
  color: #333;
}

.send-btn {
  width: 120rpx;
  height: 72rpx;
  line-height: 72rpx;
  text-align: center;
  background: #d5cece;
  color: #fff;
  border-radius: 36rpx;
  font-size: 28rpx;
  margin-left: 16rpx;
  flex-shrink: 0;
  border: none;
  padding: 0;
}

.send-btn::after {
  border: none;
}

.send-btn.send-active {
  background: #4CAF50;
}

/* ======== Finish Modal ======== */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 999;
}

.finish-card {
  width: 86%;
  max-height: 80vh;
  background: #ffffff;
  border-radius: 28rpx;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  box-shadow: 0 16rpx 48rpx rgba(0, 0, 0, 0.2);
}

.finish-header {
  text-align: center;
  padding: 48rpx 32rpx 24rpx;
  border-bottom: 2rpx solid #f0f0f0;
}

.finish-icon {
  font-size: 72rpx;
  display: block;
  margin-bottom: 16rpx;
}

.finish-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #333;
}

.finish-body {
  flex: 1;
  padding: 24rpx 32rpx;
  overflow-y: auto;
}

.finish-total-score {
  text-align: center;
  padding: 24rpx 0;
  margin-bottom: 20rpx;
  background: linear-gradient(135deg, #fff8e1, #fff3cd);
  border-radius: 16rpx;
}

.finish-score-label {
  font-size: 28rpx;
  color: #666;
  display: block;
  margin-bottom: 8rpx;
}

.finish-score-value {
  font-size: 96rpx;
  font-weight: 700;
  color: #e8a317;
}

.finish-score-unit {
  font-size: 32rpx;
  color: #999;
  margin-left: 4rpx;
}

.finish-section {
  margin-bottom: 20rpx;
  padding: 16rpx;
  background: #f7f9fb;
  border-radius: 12rpx;
}

.finish-section-label {
  font-size: 24rpx;
  font-weight: 600;
  color: #666;
  display: block;
  margin-bottom: 8rpx;
}

.finish-section-text {
  font-size: 26rpx;
  color: #444;
  line-height: 1.6;
  white-space: pre-wrap;
}

.finish-actions {
  padding: 20rpx 32rpx 32rpx;
  border-top: 2rpx solid #f0f0f0;
}

.finish-btn {
  width: 100%;
  height: 80rpx;
  line-height: 80rpx;
  border-radius: 40rpx;
  font-size: 28rpx;
  text-align: center;
  margin-bottom: 16rpx;
  border: none;
}

.finish-btn::after {
  border: none;
}

.finish-btn.primary {
  background: #4CAF50;
  color: #ffffff;
}

.finish-btn.outline {
  background: transparent;
  color: #666;
  border: 2rpx solid #ddd;
}

/* ======== Error Retry ======== */
.error-bar {
  text-align: center;
  padding: 16rpx;
  margin: 8rpx 0;
}

.error-text {
  font-size: 24rpx;
  color: #ff4d4f;
  display: block;
  margin-bottom: 8rpx;
}

.retry-link {
  font-size: 24rpx;
  color: #1890ff;
  text-decoration: underline;
}
