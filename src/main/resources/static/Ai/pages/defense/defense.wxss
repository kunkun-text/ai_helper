.page {
  /* 结构性修复：整页固定视口高 + 内部 flex 滚动，header/输入栏回归文档流，
     消除 fixed 悬浮层与原生组件 textarea 的渲染合成（粘贴/换行错乱复发的根） */
  height: 100vh;
  overflow: hidden;
  background: #f4f6f9;
  display: flex;
  flex-direction: column;
}

/* ======== Header ======== */
.header {
  height: 120rpx;
  background: #ffffff;
  display: flex;
  align-items: center;
  padding: 0 24rpx;
  flex-shrink: 0;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
}

.header-left {
  width: 80rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.back-icon {
  font-size: 48rpx;
  color: #333;
  font-weight: 300;
  line-height: 1;
}

.header-center {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  margin-right: 80rpx;
}

.header-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  max-width: 400rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.header-status {
  display: flex;
  align-items: center;
  margin-top: 4rpx;
}

.status-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  margin-right: 8rpx;
}

.status-dot.ongoing {
  background: #52c41a;
}

.status-dot.finished {
  background: #999;
}

.status-dot.error {
  background: #ff4d4f;
}

.status-text {
  font-size: 22rpx;
  color: #999;
}

.header-progress {
  font-size: 22rpx;
  color: #666;
  margin-left: 16rpx;
}

/* ======== Message List ======== */
.msg-list {
  flex: 1;
  min-height: 0; /* 关键：约束 scroll-view 不得超出 flex 分配的高度，否则消息撑开把输入栏顶出屏幕 */
  /* 输入栏已回归文档流，无需再预留悬浮层空间；底部 30rpx 为内容呼吸空间 */
  padding: 24rpx 24rpx 30rpx;
  box-sizing: border-box;
}

/* System Message */
.msg-system {
  text-align: center;
  margin: 24rpx 0;
}

.msg-system-text {
  font-size: 24rpx;
  color: #999;
  background: #e8e8e8;
  padding: 8rpx 24rpx;
  border-radius: 20rpx;
  display: inline-block;
}

/* Message Row */
.msg-row {
  display: flex;
  margin-bottom: 28rpx;
  align-items: flex-start;
}

.msg-ai {
  justify-content: flex-start;
}

.msg-user {
  justify-content: flex-end;
}

/* Avatar */
.msg-avatar {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  font-weight: 600;
  flex-shrink: 0;
}

.ai-avatar {
  background: #eaf2ff;
  color: #1890ff;
  margin-right: 16rpx;
}

/* Message Content */
.msg-content {
  max-width: 560rpx;
}

.user-content {
  display: flex;
  justify-content: flex-end;
}

/* Message Bubble */
.msg-bubble {
  padding: 20rpx 24rpx;
  border-radius: 16rpx;
  font-size: 28rpx;
  line-height: 1.6;
  word-break: break-word;
}

.ai-bubble {
  background: #ffffff;
  color: #333;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
  border-top-left-radius: 4rpx;
}

.user-bubble {
  background: linear-gradient(135deg, #4CAF50, #43a047);
  color: #ffffff;
  border-top-right-radius: 4rpx;
}

.msg-text {
  white-space: pre-wrap;
}

.user-text {
  color: #ffffff;
}

/* ======== Message Sections ======== */
.msg-section {
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 2rpx solid #f0f0f0;
}

.section-label {
  font-size: 24rpx;
  font-weight: 600;
  color: #666;
  display: block;
  margin-bottom: 8rpx;
}

.section-text {
  font-size: 26rpx;
  color: #444;
  line-height: 1.6;
  white-space: pre-wrap;
}

/* Score Display */
.section-score {
  text-align: center;
  padding: 12rpx 0;
  border-top: 2rpx solid #f0f0f0;
}

.score-value {
  font-size: 56rpx;
  font-weight: 700;
  color: #f5a623;
}

.score-unit {
  font-size: 28rpx;
  font-weight: 400;
  color: #999;
}

/* Total Score */
.section-total-score {
  text-align: center;
  padding: 20rpx 0;
  background: linear-gradient(135deg, #fff8e1, #fff3cd);
  border-radius: 12rpx;
  margin-top: 16rpx;
  border-top: none;
}

.total-score-value {
  font-size: 72rpx;
  font-weight: 700;
  color: #e8a317;
}

/* Summary Section */
.section-summary {
  background: #f0f9f0;
  padding: 16rpx;
  border-radius: 12rpx;
  border-top: none;
  margin-top: 12rpx;
}

.section-analysis {
  background: #f0f4ff;
  padding: 16rpx;
  border-radius: 12rpx;
  border-top: none;
  margin-top: 12rpx;
}

/* Section Eval */
.section-eval {
  background: #fff8e1;
  padding: 16rpx;
  border-radius: 12rpx;
  border-top: none;
  margin-top: 12rpx;
}

/* Section Question */
.section-question {
  background: #e8f5e9;
  padding: 16rpx;
  border-radius: 12rpx;
  border-top: none;
  margin-top: 12rpx;
}

.section-label-question {
  font-size: 24rpx;
  font-weight: 600;
  color: #2e7d32;
  display: block;
  margin-bottom: 8rpx;
}

/* 题目标签行：左标签 + 右"复制"入口（PC 工具不支持长按选择文本） */
.question-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}

.question-head .section-label-question {
  margin-bottom: 0;
}

.copy-link {
  font-size: 24rpx;
  color: #576b95;
  padding: 4rpx 12rpx;
}

/* ======== Typing Indicator ======== */
.typing-indicator {
  display: flex;
  align-items: center;
  padding: 8rpx 0;
}

.typing-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #bbb;
  margin-right: 12rpx;
  animation: typingBounce 1.4s ease-in-out infinite;
}

.typing-dot:nth-child(2) {
  animation-delay: 0.2s;
}

.typing-dot:nth-child(3) {
  animation-delay: 0.4s;
  margin-right: 0;
}

@keyframes typingBounce {
  0%, 60%, 100% {
    transform: translateY(0);
    opacity: 0.4;
  }
  30% {
    transform: translateY(-12rpx);
    opacity: 1;
  }
}

/* ======== Input Bar ======== */
.input-bar {
  /* 回归文档流：不再悬浮，消除与原生组件 textarea 的渲染合成层（粘贴长文/换行错乱的根治方向） */
  background: #ffffff;
  padding: 16rpx 24rpx;
  display: flex;
  align-items: center;
  box-shadow: 0 -2rpx 8rpx rgba(0, 0, 0, 0.04);
  flex-shrink: 0;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
}

.input-bar-hidden {
  display: none;
}

/* auto-height 回归：输入栏已改文档流（无 fixed 悬浮层），高度变化不再引发渲染错乱；
   且 auto-height 让内容在 6 行内全展开、不触发 textarea 内部滚动（内部滚动+发送按钮合成错乱是复制长文 bug 的真正触发源）。
   min 3 行起步，max 6 行（288rpx），超出内部滚动 */
.msg-input {
  flex: 1;
  min-height: 176rpx;
  max-height: 288rpx;
  background: #f5f5f5;
  border-radius: 12rpx;
  padding: 16rpx 24rpx;
  font-size: 28rpx;
  color: #333;
  line-height: 42rpx;
  box-sizing: border-box;
}

.send-btn {
  width: 120rpx;
  height: 72rpx;
  line-height: 72rpx;
  text-align: center;
  background: #d5cece;
  color: #fff;
  border-radius: 36rpx;
  font-size: 28rpx;
  margin-left: 16rpx;
  flex-shrink: 0;
  border: none;
  padding: 0;
}

.send-btn::after {
  border: none;
}

.send-btn.send-active {
  background: #4CAF50;
}

/* ======== Finish Modal ======== */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 999;
}

.finish-card {
  width: 86%;
  max-height: 80vh;
  background: #ffffff;
  border-radius: 28rpx;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  box-shadow: 0 16rpx 48rpx rgba(0, 0, 0, 0.2);
}

.finish-header {
  text-align: center;
  padding: 48rpx 32rpx 24rpx;
  border-bottom: 2rpx solid #f0f0f0;
}

.finish-icon {
  font-size: 72rpx;
  display: block;
  margin-bottom: 16rpx;
}

.finish-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #333;
}

.finish-body {
  flex: 1;
  padding: 24rpx 32rpx;
  overflow-y: auto;
}

.finish-total-score {
  text-align: center;
  padding: 24rpx 0;
  margin-bottom: 20rpx;
  background: linear-gradient(135deg, #fff8e1, #fff3cd);
  border-radius: 16rpx;
}

.finish-score-label {
  font-size: 28rpx;
  color: #666;
  display: block;
  margin-bottom: 8rpx;
}

.finish-score-value {
  font-size: 96rpx;
  font-weight: 700;
  color: #e8a317;
}

.finish-score-unit {
  font-size: 32rpx;
  color: #999;
  margin-left: 4rpx;
}

.finish-section {
  margin-bottom: 20rpx;
  padding: 16rpx;
  background: #f7f9fb;
  border-radius: 12rpx;
}

.finish-section-label {
  font-size: 24rpx;
  font-weight: 600;
  color: #666;
  display: block;
  margin-bottom: 8rpx;
}

.finish-section-text {
  font-size: 26rpx;
  color: #444;
  line-height: 1.6;
  white-space: pre-wrap;
}

.finish-actions {
  padding: 20rpx 32rpx 32rpx;
  border-top: 2rpx solid #f0f0f0;
}

.finish-btn {
  width: 100%;
  height: 80rpx;
  line-height: 80rpx;
  border-radius: 40rpx;
  font-size: 28rpx;
  text-align: center;
  margin-bottom: 16rpx;
  border: none;
}

.finish-btn::after {
  border: none;
}

.finish-btn.primary {
  background: #4CAF50;
  color: #ffffff;
}

.finish-btn.outline {
  background: transparent;
  color: #666;
  border: 2rpx solid #ddd;
}

/* ======== Error Retry ======== */
.error-bar {
  text-align: center;
  padding: 16rpx;
  margin: 8rpx 0;
}

.error-text {
  font-size: 24rpx;
  color: #ff4d4f;
  display: block;
  margin-bottom: 8rpx;
}

.retry-link {
  font-size: 24rpx;
  color: #1890ff;
  text-decoration: underline;
}

/* ======== Wait Timer ======== */
.wait-timer {
  font-size: 22rpx;
  color: #999;
  text-align: center;
  margin-top: 8rpx;
}

/* ======== Retry Bar ======== */
.retry-bar {
  /* 回归文档流：wxml 中位于输入栏之前，自然显示在输入栏上方 */
  background: #fff3f3;
  padding: 16rpx 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-shrink: 0;
  border-top: 2rpx solid #ffccc7;
}

.retry-error {
  font-size: 24rpx;
  color: #ff4d4f;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  margin-right: 16rpx;
}

.retry-btn {
  width: 120rpx;
  height: 56rpx;
  line-height: 56rpx;
  text-align: center;
  background: #ff4d4f;
  color: #fff;
  border-radius: 28rpx;
  font-size: 24rpx;
  flex-shrink: 0;
  border: none;
  padding: 0;
}

.retry-btn::after {
  border: none;
}
