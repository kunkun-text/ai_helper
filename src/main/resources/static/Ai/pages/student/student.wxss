.page {
  /* 结构性修复：整页固定视口高 + 内部 flex 滚动，header/tab-bar 回归文档流，
     消除 fixed 悬浮层在页面切换后的渲染残留（残影叠到答辩页的根因） */
  height: 100vh;
  overflow: hidden;
  background: #f4f6f9;
  display: flex;
  flex-direction: column;
}

.header {
  height: 120rpx;
  background-color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative; /* header-title 为 absolute 定位，需保留定位祖先 */
  flex-shrink: 0;
  box-shadow: 0 2rpx 8rpx rgba(13, 1, 1, 0.1);
}

.header-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333333;
  position: absolute;
  bottom: 10rpx;
  left: 50%;
  transform: translateX(-50%);
  white-space: nowrap;
}

.content {
  flex: 1;
  min-height: 0; /* 关键：约束 scroll-view 不得超出 flex 分配的高度，否则内容撑开把 tab-bar 顶出屏幕 */
  /* header/tab-bar 已回归文档流，无需再预留悬浮层空间 */
  padding: 24rpx 24rpx 30rpx;
  box-sizing: border-box;
}

.section-title {
  font-size: 40rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 32rpx;
}

.welcome-card {
  display: flex;
  align-items: center;
  padding: 28rpx;
  border-radius: 28rpx;
  margin-bottom: 28rpx;
  color: #ffffff;
}

.gradient-blue {
  background: linear-gradient(90deg, #5aa5ff 0%, #4f8ef7 100%);
  box-shadow: 0 12rpx 24rpx rgba(79, 142, 247, 0.25);
}

.avatar-circle {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
}

.avatar-circle.large {
  width: 140rpx;
  height: 140rpx;
}

.avatar-text {
  font-size: 36rpx;
  font-weight: 600;
  color: #4f8ef7;
}

.welcome-info {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.welcome-title {
  font-size: 32rpx;
  font-weight: 600;
}

.welcome-subtitle {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.9);
}

.card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 20rpx rgba(0, 0, 0, 0.06);
}

.card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.card-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333333;
}

.card-block {
  margin-top: 16rpx;
  margin-bottom: 16rpx;
}

.label {
  font-size: 24rpx;
  color: #666666;
}

.value {
  font-size: 28rpx;
  color: #333333;
  margin-top: 10rpx;
  display: block;
  background: #f7f9fb;
  padding: 16rpx 20rpx;
  border-radius: 12rpx;
  width: 100%;
  box-sizing: border-box;
  word-break: break-word; /* 确保长单词能正确换行 */
  white-space: pre-wrap; /* 保留换行符并允许自动换行 */
  max-width: 650rpx; /* 限制最大宽度，防止超出弹窗容器 */
}

.row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 10rpx;
}

.badge-icon {
  padding: 8rpx 16rpx;
  background: #eaf2ff;
  color: #4f8ef7;
  border-radius: 18rpx;
  font-size: 20rpx;
}

.muted {
  font-size: 24rpx;
  color: #777777;
}

.primary-btn {
  margin-top: 20rpx;
  width: 100%;
  height: 80rpx;
  background: #4caf50;
  color: #ffffff;
  border-radius: 16rpx;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
}

.primary-btn::after {
  border: none;
}

.outline-btn {
  margin-top: 20rpx;
  background: transparent;
  border: 2rpx solid #1890ff;
  color: #1890ff;
  padding: 12rpx 32rpx;
  border-radius: 8rpx;
  font-size: 24rpx;
}

.outline-btn::after {
  border: none;
}

.link-sm {
  font-size: 22rpx;
  color: #1890ff;
  margin-left: 12rpx;
}

.upload-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx 0;
  text-align: center;
}

.upload-icon {
  width: 80rpx;
  height: 80rpx;
  background: #f0f2f5;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 20rpx;
  font-size: 28rpx;
  color: #666;
}

/* 新增的上传状态样式 */
.upload-status {
  margin-top: 20rpx;
  width: 100%;
  padding: 0 40rpx;
}

.progress-container {
  display: flex;
  align-items: center;
  width: 100%;
  margin-bottom: 12rpx;
}

.progress-text {
  /* 已把原先第二处重复定义的实际生效值合并到这里（后写会静默覆盖前写） */
  margin-left: 16rpx;
  font-size: 24rpx;
  color: #1890ff;
  min-width: 40rpx;
}

.status-text {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #666666;
  text-align: center;
}

/* 上传成功/失败的文字提示已改由顶部提示条（.top-banner）承担。
   原先的 .upload-success / .success-text / .error-text 三个类已无任何引用，故删除；
   下方只保留仍在使用中的 .upload-error（"重试"按钮的容器）与 .retry-btn，
   并已把重复定义的两套取值合并为一套（原先后一套会静默覆盖前一套）。 */
.upload-error {
  padding: 20rpx;
  margin-top: 16rpx;
  border: 2rpx solid #ffccc7;
  border-radius: 8rpx;
  background: #fff2f0;
  text-align: center;
}

.retry-btn {
  padding: 8rpx 20rpx;
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #ffffff;
  background: #f44336;
  border-radius: 8rpx;
}

.retry-btn::after {
  border: none;
}

/* 回答详情样式 */
.answer-item {
  margin-bottom: 24rpx;
  padding-bottom: 24rpx;
  border-bottom: 2rpx solid #f0f0f0;
}

.answer-item:last-child {
  border-bottom: none;
  margin-bottom: 0;
  padding-bottom: 0;
}

.answer-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.answer-type {
  font-size: 24rpx;
  font-weight: 600;
  padding: 6rpx 12rpx;
  border-radius: 8rpx;
}

.answer-type.teacher {
  background: #eaf2ff;
  color: #1890ff;
}

.answer-type.ai {
  background: #e8f5e9;
  color: #43a047;
}

.answer-score {
  font-size: 24rpx;
  color: #4caf50;
  font-weight: 500;
}

.answer-separator {
  height: 2rpx;
  background: #f0f0f0;
  margin: 16rpx 0;
}

.record-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.record-list-container {
  max-height: 300rpx;
}

.record-list-full {
  height: calc(100vh - 200rpx);
}

.record-item {
  display: flex;
  align-items: flex-start;
  padding: 20rpx 0;
  border-bottom: 2rpx solid #f0f0f0;
}

.record-item:last-child {
  border-bottom: none;
}

.record-avatar {
  width: 60rpx;
  height: 60rpx;
  background: #eaf2ff;
  color: #1890ff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 600;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.record-body {
  flex: 1;
  min-width: 0;
}

.record-name {
  font-size: 26rpx;
  font-weight: 600;
  color: #333333;
  display: block;
  margin-bottom: 6rpx;
}

.record-topic {
  font-size: 24rpx;
  color: #666666;
  display: block;
  margin-bottom: 6rpx;
  word-break: break-word;
}

.record-date {
  font-size: 22rpx;
  color: #999999;
  display: block;
}

.record-score {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  min-width: 120rpx;
  text-align: right;
}

.score {
  font-size: 28rpx;
  font-weight: 600;
  color: #4caf50;
  margin-bottom: 8rpx;
}

.link {
  font-size: 24rpx;
  color: #007bff;
}


.profile-avatar {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.form-item {
  margin-bottom: 20rpx;
}

.form-item:last-child {
  margin-bottom: 0;
}

.label {
  display: block;
  font-size: 24rpx;
  color: #666666;
  margin-bottom: 8rpx;
  font-weight: 500;
}

.value {
  display: block;
  font-size: 26rpx;
  color: #333333;
  line-height: 1.5;
  word-break: break-word;
}

.input {
  margin-top: 10rpx;
  padding: 16rpx 20rpx;
  background: #f7f9fb;
  border-radius: 12rpx;
  font-size: 26rpx;
}

.cell {
  padding: 22rpx 8rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 2rpx solid #f0f0f0;
}

.cell:last-child {
  border-bottom: none;
}

.cell-text {
  font-size: 26rpx;
  color: #333333;
}

.cell-arrow {
  color: #bbbbbb;
}

.cell.danger .cell-text {
  color: #f44336;
}

.tab-bar {
  /* 回归文档流：作为 .page 的最后一个 flex 子项贴底 */
  background: #ffffff;
  border-top: 2rpx solid #e8e8e8;
  display: flex;
  padding: 16rpx 0;
  flex-shrink: 0;
}

.tab-item {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
}

.tab-text {
  font-size: 24rpx;
  color: #888888;
}

.tab-item.active .tab-text {
  color: #008cba;
  font-weight: 600;
}

/* ===== 弹层（答辩详情 / 回答详情 / 题目描述 / 所有答辩题目 共用） =====
   结构前提：弹层节点必须放在 .content 滚动区之外（见 student.wxml 注释）。
   左右留白统一由 .modal-mask 的 padding 承担，卡片 width:100% —— 结构上不可能横向溢出。 */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 40rpx; /* 两侧留白（同时给阴影留出余量） */
  box-sizing: border-box;
  z-index: 999;
}

.modal-card {
  width: 100%;
  max-width: 670rpx; /* 750rpx - 两侧各 40rpx */
  margin: 0;
  padding: 0;
  background: #ffffff;
  border-radius: 24rpx;
  box-shadow: 0 16rpx 36rpx rgba(0, 0, 0, 0.15);
  max-height: 86vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  box-sizing: border-box;
}

.modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-shrink: 0;
  padding: 32rpx 28rpx 20rpx;
  background: #ffffff;
  border-bottom: 1rpx solid #f0f0f0;
}

.modal-title {
  flex: 1;
  font-size: 36rpx;
  font-weight: 600;
  color: #333333;
}

.modal-close {
  flex-shrink: 0;
  margin-left: 20rpx;
  padding: 8rpx 12rpx;
  font-size: 48rpx;
  line-height: 1;
  color: #999999;
  text-align: center;
}

.modal-body {
  flex: 1;
  min-height: 0; /* 允许在 max-height 内收缩，否则内容会把卡片撑破 */
  overflow-y: auto;
  overflow-x: hidden;
  padding: 20rpx 28rpx 28rpx;
  box-sizing: border-box;
}

/* ===== 附件上传：题目选择器 ===== */
.topic-picker-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 28rpx;
}

.picker-label {
  flex-shrink: 0;
  font-size: 28rpx;
  color: #333333;
}

.picker-value {
  display: flex;
  align-items: center;
  max-width: 420rpx;
}

.picker-text {
  font-size: 28rpx;
  color: #1890ff;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.picker-arrow {
  margin-left: 8rpx;
  font-size: 32rpx;
  color: #bbbbbb;
}

/* ===== 附件上传：预览 / 下载 / 删除按钮行 ===== */
.media-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 16rpx;
}

.mini-btn {
  flex: 1;
  height: 64rpx;
  line-height: 64rpx;
  padding: 0;
  font-size: 26rpx;
  color: #1890ff;
  background: #f2f8ff;
  border: 1rpx solid #d6e8ff;
  border-radius: 10rpx;
}

.mini-btn.danger {
  color: #e64340;
  background: #fff2f1;
  border-color: #ffd9d7;
}

.mini-btn::after {
  border: none;
}

/* ===== 提示条（上传成功 / 失败），5 秒后自动消失 =====
   位置：header 下方的文档流内，不是 fixed 悬浮层。
   这样既不会被状态栏/刘海屏遮挡，也不会出现"先看到一片白、再突然变绿"的观感。 */
.top-banner {
  flex-shrink: 0; /* 作为 .page 的 flex 子项，不被上方内容压缩 */
  display: flex;
  align-items: center;
  padding: 20rpx 32rpx;
  box-sizing: border-box;
  color: #ffffff;
  animation: banner-in 0.26s ease;
}

@keyframes banner-in {
  from {
    opacity: 0;
    transform: translateY(-100%);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.banner-success {
  background: #07c160; /* 微信成功绿 */
}

.banner-error {
  background: #fa5151; /* 微信错误红 */
}

.banner-icon {
  flex-shrink: 0;
  width: 34rpx;
  height: 34rpx;
  margin-right: 14rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.28);
  font-size: 22rpx;
  font-weight: 700;
  line-height: 34rpx;
  text-align: center;
}

.banner-text {
  flex: 1;
  font-size: 26rpx; /* 与页面正文同号，长文案可换行完整显示 */
  line-height: 38rpx;
  word-break: break-all;
}

/* 滚动条样式 */
.modal-body::-webkit-scrollbar {
  width: 6rpx;
}

.modal-body::-webkit-scrollbar-track {
  background: #f1f1f1;
  border-radius: 3rpx;
}

.modal-body::-webkit-scrollbar-thumb {
  background: #ccc;
  border-radius: 3rpx;
}

.modal-body::-webkit-scrollbar-thumb:hover {
  background: #aaa;
}

.feedback {
  color: #5a5a5a;
  background: #f7f9fb;
  padding: 12rpx 16rpx;
  border-radius: 12rpx;
  font-size: 24rpx;
}

.long-text-scroll {
  background: #f7f9fb;
  padding: 12rpx 16rpx;
  border-radius: 12rpx;
  max-height: 200rpx; /* 限制最大高度，防止内容过多时占用整个弹窗 */
  overflow-y: auto; /* 启用垂直滚动 */
  width: 100%;
  box-sizing: border-box;
  max-width: 650rpx; /* 同样限制最大宽度 */
}

/* 优化值显示样式，确保内容不会被截断 */
.value {
  font-size: 28rpx;
  color: #333333;
  margin-top: 10rpx;
  display: block;
  background: #f7f9fb;
  padding: 16rpx 20rpx;
  border-radius: 12rpx;
  width: 100%;
  box-sizing: border-box;
  word-break: break-word; /* 确保长单词能正确换行 */
  white-space: pre-wrap; /* 保留换行符并允许自动换行 */
}

.video-container {
  margin-top: 8rpx;
}

/* 文件信息样式 */
.file-info {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 16rpx;
  padding: 0 24rpx;
}

.file-size {
  font-size: 24rpx;
  color: #666;
}

.cancel-btn {
  font-size: 24rpx;
  color: #ff4d4f;
  background: transparent;
  border: 1px solid #ff4d4f;
  border-radius: 8rpx;
  padding: 4rpx 16rpx;
  line-height: 1;
}

.cancel-btn::after {
  border: none;
}

/* 进度条容器 */
