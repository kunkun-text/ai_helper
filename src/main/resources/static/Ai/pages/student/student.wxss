.page {
  min-height: 100vh;
  background: #f4f6f9;
  display: flex;
  flex-direction: column;
}

.header {
  height: 120rpx;
  background-color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
}

.header-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333333;
  position: absolute;
  bottom: 10rpx;
  left: 50%;
  transform: translateX(-50%);
  white-space: nowrap;
}

.content {
  flex: 1;
  padding: 24rpx 24rpx 140rpx;
  box-sizing: border-box;
}

.section-title {
  font-size: 40rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 32rpx;
}

.welcome-card {
  display: flex;
  align-items: center;
  padding: 28rpx;
  border-radius: 28rpx;
  margin-bottom: 28rpx;
  color: #ffffff;
}

.gradient-blue {
  background: linear-gradient(90deg, #5aa5ff 0%, #4f8ef7 100%);
  box-shadow: 0 12rpx 24rpx rgba(79, 142, 247, 0.25);
}

.avatar-circle {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
}

.avatar-circle.large {
  width: 140rpx;
  height: 140rpx;
}

.avatar-text {
  font-size: 36rpx;
  font-weight: 600;
  color: #4f8ef7;
}

.welcome-info {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.welcome-title {
  font-size: 32rpx;
  font-weight: 600;
}

.welcome-subtitle {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.9);
}

.card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 20rpx rgba(0, 0, 0, 0.06);
}

.card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.card-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333333;
}

.card-block {
  margin-top: 16rpx;
  margin-bottom: 16rpx;
}

.label {
  font-size: 24rpx;
  color: #666666;
}

.value {
  font-size: 28rpx;
  color: #333333;
  margin-top: 10rpx;
  display: block;
}

.row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 10rpx;
}

.badge-icon {
  padding: 8rpx 16rpx;
  background: #eaf2ff;
  color: #4f8ef7;
  border-radius: 18rpx;
  font-size: 20rpx;
}

.muted {
  font-size: 24rpx;
  color: #777777;
}

.primary-btn {
  margin-top: 20rpx;
  width: 100%;
  height: 80rpx;
  background: #4caf50;
  color: #ffffff;
  border-radius: 16rpx;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.primary-btn::after {
  border: none;
}

.outline-btn {
  margin-top: 20rpx;
  background: transparent;
  border: 2rpx solid #1890ff;
  color: #1890ff;
  padding: 12rpx 32rpx;
  border-radius: 8rpx;
  font-size: 24rpx;
}

.upload-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx 0;
  text-align: center;
}

.upload-icon {
  width: 80rpx;
  height: 80rpx;
  background: #f0f2f5;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 20rpx;
  font-size: 28rpx;
  color: #666;
}

/* 新增的上传状态样式 */
.upload-status {
  margin-top: 20rpx;
  width: 100%;
  padding: 0 40rpx;
}

.progress-container {
  position: relative;
  margin-bottom: 10rpx;
}

.progress-text {
  position: absolute;
  right: 0;
  top: 50%;
  transform: translateY(-50%);
  font-size: 20rpx;
  color: #666;
}

.status-text {
  font-size: 22rpx;
  color: #666;
  text-align: center;
  margin-top: 10rpx;
}

.upload-success, .upload-error {
  margin-top: 20rpx;
  padding: 20rpx;
  border-radius: 8rpx;
  text-align: center;
}

.upload-success {
  background: #f6ffed;
  border: 2rpx solid #b7eb8f;
}

.upload-error {
  background: #fff2f0;
  border: 2rpx solid #ffccc7;
}

.success-text {
  color: #52c41a;
  font-size: 24rpx;
}

.error-text {
  color: #ff4d4f;
  font-size: 24rpx;
}

.retry-btn {
  margin-top: 10rpx;
  background: #ff4d4f;
  color: white;
  border: none;
  padding: 10rpx 20rpx;
  border-radius: 6rpx;
  font-size: 22rpx;
}

.record-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.record-list-container {
  max-height: 300rpx;
}

.record-list-full {
  height: calc(100vh - 200rpx);
}

.record-item {
  background: #f7f9fb;
  border-radius: 20rpx;
  padding: 20rpx;
  display: flex;
  gap: 16rpx;
}

.record-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: #eaf2ff;
  color: #008cba;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 600;
  font-size: 24rpx;
}

.record-body {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.record-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #333333;
}

.record-topic {
  font-size: 24rpx;
  color: #666666;
}

.record-date {
  font-size: 22rpx;
  color: #888888;
}

.record-score {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 8rpx;
}

.score {
  font-size: 34rpx;
  font-weight: 600;
  color: #4caf50;
}

.link {
  font-size: 24rpx;
  color: #007bff;
}

.link-sm {
  font-size: 22rpx;
  color: #007bff;
}

.profile-avatar {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.form-item {
  margin-bottom: 20rpx;
  display: flex;
  flex-direction: column;
}

.input {
  margin-top: 10rpx;
  padding: 16rpx 20rpx;
  background: #f7f9fb;
  border-radius: 12rpx;
  font-size: 26rpx;
}

.cell {
  padding: 22rpx 8rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 2rpx solid #f0f0f0;
}

.cell:last-child {
  border-bottom: none;
}

.cell-text {
  font-size: 26rpx;
  color: #333333;
}

.cell-arrow {
  color: #bbbbbb;
}

.cell.danger .cell-text {
  color: #f44336;
}

.tab-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #ffffff;
  border-top: 2rpx solid #e8e8e8;
  display: flex;
  padding: 16rpx 0;
}

.tab-item {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
}

.tab-text {
  font-size: 24rpx;
  color: #888888;
}

.tab-item.active .tab-text {
  color: #008cba;
  font-weight: 600;
}

.modal-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.4);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 99;
}

.modal-card {
  width: 82%;
  background: #ffffff;
  border-radius: 20rpx;
  padding: 24rpx;
}

.modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.modal-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333333;
}

.modal-close {
  font-size: 32rpx;
  color: #999999;
}

.feedback {
  background: #f7f9fb;
  padding: 16rpx;
  border-radius: 12rpx;
  font-size: 24rpx;
  color: #666666;
  line-height: 1.5;
}
