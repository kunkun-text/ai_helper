.page {
  min-height: 100vh;
  background: #f4f6f9;
  display: flex;
  flex-direction: column;
}

.header {
  height: 120rpx;
  background-color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
  box-shadow: 0 2rpx 8rpx rgba(13, 1, 1, 0.1);
}

.header-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333333;
  position: absolute;
  bottom: 10rpx;
  left: 50%;
  transform: translateX(-50%);
  white-space: nowrap;
}

.content {
  flex: 1;
  padding: 140rpx 24rpx 140rpx;
  box-sizing: border-box;
}

.section-title {
  font-size: 40rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 32rpx;
}

.welcome-card {
  display: flex;
  align-items: center;
  padding: 28rpx;
  border-radius: 28rpx;
  margin-bottom: 28rpx;
  color: #ffffff;
}

.gradient-blue {
  background: linear-gradient(90deg, #5aa5ff 0%, #4f8ef7 100%);
  box-shadow: 0 12rpx 24rpx rgba(79, 142, 247, 0.25);
}

.avatar-circle {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
}

.avatar-circle.large {
  width: 140rpx;
  height: 140rpx;
}

.avatar-text {
  font-size: 36rpx;
  font-weight: 600;
  color: #4f8ef7;
}

.welcome-info {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.welcome-title {
  font-size: 32rpx;
  font-weight: 600;
}

.welcome-subtitle {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.9);
}

.card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 20rpx rgba(0, 0, 0, 0.06);
}

.card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.card-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333333;
}

.card-block {
  margin-top: 16rpx;
  margin-bottom: 16rpx;
}

.label {
  font-size: 24rpx;
  color: #666666;
}

.value {
  font-size: 28rpx;
  color: #333333;
  margin-top: 10rpx;
  display: block;
  background: #f7f9fb;
  padding: 16rpx 20rpx;
  border-radius: 12rpx;
  width: 100%;
  box-sizing: border-box;
  word-break: break-word; /* 确保长单词能正确换行 */
  white-space: pre-wrap; /* 保留换行符并允许自动换行 */
  max-width: 650rpx; /* 限制最大宽度，防止超出弹窗容器 */
}

.row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 10rpx;
}

.badge-icon {
  padding: 8rpx 16rpx;
  background: #eaf2ff;
  color: #4f8ef7;
  border-radius: 18rpx;
  font-size: 20rpx;
}

.muted {
  font-size: 24rpx;
  color: #777777;
}

.primary-btn {
  margin-top: 20rpx;
  width: 100%;
  height: 80rpx;
  background: #4caf50;
  color: #ffffff;
  border-radius: 16rpx;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
}

.primary-btn::after {
  border: none;
}

.outline-btn {
  margin-top: 20rpx;
  background: transparent;
  border: 2rpx solid #1890ff;
  color: #1890ff;
  padding: 12rpx 32rpx;
  border-radius: 8rpx;
  font-size: 24rpx;
}

.outline-btn::after {
  border: none;
}

.link-sm {
  font-size: 22rpx;
  color: #1890ff;
  margin-left: 12rpx;
}

.upload-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx 0;
  text-align: center;
}

.upload-icon {
  width: 80rpx;
  height: 80rpx;
  background: #f0f2f5;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 20rpx;
  font-size: 28rpx;
  color: #666;
}

/* 新增的上传状态样式 */
.upload-status {
  margin-top: 20rpx;
  width: 100%;
  padding: 0 40rpx;
}

.progress-container {
  display: flex;
  align-items: center;
  width: 100%;
  margin-bottom: 12rpx;
}

.progress-text {
  font-size: 22rpx;
  color: #666666;
  margin-left: 12rpx;
  min-width: 40rpx;
}

.status-text {
  font-size: 22rpx;
  color: #666666;
  text-align: center;
  margin-top: 8rpx;
}

.upload-success, .upload-error {
  margin-top: 20rpx;
  padding: 20rpx;
  border-radius: 8rpx;
  text-align: center;
}

.upload-success {
  background: #f6ffed;
  border: 2rpx solid #b7eb8f;
}

.upload-error {
  background: #fff2f0;
  border: 2rpx solid #ffccc7;
}

.success-text {
  color: #52c41a;
  font-size: 24rpx;
}

.error-text {
  color: #ff4d4f;
  font-size: 24rpx;
}

.retry-btn {
  margin-top: 12rpx;
  background: #f44336;
  color: #ffffff;
  border-radius: 8rpx;
  font-size: 22rpx;
  padding: 8rpx 20rpx;
}

.retry-btn::after {
  border: none;
}

/* 回答详情样式 */
.answer-item {
  margin-bottom: 24rpx;
  padding-bottom: 24rpx;
  border-bottom: 2rpx solid #f0f0f0;
}

.answer-item:last-child {
  border-bottom: none;
  margin-bottom: 0;
  padding-bottom: 0;
}

.answer-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.answer-type {
  font-size: 24rpx;
  font-weight: 600;
  padding: 6rpx 12rpx;
  border-radius: 8rpx;
}

.answer-type.teacher {
  background: #eaf2ff;
  color: #1890ff;
}

.answer-type.ai {
  background: #e8f5e9;
  color: #43a047;
}

.answer-score {
  font-size: 24rpx;
  color: #4caf50;
  font-weight: 500;
}

.answer-separator {
  height: 2rpx;
  background: #f0f0f0;
  margin: 16rpx 0;
}

.record-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.record-list-container {
  max-height: 300rpx;
}

.record-list-full {
  height: calc(100vh - 200rpx);
}

.record-item {
  display: flex;
  align-items: flex-start;
  padding: 20rpx 0;
  border-bottom: 2rpx solid #f0f0f0;
}

.record-item:last-child {
  border-bottom: none;
}

.record-avatar {
  width: 60rpx;
  height: 60rpx;
  background: #eaf2ff;
  color: #1890ff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 600;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.record-body {
  flex: 1;
  min-width: 0;
}

.record-name {
  font-size: 26rpx;
  font-weight: 600;
  color: #333333;
  display: block;
  margin-bottom: 6rpx;
}

.record-topic {
  font-size: 24rpx;
  color: #666666;
  display: block;
  margin-bottom: 6rpx;
  word-break: break-word;
}

.record-date {
  font-size: 22rpx;
  color: #999999;
  display: block;
}

.record-score {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  min-width: 120rpx;
  text-align: right;
}

.score {
  font-size: 28rpx;
  font-weight: 600;
  color: #4caf50;
  margin-bottom: 8rpx;
}

.link {
  font-size: 24rpx;
  color: #007bff;
}


.profile-avatar {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.form-item {
  margin-bottom: 20rpx;
}

.form-item:last-child {
  margin-bottom: 0;
}

.label {
  display: block;
  font-size: 24rpx;
  color: #666666;
  margin-bottom: 8rpx;
  font-weight: 500;
}

.value {
  display: block;
  font-size: 26rpx;
  color: #333333;
  line-height: 1.5;
  word-break: break-word;
}

.input {
  margin-top: 10rpx;
  padding: 16rpx 20rpx;
  background: #f7f9fb;
  border-radius: 12rpx;
  font-size: 26rpx;
}

.cell {
  padding: 22rpx 8rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 2rpx solid #f0f0f0;
}

.cell:last-child {
  border-bottom: none;
}

.cell-text {
  font-size: 26rpx;
  color: #333333;
}

.cell-arrow {
  color: #bbbbbb;
}

.cell.danger .cell-text {
  color: #f44336;
}

.tab-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #ffffff;
  border-top: 2rpx solid #e8e8e8;
  display: flex;
  padding: 16rpx 0;
}

.tab-item {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
}

.tab-text {
  font-size: 24rpx;
  color: #888888;
}

.tab-item.active .tab-text {
  color: #008cba;
  font-weight: 600;
}

.modal-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 999;
}

.modal-card {
  width: 86%;
  background: #ffffff;
  border-radius: 24rpx;
  padding: 0;
  max-height: 85vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  box-shadow: 0 12rpx 32rpx rgba(0, 0, 0, 0.15);
}

.modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 0;
  padding: 28rpx 28rpx 20rpx;
  background: #ffffff;
  position: sticky;
  top: 0;
  z-index: 10;
  border-bottom: 2rpx solid #f0f0f0;
}

.modal-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #333333;
  flex: 1;
}

.modal-close {
  font-size: 36rpx;
  color: #888888;
  margin-left: 20rpx;
  width: 40rpx;
  text-align: center;
  font-weight: 300;
}

.modal-body {
  flex: 1;
  overflow-y: auto;
  max-height: calc(90vh - 120rpx);
  padding: 20rpx 28rpx 28rpx;
}

/* 滚动条样式 */
.modal-body::-webkit-scrollbar {
  width: 6rpx;
}

.modal-body::-webkit-scrollbar-track {
  background: #f1f1f1;
  border-radius: 3rpx;
}

.modal-body::-webkit-scrollbar-thumb {
  background: #ccc;
  border-radius: 3rpx;
}

.modal-body::-webkit-scrollbar-thumb:hover {
  background: #aaa;
}

.feedback {
  color: #5a5a5a;
  background: #f7f9fb;
  padding: 12rpx 16rpx;
  border-radius: 12rpx;
  font-size: 24rpx;
}

.long-text-scroll {
  background: #f7f9fb;
  padding: 12rpx 16rpx;
  border-radius: 12rpx;
  max-height: 200rpx; /* 限制最大高度，防止内容过多时占用整个弹窗 */
  overflow-y: auto; /* 启用垂直滚动 */
  width: 100%;
  box-sizing: border-box;
  max-width: 650rpx; /* 同样限制最大宽度 */
}

/* 优化值显示样式，确保内容不会被截断 */
.value {
  font-size: 28rpx;
  color: #333333;
  margin-top: 10rpx;
  display: block;
  background: #f7f9fb;
  padding: 16rpx 20rpx;
  border-radius: 12rpx;
  width: 100%;
  box-sizing: border-box;
  word-break: break-word; /* 确保长单词能正确换行 */
  white-space: pre-wrap; /* 保留换行符并允许自动换行 */
}

.video-container {
  margin-top: 8rpx;
}

/* 文件信息样式 */
.file-info {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 16rpx;
  padding: 0 24rpx;
}

.file-size {
  font-size: 24rpx;
  color: #666;
}

.cancel-btn {
  font-size: 24rpx;
  color: #ff4d4f;
  background: transparent;
  border: 1px solid #ff4d4f;
  border-radius: 8rpx;
  padding: 4rpx 16rpx;
  line-height: 1;
}

.cancel-btn::after {
  border: none;
}

/* 进度条容器 */
.progress-container {
  display: flex;
  align-items: center;
  width: 100%;
  margin-bottom: 12rpx;
}

.progress-text {
  margin-left: 16rpx;
  font-size: 24rpx;
  color: #1890ff;
  min-width: 40rpx;
}

/* 状态文本 */
.status-text {
  font-size: 24rpx;
  color: #666;
  text-align: center;
}

/* 上传成功状态 */
.upload-success {
  text-align: center;
  margin-top: 16rpx;
}

.success-text {
  color: #52c41a;
  font-size: 28rpx;
  font-weight: bold;
}

/* 上传失败状态 */
.upload-error {
  text-align: center;
  margin-top: 16rpx;
}

.error-text {
  color: #ff4d4f;
  font-size: 28rpx;
  font-weight: bold;
}

.retry-btn {
  margin-top: 16rpx;
  font-size: 24rpx;
}
