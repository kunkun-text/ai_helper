<view class="page">
  <view class="header">
    <text class="header-title">课程考核AI答辩辅助</text>
  </view>

  <!-- 提示条：上传成功/失败在标题栏下方提示，5 秒后自动消失。
       刻意放在文档流里而不是 fixed 悬浮层：既不会被状态栏/刘海屏遮挡，
       也不会出现"只看到一片白、突然变绿"的观感。 -->
  <view wx:if="{{banner.visible}}" class="top-banner {{banner.type === 'error' ? 'banner-error' : 'banner-success'}}">
    <text class="banner-icon">{{banner.type === 'error' ? '!' : '✓'}}</text>
    <text class="banner-text">{{banner.text}}</text>
  </view>

  <scroll-view class="content" scroll-y>
    <view wx:if="{{activeTab === 'home'}}">
      <view class="welcome-card gradient-blue">
        <view class="avatar-circle">
          <text class="avatar-text">S</text>
        </view>
        <view class="welcome-info">
          <text class="welcome-title">欢迎，{{user.name}}同学</text>
          <text class="welcome-subtitle">备考评审你的答辩视频帮助学习</text>
        </view>
      </view>

      <view class="card">
        <text class="card-title">下一轮答辩</text>
        <view class="card-block">
          <text class="label">答辩题目</text>
          <text class="value">{{nextDefense.topic}}</text>
        </view>
        <view class="row">
          <view class="badge-icon">时间</view>
          <text class="muted">答辩时间：{{nextDefense.date}}</text>
        </view>
        <button class="primary-btn" bindtap="startDefense">开始答辩</button>
        <view style="margin-top: 16rpx; text-align: center;">
          <text class="link" bindtap="showTopicDescription">查看题目描述</text>
          <text class="muted" style="margin: 0 8rpx;">|</text>
          <text class="link" bindtap="showAllTopicsModal">查看所有答辩题目</text>
        </view>
      </view>

      <!-- 附件所属答辩题目：视频与报告共用（原先两处都硬编码取题目列表第一项，会挂错题目） -->
      <view class="card topic-picker-card">
        <text class="picker-label">附件所属题目</text>
        <picker mode="selector" range="{{defenseTopics}}" range-key="topicName"
                value="{{uploadTopicIndex}}" bindchange="onUploadTopicChange">
          <view class="picker-value">
            <text class="picker-text">{{uploadTopicName || '请选择答辩题目'}}</text>
            <text class="picker-arrow">›</text>
          </view>
        </picker>
      </view>

      <view class="card">
        <view class="upload-box">
          <view class="upload-icon">视频</view>
          <text class="muted">上传答辩视频</text>
          
          <!-- 根据是否已上传显示不同按钮文本 -->
          <button class="outline-btn" bindtap="selectVideo" disabled="{{isUploading}}">
            {{hasUploadedVideo ? '重新上传视频' : '选择视频，开始上传'}}
          </button>
          
          <!-- 文件信息显示 -->
          <view wx:if="{{currentFileSizeReadable}}" class="file-info">
            <text class="file-size">文件大小：{{currentFileSizeReadable}}</text>
            <button class="cancel-btn" wx:if="{{isUploading}}" bindtap="cancelUpload">取消上传</button>
          </view>
          
          <!-- 上传状态显示（进度与阶段文案均由通用上传模块回调驱动） -->
          <view wx:if="{{uploadStatus === 'init' || uploadStatus === 'uploading' || uploadStatus === 'merging'}}" class="upload-status">
            <view class="progress-container">
              <progress 
                percent="{{uploadProgress}}" 
                stroke-width="4" 
                active-color="#1890ff" 
                background-color="#f5f5f5"
                active="{{true}}"
              />
              <text class="progress-text">{{uploadProgress}}%</text>
            </view>
            <text class="status-text">{{uploadStageText}}</text>
          </view>
          
          <!-- 已上传时提供预览 / 删除（替换走上方"重新上传视频"） -->
          <view wx:if="{{hasUploadedVideo && !isUploading}}" class="media-actions">
            <button class="mini-btn" bindtap="previewVideo">预览视频</button>
            <button class="mini-btn danger" bindtap="deleteVideo">删除视频</button>
          </view>
          
          <!-- 失败原因由页面顶部提示条展示，这里只保留"重试"入口 -->
          <view wx:if="{{uploadStatus === 'failed'}}" class="upload-error">
            <button class="retry-btn" bindtap="retryUploadVideo">{{currentUploadId ? '继续上传（跳过已传分片）' : '重新上传'}}</button>
          </view>
        </view>
      </view>

      <!-- 报告上传卡片 -->
      <view class="card">
        <view class="upload-box">
          <view class="upload-icon">报告</view>
          <text class="muted">上传答辩报告（PDF / Word 格式）</text>

          <button class="outline-btn" bindtap="selectReport" disabled="{{isReportUploading}}">
            {{hasUploadedReport ? '重新上传报告' : '选择报告，开始上传'}}
          </button>

          <!-- 文件信息显示 -->
          <view wx:if="{{reportFileName}}" class="file-info">
            <text class="file-size">{{reportFileName}}（{{reportFileSizeReadable}}）</text>
          </view>

          <!-- 上传进度 -->
          <view wx:if="{{reportStatus === 'uploading'}}" class="upload-status">
            <view class="progress-container">
              <progress
                percent="{{reportUploadProgress}}"
                stroke-width="4"
                active-color="#1890ff"
                background-color="#f5f5f5"
                active="{{true}}"
              />
              <text class="progress-text">{{reportUploadProgress}}%</text>
            </view>
          </view>

          <!-- 已上传时提供查看/下载 / 删除 -->
          <view wx:if="{{hasUploadedReport && !isReportUploading}}" class="media-actions">
            <button class="mini-btn" bindtap="openUploadedReport">查看 / 下载</button>
            <button class="mini-btn danger" bindtap="deleteReport">删除报告</button>
          </view>

          <!-- 失败原因由页面顶部提示条展示，这里只保留"重试"入口 -->
          <view wx:if="{{reportStatus === 'failed'}}" class="upload-error">
            <button class="retry-btn" bindtap="selectReport">重新上传</button>
          </view>
        </view>
      </view>

      <view class="card">
        <view class="card-header">
          <text class="card-title">学生答辩记录</text>
          <view class="link" bindtap="switchTab" data-tab="records">查看全部</view>
        </view>
        <scroll-view 
          class="record-list-container" 
          scroll-y="true" 
          enable-back-to-top="true"
          lower-threshold="50"
          bindscrolltolower="onScrollToLower"
          refresher-enabled="true"
          refresher-triggered="{{refreshing}}"
          bindrefresherrefresh="onRefresh"
          style="max-height: 500rpx;">
          <view class="record-list">
            <block wx:for="{{defenseRecords}}" wx:key="id">
              <view class="record-item" bindtap="openRecord" data-id="{{item.id}}">
                <view class="record-avatar">AI</view>
                <view class="record-body">
                  <text class="record-name">{{user.name}}</text>
                  <text class="record-topic">{{item.topic}}</text>
                  <text class="record-date">{{item.date}}</text>
                </view>
                <view class="record-score">
                  <text class="score" wx:if="{{item.status === 'completed'}}">{{item.score}}分</text>
                  <text class="score" wx:else>未完成</text>
                  <text class="link-sm">查看详情</text>
                </view>
              </view>
            </block>
          </view>
        </scroll-view>
      </view>

    </view>

    <view wx:elif="{{activeTab === 'records'}}">
      <view class="section-title">答辩记录</view>
      <scroll-view 
        class="record-list-full" 
        scroll-y="true" 
        style="height: calc(100vh - 200rpx);"
        enable-back-to-top="true"
        lower-threshold="50"
        bindscrolltolower="onScrollToLower"
        refresher-enabled="true"
        refresher-triggered="{{refreshing}}"
        bindrefresherrefresh="onRefresh">
        <view class="record-list full">
          <block wx:for="{{defenseRecords}}" wx:key="id">
            <view class="record-item" bindtap="openRecord" data-id="{{item.id}}">
              <view class="record-avatar">AI</view>
              <view class="record-body">
                <text class="record-name">{{user.name}}</text>
                <text class="record-topic">{{item.topic}}</text>
                <text class="record-date">{{item.date}}</text>
              </view>
              <view class="record-score">
                <text class="score" wx:if="{{item.status === 'completed'}}">{{item.score}}分</text>
                <text class="score" wx:else>未完成</text>
                <text class="link-sm">查看详情</text>
              </view>
            </view>
          </block>
        </view>
      </scroll-view>
    </view>

    <view wx:elif="{{activeTab === 'profile'}}">
      <view class="section-title">个人信息</view>
      <view class="profile-avatar">
        <view class="avatar-circle large">
          <text class="avatar-text">{{user.name ? user.name.substring(0, 1) : 'S'}}</text>
        </view>
        <view class="link" wx:if="{{!isEditing}}" bindtap="startEdit">修改头像</view>
      </view>

      <view class="card">

        <view class="form-item">
          <text class="label">姓名</text>
          <input class="input" wx:if="{{isEditing}}" value="{{editedUser.name}}" bindinput="onEditName" />
          <text class="value" wx:else>{{user.name}}</text>
        </view>
        <view class="form-item">
          <text class="label">学号</text>
          <input class="input" wx:if="{{isEditing}}" value="{{editedUser.userNumber}}" bindinput="onEditUserNumber" />
          <text class="value" wx:else>{{user.userNumber}}</text>
        </view>
        <view class="form-item">
          <text class="label">手机号码</text>
          <input class="input" wx:if="{{isEditing}}" value="{{editedUser.phone}}" bindinput="onEditPhone" />
          <text class="value" wx:else>{{user.phone}}</text>
        </view>
        <view class="form-item">
          <text class="label">邮箱</text>
          <input class="input" wx:if="{{isEditing}}" value="{{editedUser.email}}" bindinput="onEditEmail" />
          <text class="value" wx:else>{{user.email}}</text>
        </view>
        <button class="primary-btn" wx:if="{{isEditing}}" bindtap="saveProfile">保存信息</button>
        <button class="primary-btn" wx:else bindtap="startEdit">修改个人信息</button>
      </view>

      <view class="card">
        <view class="cell" bindtap="changePassword">
          <text class="cell-text">修改密码</text>
          <text class="cell-arrow">></text>
        </view>
        <view class="cell danger" bindtap="logout">
          <text class="cell-text">退出登录</text>
          <text class="cell-arrow">></text>
        </view>
      </view>
    </view>

  </scroll-view>

  <!-- ⚠️ 以下弹层必须放在 .content 滚动区之外：
       scroll-view 为优化滚动会给自身加 transform，会使其内部 position:fixed
       退化为相对 scroll-view 定位，弹层被裁剪、右侧显示不全。 -->
  <!-- 答辩记录详情弹窗 -->
    <view wx:if="{{selectedRecord}}" class="modal-mask" bindtap="closeRecord">
      <view class="modal-card" catchtap>
        <view class="modal-header">
          <text class="modal-title">答辩详情</text>
          <text class="modal-close" bindtap="closeRecord">×</text>
        </view>
        <scroll-view class="modal-body" scroll-y="true">
          <view class="form-item">
            <text class="label">答辩题目</text>
            <text class="value">{{selectedRecord.topic}}</text>
          </view>
          <view class="form-item">
            <text class="label">答辩时间</text>
            <text class="value">{{selectedRecord.defenseTime}}</text>
          </view>
          <view class="form-item">
            <text class="label">得分</text>
            <text class="value" wx:if="{{selectedRecord.score > 0}}">{{selectedRecord.score}}分</text>
            <text class="value" wx:else>暂无评分</text>
          </view>
          
          <!-- 答辩视频 -->
          <view class="form-item" wx:if="{{selectedRecord.defenseVideoUrl && selectedRecord.defenseVideoUrl !== 'abc'}}">
            <text class="label">答辩视频</text>
            <view class="video-container">
              <video 
                src="{{selectedRecord.defenseVideoUrl}}" 
                controls="true" 
                autoplay="false" 
                poster="" 
                style="width: 100%; height: 300rpx; background-color: #000;"
                show-center-play-btn="true"
                enable-progress-gesture="true"
                object-fit="contain">
              </video>
            </view>
          </view>
          <view class="form-item" wx:elif="{{selectedRecord.defenseVideoUrl === 'abc'}}">
            <text class="label">答辩视频</text>
            <text class="value">视频地址无效或未上传</text>
          </view>
          
          <!-- 答辩报告 -->
          <view class="form-item" wx:if="{{selectedRecord.defenseReportUrl && selectedRecord.defenseReportUrl !== 'abc'}}">
            <text class="label">答辩报告</text>
            <button class="primary-btn" bindtap="openReport" data-url="{{selectedRecord.defenseReportUrl}}">查看文档</button>
          </view>
          <view class="form-item" wx:elif="{{selectedRecord.defenseReportUrl === 'abc'}}">
            <text class="label">答辩报告</text>
            <text class="value">文档地址无效或未上传</text>
          </view>
          
          <!-- AI分析结果 -->
          <view class="form-item" wx:if="{{selectedRecord.aiVideoAnalysis}}">
            <text class="label">AI视频分析</text>
            <scroll-view class="long-text-scroll" scroll-y="true" style="max-height: 150rpx;">
              <text class="value feedback">{{selectedRecord.aiVideoAnalysis}}</text>
            </scroll-view>
          </view>
          
          <view class="form-item" wx:if="{{selectedRecord.aiReportAnalysis}}">
            <text class="label">AI报告分析</text>
            <scroll-view class="long-text-scroll" scroll-y="true" style="max-height: 150rpx;">
              <text class="value feedback">{{selectedRecord.aiReportAnalysis}}</text>
            </scroll-view>
          </view>
          
          <view class="form-item" wx:if="{{selectedRecord.aiAllAnalysis}}">
            <text class="label">AI综合评价</text>
            <scroll-view class="long-text-scroll" scroll-y="true" style="max-height: 150rpx;">
              <text class="value feedback">{{selectedRecord.aiAllAnalysis}}</text>
            </scroll-view>
          </view>
          <view class="detail-actions" wx:if="{{selectedRecord.defenseVideoUrl && selectedRecord.defenseVideoUrl !== 'abc'}}">
            <button class="outline-btn" bindtap="openVideo">查看答辩视频</button>
            <button class="outline-btn" bindtap="openReport">查看答辩报告</button>
            <button class="outline-btn" bindtap="openAnswerDetail" data-id="{{selectedRecord.id}}">查看回答详情</button>
          </view>
          <view class="detail-actions" wx:else>
            <button class="outline-btn" bindtap="openAnswerDetail" data-id="{{selectedRecord.id}}">查看回答详情</button>
          </view>
        </scroll-view>
      </view>
    </view>
    
    <!-- 回答详情模态框 -->
    <view class="modal-mask" wx:if="{{selectedAnswers}}">
      <view class="modal-card" catchtap>
        <view class="modal-header">
          <text class="modal-title">回答详情</text>
          <text class="modal-close" bindtap="closeAnswers">×</text>
        </view>
        <scroll-view class="modal-body" scroll-y="true">
          <block wx:for="{{selectedAnswers}}" wx:key="answerId">
            <view class="answer-item">
              <view class="answer-header">
                <text class="answer-type {{item.questionTypeClass}}">{{item.questionTypeLabel}}</text>
                <text class="answer-score">评分: {{item.score}}分</text>
              </view>
              <view class="form-item">
                <text class="label">问题</text>
                <scroll-view class="long-text-scroll" scroll-y="true" style="max-height: 150rpx;">
                  <text class="value" wx:if="{{item.question !== null}}">{{item.question}}</text>
                  <text class="value" wx:else>{{item.customQuestion}}</text>
                </scroll-view>
              </view>
              <view class="form-item">
                <text class="label">学生回答</text>
                <scroll-view class="long-text-scroll" scroll-y="true" style="max-height: 150rpx;">
                  <text class="value">{{item.studentAnswer}}</text>
                </scroll-view>
              </view>
              <view class="form-item">
                <text class="label">反馈</text>
                <scroll-view class="long-text-scroll" scroll-y="true" style="max-height: 150rpx;">
                  <text class="value feedback">{{item.feedback}}</text>
                </scroll-view>
              </view>
              <view class="form-item">
                <text class="label">回答时间</text>
                <text class="value">{{item.createdAt}}</text>
              </view>
              <view class="answer-separator"></view>
            </view>
          </block>
        </scroll-view>
      </view>
    </view>

  <!-- 题目描述弹窗 -->
  <view class="modal-mask" wx:if="{{showTopicDescription}}" bindtap="closeTopicDescription">
    <view class="modal-card" catchtap>
      <view class="modal-header">
        <text class="modal-title">题目描述</text>
        <text class="modal-close" bindtap="closeTopicDescription">×</text>
      </view>
      <scroll-view class="modal-body" scroll-y="true">
        <view class="form-item">
          <text class="value">{{currentTopicDescription}}</text>
        </view>
        <view wx:if="{{!currentTopicDescription || currentTopicDescription === '暂无题目描述'}}" style="text-align: center; padding: 40rpx 0;">
          <text class="muted">暂无题目描述</text>
        </view>
      </scroll-view>
    </view>
  </view>

  <!-- 所有答辩题目弹窗 -->
  <view class="modal-mask" wx:if="{{showAllTopics}}" bindtap="closeAllTopicsModal">
    <view class="modal-card" catchtap>
      <view class="modal-header">
        <text class="modal-title">所有答辩题目</text>
        <text class="modal-close" bindtap="closeAllTopicsModal">×</text>
      </view>
      <scroll-view class="modal-body" scroll-y="true" style="max-height: 600rpx;">
        <block wx:for="{{defenseTopics}}" wx:key="topicId">
          <view class="form-item">
            <view class="form-header">
              <text class="label">答辩题目 {{index + 1}}</text>
              <text class="muted" style="font-size: 24rpx; margin-left: 8rpx;">{{item.defenseTime}}</text>
            </view>
            <text class="value" style="font-weight: bold; font-size: 32rpx; margin-top: 12rpx; color: #333;">{{item.topicName}}</text>
            <view style="margin-top: 16rpx;">
              <text class="label" style="font-size: 24rpx; color: #666;">答辩题目描述：</text>
              <text class="value" style="font-size: 28rpx; margin-top: 8rpx; line-height: 1.5; color: #555;">{{item.topicDescription || '暂无描述'}}</text>
            </view>
          </view>
          <view wx:if="{{index < defenseTopics.length - 1}}" style="height: 2rpx; background: #f0f0f0; margin: 20rpx 0;"></view>
        </block>
        <view wx:if="{{defenseTopics.length === 0}}" style="text-align: center; padding: 40rpx 0;">
          <text class="muted">暂无答辩题目</text>
        </view>
      </scroll-view>
    </view>
  </view>

  <view class="tab-bar">
    <view 
      class="tab-item {{activeTab === 'home' ? 'active' : ''}}" 
      bindtap="switchTab" 
      data-tab="home">
      <text class="tab-text">首页</text>
    </view>
    <view 
      class="tab-item {{activeTab === 'records' ? 'active' : ''}}" 
      bindtap="switchTab" 
      data-tab="records">
      <text class="tab-text">答辩记录</text>
    </view>
    <view 
      class="tab-item {{activeTab === 'profile' ? 'active' : ''}}" 
      bindtap="switchTab" 
      data-tab="profile">
      <text class="tab-text">我的</text>
    </view>
  </view>

</view>