<view class="page">
  <view class="header">
    <text class="header-title">课程考核AI答辩辅助</text>
  </view>

  <!-- 提示条：上传成功/失败在标题栏下方提示，5 秒后自动消失。
       刻意放在文档流里而不是 fixed 悬浮层：既不会被状态栏/刘海屏遮挡，
       也不会出现"只看到一片白、突然变绿"的观感。 -->
  <view wx:if="{{banner.visible}}" class="top-banner {{banner.type === 'error' ? 'banner-error' : 'banner-success'}}">
    <text class="banner-icon">{{banner.type === 'error' ? '!' : '✓'}}</text>
    <text class="banner-text">{{banner.text}}</text>
  </view>

  <scroll-view class="content" scroll-y>
    <view wx:if="{{activeTab === 'home'}}">
      <view class="welcome-card gradient-blue">
        <view class="avatar-circle">
          <text class="avatar-text">S</text>
        </view>
        <view class="welcome-info">
          <text class="welcome-title">欢迎，{{user.name}}同学</text>
          <text class="welcome-subtitle">备考评审你的答辩视频帮助学习</text>
        </view>
      </view>

      <view class="card">
        <text class="card-title">下一轮答辩</text>
        <view class="card-block">
          <text class="label">答辩题目</text>
          <text class="value">{{nextDefense.topic}}</text>
        </view>
        <view class="row">
          <view class="badge-icon">时间</view>
          <text class="muted">答辩时间：{{nextDefense.date}}</text>
        </view>
        <!-- 答辩入口：文字答辩 / 语音答辩（同级并列，题型与流程完全一致，仅交互方式不同） -->
        <view class="defense-entry-row">
          <button class="primary-btn entry-btn" bindtap="startDefense">文字答辩</button>
          <button class="primary-btn entry-btn voice-entry-btn" bindtap="startVoiceDefense">语音答辩</button>
        </view>
        <view style="margin-top: 16rpx; text-align: center;">
          <text class="link" bindtap="showTopicDescription">查看题目描述</text>
          <text class="muted" style="margin: 0 8rpx;">|</text>
          <text class="link" bindtap="showAllTopicsModal">查看所有答辩题目</text>
        </view>
      </view>

      <!-- 【2026-10-18】唯一选题入口：下一轮答辩、题目描述、文字/语音答辩与附件归属共用这一选择 -->
      <view class="card topic-picker-card">
        <text class="picker-label">答辩题目</text>
        <picker mode="selector" range="{{defenseTopics}}" range-key="topicName"
                value="{{uploadTopicIndex}}" bindchange="onUploadTopicChange">
          <view class="picker-value">
            <text class="picker-text">{{uploadTopicName || '请选择答辩题目'}}</text>
            <text class="picker-arrow">›</text>
          </view>
        </picker>
        <text class="muted" style="margin-top: 12rpx; display: block;">选择后，「下一轮答辩」与附件归属同步更新</text>
      </view>

      <view class="card">
        <view class="upload-box">
          <view class="upload-icon">视频</view>
          <text class="muted">上传答辩视频</text>
          
          <!-- 根据是否已上传显示不同按钮文本 -->
          <button class="outline-btn" bindtap="selectVideo" disabled="{{isUploading}}">
            {{hasUploadedVideo ? '重新上传视频' : '选择视频，开始上传'}}
          </button>
          
          <!-- 文件信息显示 -->
          <view wx:if="{{currentFileSizeReadable}}" class="file-info">
            <text class="file-size">文件大小：{{currentFileSizeReadable}}</text>
            <button class="cancel-btn" wx:if="{{isUploading}}" bindtap="cancelUpload">取消上传</button>
          </view>
          
          <!-- 上传状态显示（进度与阶段文案均由通用上传模块回调驱动） -->
          <view wx:if="{{uploadStatus === 'init' || uploadStatus === 'uploading' || uploadStatus === 'merging'}}" class="upload-status">
            <view class="progress-container">
              <progress 
                percent="{{uploadProgress}}" 
                stroke-width="4" 
                active-color="#1890ff" 
                background-color="#f5f5f5"
                active="{{true}}"
              />
              <text class="progress-text">{{uploadProgress}}%</text>
            </view>
            <text class="status-text">{{uploadStageText}}</text>
          </view>
          
          <!-- 已上传时提供预览 / 删除（替换走上方"重新上传视频"） -->
          <view wx:if="{{hasUploadedVideo && !isUploading}}" class="media-actions">
            <button class="mini-btn" bindtap="previewVideo">预览视频</button>
            <button class="mini-btn danger" bindtap="deleteVideo">删除视频</button>
          </view>
          
          <!-- 失败原因由页面顶部提示条展示，这里只保留"重试"入口 -->
          <view wx:if="{{uploadStatus === 'failed'}}" class="upload-error">
            <button class="retry-btn" bindtap="retryUploadVideo">{{currentUploadId ? '继续上传（跳过已传分片）' : '重新上传'}}</button>
          </view>
        </view>
      </view>

      <!-- 报告上传卡片 -->
      <view class="card">
        <view class="upload-box">
          <view class="upload-icon">报告</view>
          <!-- 【2026-10-20 · 报告模板】提交格式统一为 .docx：
               它既是系统唯一能完整解析的类型，也是「下载报告模板」下发的类型，
               学生直接在模板里填写即可，避免"交上来才发现读不了"。
               其余格式（pdf / doc / ppt / pptx / xls / xlsx / txt）由后端返回明确提示。 -->
          <text class="muted">上传答辩报告（仅支持 .docx）</text>
          <text class="muted">请先下载模板，在模板中填写后上传；PDF 与旧版 doc 请另存为 docx</text>

          <button class="outline-btn" bindtap="selectReport" disabled="{{isReportUploading}}">
            {{hasUploadedReport ? '重新上传报告' : '选择报告，开始上传'}}
          </button>

          <!-- 报告模板下载：模板类型 = 系统唯一可分析的类型
               【2026-10-20】电脑端微信点击后弹系统「另存为」可选保存位置；
               手机端打开文档后从右上角「…」另存为 / 发送到电脑。 -->
          <view class="template-link" bindtap="downloadReportTemplate">下载报告模板（.docx，含填写须知）</view>
          <text class="muted">电脑端可直接选择保存位置；手机端打开后从右上角菜单另存（Word / WPS 均可打开）</text>

          <!-- 文件信息显示 -->
          <view wx:if="{{reportFileName}}" class="file-info">
            <text class="file-size">{{reportFileName}}（{{reportFileSizeReadable}}）</text>
          </view>

          <!-- 上传进度 -->
          <view wx:if="{{reportStatus === 'uploading'}}" class="upload-status">
            <view class="progress-container">
              <progress
                percent="{{reportUploadProgress}}"
                stroke-width="4"
                active-color="#1890ff"
                background-color="#f5f5f5"
                active="{{true}}"
              />
              <text class="progress-text">{{reportUploadProgress}}%</text>
            </view>
          </view>

          <!-- 已上传时提供查看/下载 / 删除 -->
          <view wx:if="{{hasUploadedReport && !isReportUploading}}" class="media-actions">
            <button class="mini-btn" bindtap="openUploadedReport">查看 / 下载</button>
            <button class="mini-btn danger" bindtap="deleteReport">删除报告</button>
          </view>

          <!-- 失败原因由页面顶部提示条展示，这里只保留"重试"入口 -->
          <view wx:if="{{reportStatus === 'failed'}}" class="upload-error">
            <button class="retry-btn" bindtap="selectReport">重新上传</button>
          </view>
        </view>
      </view>

      <view class="card">
        <view class="card-header">
          <text class="card-title">学生答辩记录</text>
          <view class="link" bindtap="switchTab" data-tab="records">查看全部</view>
        </view>
        <scroll-view 
          class="record-list-container" 
          scroll-y="true" 
          enable-back-to-top="true"
          lower-threshold="50"
          bindscrolltolower="onScrollToLower"
          refresher-enabled="true"
          refresher-triggered="{{refreshing}}"
          bindrefresherrefresh="onRefresh"
          style="max-height: 500rpx;">
          <view class="record-list">
            <block wx:for="{{defenseRecords}}" wx:key="id">
              <!-- 【VID-4 · 2026-10-20】已上传视频的场次用浅红底 + 左红条标出（与教师端同款） -->
              <view class="record-item {{item.docAnalyzed ? 'doc-analyzed' : (item.reportUploaded ? 'report-uploaded' : (item.hasVideo ? 'has-video' : ''))}}" bindtap="openRecord" data-id="{{item.id}}">
                <view class="record-avatar">AI</view>
                <view class="record-body">
                  <text class="record-name">{{user.name}}</text>
                  <text class="record-topic">{{item.topic}}</text>
                  <text class="record-date">{{item.date}}</text>
                </view>
                <view class="record-score">
                  <!-- 【2026-10-25】按「有没有分数」着色，不按 status：0 分（跑题归零 / 文档评析 0 分）也是合法分数 -->
                  <text class="score" wx:if="{{item.hasScore}}">{{item.score}}分</text>
                  <text class="score" wx:elif="{{item.status === 'completed'}}">已完成</text>
                  <text class="score" wx:else>未完成</text>
                  <text wx:if="{{item.docAnalyzed}}" class="g-tag g-tag-doc">报告评析</text>
                  <text wx:elif="{{item.reportUploaded}}" class="g-tag g-tag-doc">报告已上传</text>
                  <text wx:if="{{item.hasVideo}}" class="g-tag g-tag-video">视频已上传</text>
                  <!-- 【2026-10-25】材料裁定不合格：不进五维、不出分，详情里有裁定理由 -->
                  <text wx:if="{{item.verdictLabel}}" class="g-tag g-tag-warn">{{item.verdictLabel}}</text>
                  <text class="link-sm">查看详情</text>
                </view>
              </view>
            </block>
          </view>
        </scroll-view>
      </view>

    </view>

    <view wx:elif="{{activeTab === 'records'}}">
      <view class="section-title">答辩记录</view>
      <scroll-view 
        class="record-list-full" 
        scroll-y="true" 
        style="height: calc(100vh - 200rpx);"
        enable-back-to-top="true"
        lower-threshold="50"
        bindscrolltolower="onScrollToLower"
        refresher-enabled="true"
        refresher-triggered="{{refreshing}}"
        bindrefresherrefresh="onRefresh">
        <view class="record-list full">
          <block wx:for="{{defenseRecords}}" wx:key="id">
            <!-- 【VID-4 · 2026-10-20】已上传视频的场次用浅红底 + 左红条标出（与教师端同款） -->
            <view class="record-item {{item.docAnalyzed ? 'doc-analyzed' : (item.reportUploaded ? 'report-uploaded' : (item.hasVideo ? 'has-video' : ''))}}" bindtap="openRecord" data-id="{{item.id}}">
              <view class="record-avatar">AI</view>
              <view class="record-body">
                <text class="record-name">{{user.name}}</text>
                <text class="record-topic">{{item.topic}}</text>
                <text class="record-date">{{item.date}}</text>
              </view>
              <view class="record-score">
                <!-- 【2026-10-25】同首页列表：按 hasScore 判断，0 分也要显示分数 -->
                <text class="score" wx:if="{{item.hasScore}}">{{item.score}}分</text>
                <text class="score" wx:elif="{{item.status === 'completed'}}">已完成</text>
                <text class="score" wx:else>未完成</text>
                <text wx:if="{{item.docAnalyzed}}" class="g-tag g-tag-doc">报告评析</text>
                <text wx:elif="{{item.reportUploaded}}" class="g-tag g-tag-doc">报告已上传</text>
                <text wx:if="{{item.hasVideo}}" class="g-tag g-tag-video">视频已上传</text>
                  <!-- 【2026-10-25】材料裁定不合格：不进五维、不出分，详情里有裁定理由 -->
                  <text wx:if="{{item.verdictLabel}}" class="g-tag g-tag-warn">{{item.verdictLabel}}</text>
                <text class="link-sm">查看详情</text>
              </view>
            </view>
          </block>
        </view>
      </scroll-view>
    </view>

    <view wx:elif="{{activeTab === 'profile'}}">
      <view class="section-title">个人信息</view>
      <view class="profile-avatar">
        <view class="avatar-circle large">
          <text class="avatar-text">{{user.name ? user.name.substring(0, 1) : 'S'}}</text>
        </view>
        <view class="link" wx:if="{{!isEditing}}" bindtap="startEdit">修改头像</view>
      </view>

      <view class="card">

        <view class="form-item">
          <text class="label">姓名</text>
          <input class="input" wx:if="{{isEditing}}" value="{{editedUser.name}}" bindinput="onEditName" />
          <text class="value" wx:else>{{user.name}}</text>
        </view>
        <view class="form-item">
          <text class="label">学号</text>
          <input class="input" wx:if="{{isEditing}}" value="{{editedUser.userNumber}}" bindinput="onEditUserNumber" />
          <text class="value" wx:else>{{user.userNumber}}</text>
        </view>
        <view class="form-item">
          <text class="label">手机号码</text>
          <input class="input" wx:if="{{isEditing}}" value="{{editedUser.phone}}" bindinput="onEditPhone" />
          <text class="value" wx:else>{{user.phone}}</text>
        </view>
        <view class="form-item">
          <text class="label">邮箱</text>
          <input class="input" wx:if="{{isEditing}}" value="{{editedUser.email}}" bindinput="onEditEmail" />
          <text class="value" wx:else>{{user.email}}</text>
        </view>
        <button class="primary-btn" wx:if="{{isEditing}}" bindtap="saveProfile">保存信息</button>
        <button class="primary-btn" wx:else bindtap="startEdit">修改个人信息</button>
      </view>

      <view class="card">
        <view class="cell" bindtap="goFeedback">
          <text class="cell-text">意见反馈</text>
          <text class="cell-arrow">></text>
        </view>
        <view class="cell" bindtap="changePassword">
          <text class="cell-text">修改密码</text>
          <text class="cell-arrow">></text>
        </view>
        <view class="cell danger" bindtap="logout">
          <text class="cell-text">退出登录</text>
          <text class="cell-arrow">></text>
        </view>
      </view>
    </view>

  </scroll-view>

  <!-- ⚠️ 以下弹层必须放在 .content 滚动区之外：
       scroll-view 为优化滚动会给自身加 transform，会使其内部 position:fixed
       退化为相对 scroll-view 定位，弹层被裁剪、右侧显示不全。 -->
  <!-- 答辩记录详情弹窗 -->
    <view wx:if="{{selectedRecord}}" class="modal-mask" bindtap="closeRecord">
      <view class="modal-card" catchtap>
        <view class="modal-header">
          <text class="modal-title">答辩详情</text>
          <text class="modal-close" bindtap="closeRecord">×</text>
        </view>
        <scroll-view class="modal-body" scroll-y="true">
          <view class="form-item">
            <text class="label">答辩题目</text>
            <text class="value">{{selectedRecord.topic}}</text>
          </view>
          <view class="form-item">
            <text class="label">答辩时间</text>
            <text class="value">{{selectedRecord.defenseTime}}</text>
          </view>
          <view class="form-item">
            <text class="label">得分</text>
            <!-- 【2026-10-25】0 分也要显示（跑题归零 / 文档评析 0 分），只有真没分数时才显示暂无评分 -->
            <text class="value" wx:if="{{selectedRecord.hasScore}}">{{selectedRecord.score}}分</text>
            <text class="value" wx:else>暂无评分</text>
          </view>
          
          <!-- 答辩视频 -->
          <view class="form-item" wx:if="{{selectedRecord.defenseVideoUrl && selectedRecord.defenseVideoUrl !== 'abc'}}">
            <text class="label">答辩视频</text>
            <view class="video-container">
              <video 
                src="{{selectedRecord.defenseVideoUrl}}" 
                controls="true" 
                autoplay="false" 
                poster="" 
                style="width: 100%; height: 300rpx; background-color: #000;"
                show-center-play-btn="true"
                enable-progress-gesture="true"
                object-fit="contain">
              </video>
            </view>
          </view>
          <view class="form-item" wx:elif="{{selectedRecord.defenseVideoUrl === 'abc'}}">
            <text class="label">答辩视频</text>
            <text class="value">视频地址无效或未上传</text>
          </view>
          
          <!-- 答辩报告 -->
          <view class="form-item" wx:if="{{selectedRecord.defenseReportUrl && selectedRecord.defenseReportUrl !== 'abc'}}">
            <text class="label">答辩报告</text>
            <button class="primary-btn" bindtap="openReport" data-url="{{selectedRecord.defenseReportUrl}}">查看文档</button>
          </view>
          <view class="form-item" wx:elif="{{selectedRecord.defenseReportUrl === 'abc'}}">
            <text class="label">答辩报告</text>
            <text class="value">文档地址无效或未上传</text>
          </view>
          
          <!-- 【2026-10-20 · 视频 AI 评分】教师端触发后，后端把「听声识别 + 五维评分」
               的结果写进 video_analysis。这里与教师端同一解析器拆成成绩单，
               分数/等级/依据一目了然；老数据（纯文本）仍走下面的原文兜底。 -->
          <!-- 【2026-10-25】必须有视频才显示视频成绩单：
               旧场次残留的 video_analysis（视频链接已清）不该出现在"只交了报告"的详情里，
               否则学生会以为"我交的是文档，怎么出来视频评分"。 -->
          <view class="form-item" wx:if="{{(videoSummary || videoDims.length > 0) && selectedRecord.defenseVideoUrl && selectedRecord.defenseVideoUrl !== 'abc'}}">
            <text class="label">视频 AI 评分（基于视频里的说话内容）</text>
            <view wx:if="{{videoSummary}}" class="sc-summary">
              <text class="sc-total">{{videoSummary.total}}</text>
              <text class="sc-total-max">/50</text>
              <text wx:if="{{videoSummary.grade}}" class="g-tag g-tag-doc">{{videoSummary.grade}}</text>
              <text class="sc-total-note">等级与报告评析同一把尺子</text>
            </view>
            <view wx:for="{{videoSummary.warnings}}" wx:key="*this" class="sc-tip">⚠️ {{item}}</view>
            <view wx:for="{{videoDims}}" wx:key="name" class="sc-round">
              <view class="sc-round-head">
                <text class="sc-round-title">{{item.missing ? '⚠️ ' : ''}}{{item.name}}</text>
                <text class="sc-round-total">{{item.score}} / 10</text>
              </view>
              <text class="sc-round-comment">{{item.comment}}</text>
            </view>
          </view>
          <view class="form-item" wx:elif="{{selectedRecord.defenseVideoUrl && selectedRecord.defenseVideoUrl !== 'abc' && selectedRecord.aiVideoAnalysis}}">
            <text class="label">AI视频分析</text>
            <scroll-view class="long-text-scroll" scroll-y="true" style="max-height: 300rpx;">
              <text class="value feedback">{{selectedRecord.aiVideoAnalysis}}</text>
            </scroll-view>
          </view>
          
          <view class="form-item" wx:if="{{selectedRecord.aiReportAnalysis}}">
            <text class="label">AI报告分析</text>
            <scroll-view class="long-text-scroll" scroll-y="true" style="max-height: 150rpx;">
              <text class="value feedback">{{selectedRecord.aiReportAnalysis}}</text>
            </scroll-view>
          </view>
          
          <view class="form-item" wx:if="{{selectedRecord.aiAllAnalysis}}">
            <text class="label">AI综合评价</text>
            <scroll-view class="long-text-scroll" scroll-y="true" style="max-height: 150rpx;">
              <text class="value feedback">{{selectedRecord.aiAllAnalysis}}</text>
            </scroll-view>
          </view>

          <!-- 【2026-10-16 · 报告五维评分】基于**上传的报告文档**的真实评析。
               与上面的「AI报告分析」不是一回事：那块是答辩收尾时模型凭空写的，
               本块是后端读取上传文档的文字后按五维评分得到的。
               由教师端触发；未生成时不显示（不是"暂无"，而是这条链路还没跑过）。 -->
          <!-- 【2026-10-25】报告评析改成与教师端「回答详情」同款卡片观感：
               总分 / 等级 / 五维逐项 + 评分引擎（本地 3B 或云端复核）。
               此前学生端只显示一大段裸文本，同一条成绩单两端长得不一样。 -->
          <!-- 【N87 · 2026-10-27】本弹层（答辩详情）只放「五维评分」：总分 + 等级 + 五维卡片。
               「报告综合评价」正文已迁到二级页「查看回答详情」，两处不再重复。
               样式统一按教师端「回答详情」的成绩单（doc-score-summary / doc-dim-* + 「X 分」）。 -->
          <view class="form-item" wx:if="{{(selectedRecord.defenseReportUrl && selectedRecord.defenseReportUrl !== 'abc') || selectedRecord.reportDocAnalysis || selectedRecord.reportDocText}}">
            <text class="label">报告 AI 五维评分（本地模型）</text>
            <!-- 【N87 · 2026-10-27】材料裁定**只做只读状态**，学生不可操作：
                 ① 判过不合格且未复审 → 「待复审」+ 类型/理由，且不出分；
                 ② 教师云端复审通过 → 「已复审」（后端把 material_verdict 置 ok，正常材料该列为空）；
                 ③ 正常材料 → 什么都不显示。 -->
            <view wx:if="{{selectedRecord.verdictState === 'pending'}}" class="doc-verdict">
              <text class="doc-verdict-title">⚠️ 材料未通过资格裁定：{{selectedRecord.verdictLabel}}</text>
              <text wx:if="{{selectedRecord.materialVerdictType}}" class="doc-verdict-line">材料类型：{{selectedRecord.materialVerdictType}}</text>
              <text wx:if="{{selectedRecord.materialVerdictReason}}" class="doc-verdict-line">理由：{{selectedRecord.materialVerdictReason}}</text>
              <text class="doc-verdict-line">未进入五维评分，分数留空；教师复审后才会有成绩。</text>
            </view>
            <text wx:elif="{{selectedRecord.verdictState === 'reviewed'}}" class="sc-tip">✅ 材料已通过教师复审，以下为复审后的成绩。</text>
            <block wx:if="{{reportDocSummary || reportDocDims.length > 0}}">
              <view wx:if="{{reportDocSummary}}" class="doc-score-summary">
                <text class="doc-total">总分 {{reportDocSummary.total}}/50</text>
                <text wx:if="{{reportDocSummary.grade}}" class="g-tag g-tag-doc">等级 {{reportDocSummary.grade}}</text>
                <text wx:if="{{reportDocEngine}}" class="sc-total-note">{{reportDocEngine}}</text>
              </view>
              <view wx:for="{{reportDocSummary.warnings}}" wx:key="*this" class="doc-warn">⚠️ {{item}}</view>
              <view wx:for="{{reportDocDims}}" wx:key="name" class="doc-dim-item">
                <view class="doc-dim-head">
                  <text class="doc-dim-name">{{item.missing ? '⚠️ ' : ''}}{{item.name}}</text>
                  <text class="doc-dim-score">{{item.score}} 分</text>
                </view>
                <text class="doc-dim-comment">{{item.comment}}</text>
              </view>
            </block>
            <!-- 解析不出五维时展示原文，绝不静默丢内容；待复审场次的原文就是上面的裁定说明，
                 再滚一遍等于重复，这里跳过 -->
            <scroll-view wx:elif="{{reportDocRaw && selectedRecord.verdictState !== 'pending'}}" class="long-text-scroll" scroll-y="true" style="max-height: 400rpx;">
              <text class="value feedback">{{reportDocRaw}}</text>
            </scroll-view>
            <text wx:elif="{{selectedRecord.verdictState !== 'pending'}}" class="muted">报告已上传，AI 正在自动评析（约 1~2 分钟）。稍后重新打开本页即可看到五维分数。</text>
          </view>
          <view class="detail-actions" wx:if="{{selectedRecord.defenseVideoUrl && selectedRecord.defenseVideoUrl !== 'abc'}}">
            <button class="outline-btn" bindtap="openVideo">查看答辩视频</button>
            <button class="outline-btn" bindtap="openReport">查看答辩报告</button>
            <button class="outline-btn" bindtap="openAnswerDetail" data-id="{{selectedRecord.id}}">查看回答详情</button>
          </view>
          <view class="detail-actions" wx:else>
            <button class="outline-btn" bindtap="openAnswerDetail" data-id="{{selectedRecord.id}}">查看回答详情</button>
          </view>
        </scroll-view>
      </view>
    </view>
    
    <!-- 回答详情模态框 -->
    <view class="modal-mask" wx:if="{{selectedAnswers}}">
      <view class="modal-card" catchtap>
        <view class="modal-header">
          <text class="modal-title">回答详情</text>
          <text class="modal-close" bindtap="closeAnswers">×</text>
        </view>
        <scroll-view class="modal-body" scroll-y="true">
          <!-- 【2026-10-20 · 评分表成绩单化】数据源仍是 defense_score_record，
               但展示口径与「报告评析」一致：总分 + 等级 + 逐项依据。
               此前只有一行纯文本分数，大模型的本轮评语（comment）根本没展示。 -->
          <view wx:if="{{scoreSummary}}" class="form-item">
            <text class="label">评分表（本地大模型判定）</text>
            <view class="sc-summary">
              <text class="sc-total">{{scoreSummary.totalText}}</text>
              <text class="sc-total-max">/50</text>
              <text class="g-tag g-tag-doc">{{scoreSummary.grade}}</text>
              <text class="sc-total-note">逐轮平均 · 共 {{scoreSummary.roundCount}} 轮</text>
            </view>
            <view class="sc-dims">
              <view wx:for="{{scoreSummary.dims}}" wx:key="name" class="sc-dim">
                <text class="sc-dim-name">{{item.name}}</text>
                <text class="sc-dim-score">{{item.avg}}</text>
              </view>
            </view>
            <text class="sc-tip">五维各 10 分、合计 50 分；等级与报告评析同一把尺子（≥35 优秀 / 26~34 良好 / 15~25 合格 / 5~14 不合格 / 5 分以下无效）。</text>
          </view>

          <!-- 【N87 · 2026-10-27】文档报告场次**一条作答都没有**（scoreSummary / scoreCards 皆空）。
               分层口径（用户 2026-10-27 拍板）：五维成绩单只留在「答辩详情」，
               本弹层只负责「报告综合评价」正文——此前两处都放五维 + 综合评价，信息重复。
               数据来自已加载的详情，不请求接口：报告评析由教师端触发，学生端只读。 -->
          <view class="form-item" wx:if="{{!scoreSummary && scoreCards.length === 0 && selectedRecord && selectedRecord.reportDocText}}">
            <text class="label">报告综合评价</text>
            <view class="doc-summary-box">
              <text class="doc-summary-text">{{selectedRecord.reportDocText}}</text>
            </view>
            <text class="sc-tip">五维评分请在「答辩详情」查看；本场次没有逐轮问答，评析来自上传报告的 AI 分析（教师端触发）。</text>
          </view>
          <!-- 材料未通过裁定（未复审）：没有综合评价正文，给出明确去向，别让弹层空白 -->
          <view class="form-item" wx:elif="{{!scoreSummary && scoreCards.length === 0 && selectedRecord && selectedRecord.verdictState === 'pending'}}">
            <text class="muted">该场次材料未通过资格裁定，暂无综合评价。裁定理由可在「答辩详情」查看，教师复审后才会出分。</text>
          </view>

          <!-- 逐轮判定：每轮一张卡，分数 + 等级 + 该轮大模型评语（依据） -->
          <view wx:if="{{scoreCards.length > 0}}" class="form-item">
            <text class="label">逐轮判定与依据</text>
            <view wx:for="{{scoreCards}}" wx:key="roundNum" class="sc-round">
              <view class="sc-round-head">
                <text class="sc-round-title">第 {{item.roundNum}} 轮</text>
                <text class="sc-round-total">{{item.totalText}} / 50</text>
                <text class="g-tag g-tag-doc">{{item.grade}}</text>
              </view>
              <view class="sc-round-dims">
                <text wx:for="{{item.dims}}" wx:for-item="dim" wx:key="name" class="sc-round-dim">{{dim.name}} {{dim.score}}</text>
              </view>
              <text wx:if="{{item.comment}}" class="sc-round-comment">{{item.comment}}</text>
              <text wx:else class="sc-round-comment sc-muted">本轮模型未返回评语</text>
            </view>
          </view>
          <!-- 【N8】五维雷达图（逐轮五维平均分，canvas 2d 手绘，无图表库） -->
          <view wx:if="{{radarDims.length === 5}}" class="form-item">
            <text class="label">五维能力雷达图（逐轮平均）</text>
            <canvas type="2d" id="radarCanvas" class="radar-canvas"></canvas>
            <text class="muted">{{radarText}}</text>
          </view>

          <!-- 【F11】语音答辩逐轮录音回放（来源 voice_responses，仅语音答辩场次有归档） -->
          <view wx:if="{{voiceRecords.length > 0}}" class="form-item">
            <text class="label">语音录音回放</text>
            <view wx:for="{{voiceRecords}}" wx:key="key" class="voice-record-row">
              <text class="muted">{{item.label}}</text>
              <text class="voice-play-btn" data-url="{{item.url}}" catchtap="playVoiceRecord">▶ 播放</text>
            </view>
          </view>
          <block wx:for="{{selectedAnswers}}" wx:key="answerId">
            <view class="answer-item">
              <view class="answer-header">
                <text class="answer-type {{item.questionTypeClass}}">{{item.questionTypeLabel}}</text>
                <text class="answer-score">评分: {{item.score}}分</text>
              </view>
              <view class="form-item">
                <text class="label">问题</text>
                <scroll-view class="long-text-scroll" scroll-y="true" style="max-height: 150rpx;">
                  <text class="value" wx:if="{{item.question !== null}}">{{item.question}}</text>
                  <text class="value" wx:else>{{item.customQuestion}}</text>
                </scroll-view>
              </view>
              <view class="form-item">
                <text class="label">学生回答</text>
                <scroll-view class="long-text-scroll" scroll-y="true" style="max-height: 150rpx;">
                  <text class="value">{{item.studentAnswer}}</text>
                </scroll-view>
              </view>
              <!-- 【N8】标准答案对照：预设题有标准答案；追问没有，故无值时不显示 -->
              <view class="form-item" wx:if="{{item.standardAnswer}}">
                <text class="label">标准答案</text>
                <scroll-view class="long-text-scroll" scroll-y="true" style="max-height: 200rpx;">
                  <text class="value standard-answer">{{item.standardAnswer}}</text>
                </scroll-view>
              </view>
              <view class="form-item">
                <text class="label">反馈</text>
                <scroll-view class="long-text-scroll" scroll-y="true" style="max-height: 150rpx;">
                  <text class="value feedback">{{item.feedback}}</text>
                </scroll-view>
              </view>
              <view class="form-item">
                <text class="label">回答时间</text>
                <text class="value">{{item.createdAt}}</text>
              </view>
              <view class="answer-separator"></view>
            </view>
          </block>
        </scroll-view>
      </view>
    </view>

  <!-- 题目描述弹窗 -->
  <view class="modal-mask" wx:if="{{showTopicDescription}}" bindtap="closeTopicDescription">
    <view class="modal-card" catchtap>
      <view class="modal-header">
        <text class="modal-title">题目描述</text>
        <text class="modal-close" bindtap="closeTopicDescription">×</text>
      </view>
      <scroll-view class="modal-body" scroll-y="true">
        <view class="form-item">
          <text class="value">{{currentTopicDescription}}</text>
        </view>
        <view wx:if="{{!currentTopicDescription || currentTopicDescription === '暂无题目描述'}}" style="text-align: center; padding: 40rpx 0;">
          <text class="muted">暂无题目描述</text>
        </view>
      </scroll-view>
    </view>
  </view>

  <!-- 所有答辩题目弹窗 -->
  <view class="modal-mask" wx:if="{{showAllTopics}}" bindtap="closeAllTopicsModal">
    <view class="modal-card" catchtap>
      <view class="modal-header">
        <text class="modal-title">所有答辩题目</text>
        <text class="modal-close" bindtap="closeAllTopicsModal">×</text>
      </view>
      <scroll-view class="modal-body" scroll-y="true" style="max-height: 600rpx;">
        <block wx:for="{{defenseTopics}}" wx:key="topicId">
          <view class="form-item">
            <view class="form-header">
              <text class="label">答辩题目 {{index + 1}}</text>
              <text class="muted" style="font-size: 24rpx; margin-left: 8rpx;">{{item.defenseTime}}</text>
            </view>
            <text class="value" style="font-weight: bold; font-size: 32rpx; margin-top: 12rpx; color: #333;">{{item.topicName}}</text>
            <view style="margin-top: 16rpx;">
              <text class="label" style="font-size: 24rpx; color: #666;">答辩题目描述：</text>
              <text class="value" style="font-size: 28rpx; margin-top: 8rpx; line-height: 1.5; color: #555;">{{item.topicDescription || '暂无描述'}}</text>
            </view>
          </view>
          <view wx:if="{{index < defenseTopics.length - 1}}" style="height: 2rpx; background: #f0f0f0; margin: 20rpx 0;"></view>
        </block>
        <view wx:if="{{defenseTopics.length === 0}}" style="text-align: center; padding: 40rpx 0;">
          <text class="muted">暂无答辩题目</text>
        </view>
      </scroll-view>
    </view>
  </view>

  <view class="tab-bar">
    <view 
      class="tab-item {{activeTab === 'home' ? 'active' : ''}}" 
      bindtap="switchTab" 
      data-tab="home">
      <text class="tab-text">首页</text>
    </view>
    <view 
      class="tab-item {{activeTab === 'records' ? 'active' : ''}}" 
      bindtap="switchTab" 
      data-tab="records">
      <text class="tab-text">答辩记录</text>
    </view>
    <view 
      class="tab-item {{activeTab === 'profile' ? 'active' : ''}}" 
      bindtap="switchTab" 
      data-tab="profile">
      <text class="tab-text">我的</text>
    </view>
  </view>

</view>