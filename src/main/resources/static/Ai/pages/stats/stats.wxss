/* 数据总览（教师端）— 2026-10-01 新增 */
.page {
  min-height: 100vh;
  background: var(--g-bg, #f5f7fa);
  display: flex;
  flex-direction: column;
}

.nav-bar {
  display: flex;
  align-items: center;
  height: 88rpx;
  padding: 0 24rpx;
  background: #ffffff;
  border-bottom: 1rpx solid var(--g-border, #f0f0f0);
}

.nav-back {
  width: 60rpx;
  font-size: 48rpx;
  line-height: 1;
  color: #333333;
}

.nav-title {
  flex: 1;
  text-align: center;
  font-size: 32rpx;
  font-weight: 600;
  color: #333333;
}

.nav-placeholder {
  width: 60rpx;
}

.content {
  flex: 1;
  padding: 24rpx;
  box-sizing: border-box;
}

/* 课题分布 */
.dist-item {
  margin-bottom: 24rpx;
}

.dist-item:last-child {
  margin-bottom: 0;
}

.dist-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 10rpx;
}

.dist-name {
  font-size: 26rpx;
  color: #333333;
  flex: 1;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  margin-right: 16rpx;
}

.dist-count {
  font-size: 24rpx;
  color: #008cba;
  font-weight: 600;
}

/* 趋势 */
.trend-item {
  display: flex;
  align-items: center;
  margin-bottom: 14rpx;
}

.trend-day {
  width: 160rpx;
  font-size: 22rpx;
  color: #999999;
}

.trend-bar {
  flex: 1;
}

.trend-count {
  width: 60rpx;
  text-align: right;
  font-size: 24rpx;
  color: #333333;
}

/* 【N9】按课题统计 */
.topic-stat-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 14rpx 0;
  border-bottom: 1rpx solid #f0f2f5;
}

.topic-stat-row:last-child {
  border-bottom: none;
}

.topic-stat-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.topic-stat-side {
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
}

.topic-stat-num {
  font-size: 30rpx;
  font-weight: 600;
  color: #2b6cff;
}

.muted-text {
  font-size: 22rpx;
  color: #8a8f99;
}
