/* 全局容器 */
.login-container {
  width: 100%;
  min-height: 100vh;
  background-color: #f5f5f5;
  padding: 60rpx 40rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
}

/* 标题样式 */
.login-title {
  font-size: 48rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 80rpx;
  letter-spacing: 2rpx;
}

/* 身份选择器 */
.role-selector {
  display: flex;
  width: 100%;
  justify-content: space-between;
  margin-bottom: 60rpx;
}

.role-item {
  width: 48%;
  height: 100rpx;
  border-radius: 50rpx;
  border: 2rpx solid #e0e0e0;
  background-color: #fff;
  display: flex;
  justify-content: center;
  align-items: center;
  position: relative;
  transition: all 0.3s ease;
}

.role-item.active {
  border-color: #4CAF50;
  background-color: #f0f9f0;
}

.role-text {
  font-size: 32rpx;
  color: #333;
}

.check-icon {
  position: absolute;
  right: 20rpx;
  top: 50%;
  transform: translateY(-50%);
  font-size: 24rpx;
  color: #4CAF50;
  opacity: 0;
}

.check-icon.show {
  opacity: 1;
}

/* 表单容器 */
.form-container {
  width: 100%;
  margin-bottom: 60rpx;
}

.input-item {
  width: 100%;
  height: 90rpx;
  background-color: #fff;
  border-radius: 45rpx;
  margin-bottom: 30rpx;
  padding: 0 30rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  position: relative;
}


.input-box {
  flex: 1;
  font-size: 30rpx;
  color: #333;
  height: 100%;
}

.input-placeholder {
  color: #999;
  font-size: 30rpx;
}

/* 密码显隐按钮：固定在密码行最右侧的圆形点按区 */
.pwd-toggle {
  flex-shrink: 0;
  width: 72rpx;
  height: 72rpx;
  margin-left: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
}

/* 点按反馈（贴近主流登录页的浅灰圆形高亮） */
.pwd-toggle-hover {
  background-color: rgba(0, 0, 0, 0.06);
}

/* 眼睛图标：椭圆外框 + 瞳孔；明文状态叠一条斜线表示“点按可隐藏” */
.eye {
  position: relative;
  width: 40rpx;
  height: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.eye-outline {
  position: absolute;
  left: 0;
  top: 3rpx;
  width: 40rpx;
  height: 24rpx;
  border: 3rpx solid #9f9898;
  border-radius: 50%;
  box-sizing: border-box;
}

.eye-pupil {
  position: absolute;
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background-color: #9f9898;
}

.eye-slash {
  position: absolute;
  left: -3rpx;
  top: 13rpx;
  width: 46rpx;
  height: 3rpx;
  border-radius: 2rpx;
  background-color: #9f9898;
  transform: rotate(-30deg);
}

/* 登录按钮 */
.login-btn {
  width: 100%;
  height: 90rpx;
  line-height: 90rpx;
  border-radius: 45rpx;
  font-size: 32rpx;
  background-color: #d5cece !important;
  color: #dc2a2a;
  border: none;
  margin-bottom: 40rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  text-align: center;
  line-height: 90rpx;
}

/* 注册按钮 */
.register-btn {
  width: 100%;
  height: 90rpx;
  border-radius: 45rpx;
  font-size: 32rpx;
  background-color: #7f7b7b;
  color: #f3f6f3;
  border: 2rpx solid #888b89;
  box-shadow: 0 4rpx 8rpx rgba(0, 0, 0, 0.05);
  transition: all 0.3s ease;
  /* 文字居中关键代码 */
  display: flex;
  justify-content: center;
  align-items: center;
  text-align: center;
  line-height: 90rpx;
}

.login-btn.active {
  background-color: #4CAF50 !important;
  color: #fff;
}

/* 忘记密码链接 */
.forgot-password {
  margin: 20rpx 0;
  text-align: center;
}
.forgot-link {
  font-size: 26rpx;
  color: #007bff;
  text-decoration: underline;
}
.forgot-link:active {
  color: #0056b3;
}

/* 底部文字 */
.footer-text {
  font-size: 24rpx;
  color: #999;
  margin-top: auto; /* 关键属性：把文字推到容器底部 */
  margin-bottom: 20rpx; /* 离屏幕底部留间距 */
}

/* ============================================================
   补齐 wxml 中引用但此前缺失的类（2026-10-01）
   背景：login.wxml 使用了 title-wrapper / decorate-line / btn-group，
        但 login.wxss 从未定义，导致标题与按钮组处于「无样式」状态。
   ============================================================ */
.title-wrapper {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 100%;
  margin-bottom: 48rpx;
}

.decorate-line {
  width: 120rpx;
  height: 8rpx;
  border-radius: 4rpx;
  background: linear-gradient(90deg, #4CAF50, #29a3d1);
}

.title-wrapper .decorate-line:first-child {
  margin-bottom: 28rpx;
}

.title-wrapper .decorate-line:last-child {
  margin-top: 28rpx;
}

.btn-group {
  display: flex;
  flex-direction: column;
  width: 100%;
  margin-top: 40rpx;
}