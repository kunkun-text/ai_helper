/* 全局容器 */
.forgot-container {
  width: 100%;
  min-height: 100vh;
  background: linear-gradient(180deg, #f8f9fa 0%, #e8f5e9 100%);
  padding: 40rpx 40rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: space-between;
}

/* 顶部导航 */
.nav-bar {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 60rpx;
}
.back-btn {
  font-size: 36rpx;
  color: #131313;
  width: 60rpx;
  height: 60rpx;
  text-align: center;
  line-height: 60rpx;
}
.page-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #131414;
}
.empty {
  width: 60rpx;
}

/* 内容区域 */
.content {
  flex: 1;
  width: 100%;
  display: flex;
  flex-direction: column;
  gap: 60rpx;
}

/* 标题区域 */
.title-section {
  text-align: center;
}
.main-title {
  font-size: 48rpx;
  font-weight: 600;
  color: #2e7d32;
  margin-bottom: 20rpx;
  display: block;
}
.sub-title {
  font-size: 28rpx;
  color: #666;
  line-height: 1.5;
}

/* 表单容器 */
.form-container {
  width: 100%;
  display: flex;
  flex-direction: column;
  gap: 40rpx;
}

/* 输入项 */
.input-item {
  width: 100%;
  height: 90rpx;
  background-color: #fff;
  border-radius: 45rpx;
  padding: 0 30rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  position: relative;
  box-shadow: 0 4rpx 8rpx rgba(0, 0, 0, 0.05);
  transition: all 0.2s ease;
}
.input-item.input-focus {
  box-shadow: 0 4rpx 12rpx rgba(76, 175, 80, 0.2);
  border: 2rpx solid #4CAF50;
}
.input-box {
  flex: 1;
  font-size: 30rpx;
  color: #333;
  height: 100%;
}
.input-placeholder {
  color: #999;
  font-size: 30rpx;
}

/* 清空按钮 */
.clear-icon {
  position: absolute;
  right: 30rpx;
  font-size: 28rpx;
  color: #999;
  width: 40rpx;
  height: 40rpx;
  text-align: center;
  line-height: 40rpx;
  opacity: 0;
  transition: opacity 0.2s;
  z-index: 100;
}
.clear-icon.show {
  opacity: 1;
}
.clear-icon:active {
  color: #dc2a2a;
  transform: scale(1.1);
}

/* 发送按钮 */
.send-btn {
  width: 100%;
  height: 90rpx;
  border-radius: 45rpx;
  font-size: 32rpx;
  background-color: #e0e0e0;
  color: #999;
  border: none !important;
  display: flex;
  justify-content: center;
  align-items: center;
  box-shadow: 0 4rpx 8rpx rgba(0, 0, 0, 0.05);
  transition: all 0.3s ease;
}
.send-btn.active {
  background: linear-gradient(90deg, #4CAF50 0%, #388e3c 100%) !important;
  color: #fff !important;
  box-shadow: 0 4rpx 12rpx rgba(76, 175, 80, 0.2);
}

/* 提示信息 */
.info-section {
  margin-top: 20rpx;
}
.info-text {
  font-size: 24rpx;
  color: #666;
  margin-bottom: 12rpx;
  display: block;
  text-align: center;
  line-height: 1.4;
}

/* 底部文字 */
.footer-text {
  font-size: 24rpx;
  color: #999;
  margin-top: 40rpx;
  margin-bottom: 20rpx;
}