<view class="forgot-container">
  <!-- 顶部导航 -->
  <view class="nav-bar">
    <view class="back-btn" bindtap="goBack">←</view>
    <view class="page-title">忘记密码</view>
    <view class="empty"></view>
  </view>

  <!-- 页面内容 -->
  <view class="content">
    <view class="title-section">
      <text class="main-title">重置密码</text>
      <text class="sub-title">请输入您的邮箱，我们将发送重置链接到您的邮箱</text>
    </view>

    <!-- 表单 -->
    <view class="form-container">
      <!-- 邮箱输入 -->
      <view class="input-item {{emailFocus ? 'input-focus' : ''}}">
        <input 
          class="input-box" 
          placeholder="请输入您的邮箱" 
          placeholder-class="input-placeholder"
          value="{{email}}"
          bindinput="onEmailInput"
          bindfocus="onEmailFocus"
          bindblur="onEmailBlur"
        />
        <view class="clear-icon {{email ? 'show' : ''}}" bindtap="clearEmail">×</view>
      </view>

      <!-- 发送按钮 -->
      <button class="send-btn {{canSend ? 'active' : ''}}" bindtap="sendResetEmail" disabled="{{!canSend}}">
        发送重置邮件
      </button>
    </view>

    <!-- 提示信息 -->
    <view class="info-section">
      <text class="info-text">请确保您输入的邮箱是您注册时使用的邮箱</text>
      <text class="info-text">邮件可能会在几分钟内到达，请检查您的收件箱</text>
    </view>
  </view>

  <!-- 底部文字 -->
  <view class="footer-text">© 2025 AI答辩辅助系统 版权所有</view>
</view>