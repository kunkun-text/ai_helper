/**app.wxss**/
/* ============================================================
   全局样式 —— 2026-10-01 重构
   【原则】本文件只做「追加」与「变量化」，不改动既有页面用到的类；
          页面级 wxss 优先级高于本文件，因此旧页面外观不受影响。
          新页面请优先复用下面的 g-* 通用类。
   ============================================================ */

page {
  /* 主题色（学生端偏蓝、教师端偏绿，页面内可局部覆盖） */
  --g-primary: #4CAF50;
  --g-primary-dark: #43a047;
  --g-info: #008cba;
  --g-warning: #f5a623;
  --g-danger: #e74c3c;

  /* 【2026-10-16 · 报告五维评分】「基于上传文档的评析」专用强调色。
     绿(主色)/蓝(链接、信息)/红(危险)/橙(警告) 都已被重度占用，
     这里取 teal 系，与雷达图的 #2b6cff、课题标签的紫 #7b1fa2 均不冲突。
     用途：教师端记录列表把「这条评析来自上传的文件」与普通答辩区分开。 */
  --g-accent: #00897b;
  --g-accent-bg: #e0f2f1;

  /* 文本 */
  --g-text: #333333;
  --g-text-sub: #666666;
  --g-text-muted: #999999;

  /* 容器 */
  --g-bg: #f5f7fa;
  --g-card: #ffffff;
  --g-border: #f0f0f0;

  /* 圆角与阴影 */
  --g-radius: 24rpx;
  --g-radius-sm: 16rpx;
  --g-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.06);
  --g-shadow-hover: 0 12rpx 32rpx rgba(0, 0, 0, 0.10);

  /* 注意：这里只定义 CSS 变量，不做任何视觉覆写（背景/文字色/字号/字体）——
     page 上的视觉规则会作用于全部旧页面，属于全局样式污染（2026-10-01 审计 P1-4 修复）。
     各页面（含新页面）的背景色一律由各自的 .page 类自理，新页面用 var(--g-bg) + 回退值。 */
}

/* ---------------- 通用卡片 ---------------- */
.g-card {
  width: 100%;
  box-sizing: border-box;
  background: var(--g-card);
  border-radius: var(--g-radius);
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: var(--g-shadow);
}

.g-card-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--g-text);
  margin-bottom: 20rpx;
}

.g-card-sub {
  font-size: 24rpx;
  color: var(--g-text-muted);
  margin-bottom: 16rpx;
}

/* ---------------- 通用按钮 ---------------- */
.g-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  border-radius: var(--g-radius-sm);
  font-size: 30rpx;
  font-weight: 500;
}

.g-btn-primary {
  background: linear-gradient(135deg, #4CAF50, #43a047);
  color: #ffffff;
}

.g-btn-info {
  background: linear-gradient(135deg, #29a3d1, #008cba);
  color: #ffffff;
}

.g-btn-outline {
  background: #ffffff;
  color: var(--g-info);
  border: 2rpx solid var(--g-info);
}

.g-btn-disabled {
  opacity: 0.55;
}

/* ---------------- 标签 / 徽标 ---------------- */
.g-tag {
  display: inline-flex;
  align-items: center;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  line-height: 1.6;
}

.g-tag-success {
  background: #e8f5e9;
  color: #2e7d32;
}

.g-tag-warning {
  background: #fff8e1;
  color: #b26a00;
}

.g-tag-danger {
  background: #fdecea;
  color: #c0392b;
}

.g-tag-info {
  background: #e6f4fa;
  color: #0077a3;
}

/* 【2026-10-16 · 报告五维评分】标注「这条评析基于上传的报告文件」 */
.g-tag-doc {
  background: var(--g-accent-bg, #e0f2f1);
  color: var(--g-accent, #00897b);
}

/* 【VID-4 · 2026-10-20】标注「该场次已上传答辩视频」（可点开详情做视频 AI 评分）。
   红系与报告评析的 teal 明确区分；两者同时存在时报告绿为主、视频红作补充标签。 */
.g-tag-video {
  background: #fdecea;
  color: #c0392b;
}

/* ================= 评分表成绩单（2026-10-20） =================
   放在 app.wxss 而不是各页 wxss：学生端与教师端的「评分表」必须长得一样、
   算得一样（数据源 defense_score_record，口径对齐报告评析）。
   色值沿用上面的 teal 强调色，与 .g-tag-doc 一致。 */

.sc-summary {
  display: flex;
  align-items: baseline;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 12rpx;
}

.sc-total {
  font-size: 52rpx;
  font-weight: 700;
  color: var(--g-accent, #00897b);
  line-height: 1.1;
}

.sc-total-max {
  font-size: 24rpx;
  color: #9ca3af;
}

.sc-total-note {
  font-size: 22rpx;
  color: #9ca3af;
}

/* 五维平均：一行五格，窄屏也不换行挤压 */
.sc-dims {
  display: flex;
  gap: 8rpx;
  margin-top: 16rpx;
}

.sc-dim {
  flex: 1;
  background: #f7f9fb;
  border-radius: 10rpx;
  padding: 12rpx 4rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
}

.sc-dim-name {
  font-size: 20rpx;
  color: #6b7280;
}

.sc-dim-score {
  font-size: 28rpx;
  font-weight: 600;
  color: #1f2937;
}

.sc-tip {
  display: block;
  margin-top: 12rpx;
  font-size: 20rpx;
  color: #9ca3af;
  line-height: 1.6;
}

/* 逐轮卡片 */
.sc-round {
  margin-top: 12rpx;
  padding: 16rpx 20rpx;
  background: #f7f9fb;
  border-radius: 12rpx;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.sc-round-head {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.sc-round-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #1f2937;
}

.sc-round-total {
  font-size: 24rpx;
  color: var(--g-accent, #00897b);
  font-weight: 600;
}

.sc-round-dims {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}

.sc-round-dim {
  font-size: 20rpx;
  color: #4b5563;
  background: #ffffff;
  border: 1rpx solid #e5e7eb;
  border-radius: 8rpx;
  padding: 2rpx 10rpx;
}

.sc-round-comment {
  font-size: 24rpx;
  color: #374151;
  line-height: 1.7;
}

.sc-muted {
  color: #9ca3af;
}

/* ---------------- 数据统计卡（教师端总览） ---------------- */
.g-stats {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.g-stat {
  flex: 1 1 calc(50% - 20rpx);
  box-sizing: border-box;
  background: var(--g-card);
  border-radius: var(--g-radius);
  padding: 28rpx 24rpx;
  box-shadow: var(--g-shadow);
}

.g-stat-value {
  font-size: 44rpx;
  font-weight: 700;
  color: var(--g-info);
  line-height: 1.2;
}

.g-stat-label {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--g-text-muted);
}

/* ---------------- 简易进度条 ---------------- */
.g-bar {
  width: 100%;
  height: 14rpx;
  background: #eef1f5;
  border-radius: 10rpx;
  overflow: hidden;
}

.g-bar-inner {
  height: 100%;
  background: linear-gradient(90deg, #4CAF50, #8bc34a);
  border-radius: 10rpx;
  transition: width 0.3s ease;
}

/* ---------------- 空状态 ---------------- */
.g-empty {
  text-align: center;
  padding: 60rpx 0;
  color: var(--g-text-muted);
  font-size: 26rpx;
}

/* ============================================================
   以下为既有全局类（保持不变）
   ============================================================ */
.container { height:100%; display:flex; flex-direction:column; align-items:center;
  justify-content:space-between; padding:200rpx 0; box-sizing:border-box; }

/* 长文本滚动容器 */
.long-text-scroll { width:100%; max-height:150rpx; overflow-y:auto;
  border:1rpx solid #e0e0e0; border-radius:8rpx; padding:12rpx;
  background-color:#f8f8f8; margin-top:8rpx; }
.long-text-scroll text { font-size:28rpx; line-height:1.5; word-break:break-word; }

/* 问题和答案块 */
.question-block,.answer-block { width:100%; margin-bottom:20rpx; }
.question-label,.answer-label { font-weight:bold; color:#333; display:block;
  margin-bottom:8rpx; font-size:28rpx; }
.question-text,.answer-text { font-size:28rpx; line-height:1.5; color:#666;
  display:block; width:100%; word-break:break-word; }
