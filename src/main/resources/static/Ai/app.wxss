/**app.wxss**/
/* ============================================================
   全局样式 —— 2026-10-01 重构
   【原则】本文件只做「追加」与「变量化」，不改动既有页面用到的类；
          页面级 wxss 优先级高于本文件，因此旧页面外观不受影响。
          新页面请优先复用下面的 g-* 通用类。
   ============================================================ */

page {
  /* 主题色（学生端偏蓝、教师端偏绿，页面内可局部覆盖） */
  --g-primary: #4CAF50;
  --g-primary-dark: #43a047;
  --g-info: #008cba;
  --g-warning: #f5a623;
  --g-danger: #e74c3c;

  /* 文本 */
  --g-text: #333333;
  --g-text-sub: #666666;
  --g-text-muted: #999999;

  /* 容器 */
  --g-bg: #f5f7fa;
  --g-card: #ffffff;
  --g-border: #f0f0f0;

  /* 圆角与阴影 */
  --g-radius: 24rpx;
  --g-radius-sm: 16rpx;
  --g-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.06);
  --g-shadow-hover: 0 12rpx 32rpx rgba(0, 0, 0, 0.10);

  /* 注意：这里只定义 CSS 变量，不做任何视觉覆写（背景/文字色/字号/字体）——
     page 上的视觉规则会作用于全部旧页面，属于全局样式污染（2026-10-01 审计 P1-4 修复）。
     各页面（含新页面）的背景色一律由各自的 .page 类自理，新页面用 var(--g-bg) + 回退值。 */
}

/* ---------------- 通用卡片 ---------------- */
.g-card {
  width: 100%;
  box-sizing: border-box;
  background: var(--g-card);
  border-radius: var(--g-radius);
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: var(--g-shadow);
}

.g-card-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--g-text);
  margin-bottom: 20rpx;
}

.g-card-sub {
  font-size: 24rpx;
  color: var(--g-text-muted);
  margin-bottom: 16rpx;
}

/* ---------------- 通用按钮 ---------------- */
.g-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  border-radius: var(--g-radius-sm);
  font-size: 30rpx;
  font-weight: 500;
}

.g-btn-primary {
  background: linear-gradient(135deg, #4CAF50, #43a047);
  color: #ffffff;
}

.g-btn-info {
  background: linear-gradient(135deg, #29a3d1, #008cba);
  color: #ffffff;
}

.g-btn-outline {
  background: #ffffff;
  color: var(--g-info);
  border: 2rpx solid var(--g-info);
}

.g-btn-disabled {
  opacity: 0.55;
}

/* ---------------- 标签 / 徽标 ---------------- */
.g-tag {
  display: inline-flex;
  align-items: center;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  line-height: 1.6;
}

.g-tag-success {
  background: #e8f5e9;
  color: #2e7d32;
}

.g-tag-warning {
  background: #fff8e1;
  color: #b26a00;
}

.g-tag-danger {
  background: #fdecea;
  color: #c0392b;
}

.g-tag-info {
  background: #e6f4fa;
  color: #0077a3;
}

/* ---------------- 数据统计卡（教师端总览） ---------------- */
.g-stats {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.g-stat {
  flex: 1 1 calc(50% - 20rpx);
  box-sizing: border-box;
  background: var(--g-card);
  border-radius: var(--g-radius);
  padding: 28rpx 24rpx;
  box-shadow: var(--g-shadow);
}

.g-stat-value {
  font-size: 44rpx;
  font-weight: 700;
  color: var(--g-info);
  line-height: 1.2;
}

.g-stat-label {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--g-text-muted);
}

/* ---------------- 简易进度条 ---------------- */
.g-bar {
  width: 100%;
  height: 14rpx;
  background: #eef1f5;
  border-radius: 10rpx;
  overflow: hidden;
}

.g-bar-inner {
  height: 100%;
  background: linear-gradient(90deg, #4CAF50, #8bc34a);
  border-radius: 10rpx;
  transition: width 0.3s ease;
}

/* ---------------- 空状态 ---------------- */
.g-empty {
  text-align: center;
  padding: 60rpx 0;
  color: var(--g-text-muted);
  font-size: 26rpx;
}

/* ============================================================
   以下为既有全局类（保持不变）
   ============================================================ */
.container { height:100%; display:flex; flex-direction:column; align-items:center;
  justify-content:space-between; padding:200rpx 0; box-sizing:border-box; }

/* 长文本滚动容器 */
.long-text-scroll { width:100%; max-height:150rpx; overflow-y:auto;
  border:1rpx solid #e0e0e0; border-radius:8rpx; padding:12rpx;
  background-color:#f8f8f8; margin-top:8rpx; }
.long-text-scroll text { font-size:28rpx; line-height:1.5; word-break:break-word; }

/* 问题和答案块 */
.question-block,.answer-block { width:100%; margin-bottom:20rpx; }
.question-label,.answer-label { font-weight:bold; color:#333; display:block;
  margin-bottom:8rpx; font-size:28rpx; }
.question-text,.answer-text { font-size:28rpx; line-height:1.5; color:#666;
  display:block; width:100%; word-break:break-word; }
